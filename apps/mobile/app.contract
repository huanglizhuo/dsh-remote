// DSH Mobile: the phone half of DeepSeek Harness. It reads one snapshot from the
// bridge plugin on the Mac and sends prompts back into the same sessions the Mac shows.
shape OptionRow
  value: string
  name: string
  description: string
shape SessionRow
  id: string
  pinned: bool
  title: string
  running: bool
  cwd: string
  updatedAt: number
  group: string
  first: bool
  when: string
  archived: bool
  attention: string
  // The sidebar's dots: '' | 'done' (a completion nobody has read) | 'failed'; how many direct subagents run now.
  unread: string
  subs: number

shape MdItem
  id: string
  v: string
  sign: string
  mark: string
  d: number
  alt: string
  w: number
  h: number
  dw: number
  dh: number

// A coloured stretch of source (syntax highlighting): mark k keyword, s string, n number, c comment, f call, t type, l literal, p key, v variable.
shape CodeRun
  id: string
  v: string
  mark: string

// A table cell (its text is Markdown, `a` its alignment: start, center or end) and a table row.
shape MdCell
  id: string
  v: string
  a: string

shape MdRow
  id: string
  cells: MdCell[]

shape MdNode
  id: string
  t: string
  v: string
  lvl: number
  lang: string
  alt: string
  w: number
  h: number
  items: MdItem[]
  runs: CodeRun[]
  heads: MdCell[]
  grid: MdRow[]

// A to-do item and how this write changed it (added, updated, removed, same: unchanged since the previous list), worded as `label` (+ the status it had before).
shape TodoItem
  id: string
  text: string
  state: string
  change: string
  label: string
  prev: string

shape ChoiceItem
  id: string
  text: string
  description: string

shape ImageRow
  id: string
  att: string
  w: number
  h: number
  text: string

shape BlockRow
  id: string
  kind: string
  text: string
  detail: string
  status: string
  nodes: MdNode[]
  callId: string
  child: string
  icon: string
  summary: string
  args: string
  lazy: bool
  badge: string
  todoSummary: string
  todos: TodoItem[]
  files: FileRow[]
  question: string
  options: ChoiceItem[]
  att: string
  w: number
  h: number
  images: ImageRow[]
  ask: option<AskCard>
  // The process group this block is a member of (its header block has that id), and a reply of the turn's final answer step.
  grp: string
  answer: bool
  // A tool row: its localized title, the right-hand text of the collapsed row (a write's size, +n of other tasks running) and the
  // lines it added / removed.
  title: string
  suffix: string
  added: number
  removed: number
  // The card of the tool row that is open (the call detail's view, set on that block by `thread`); empty on every other block.
  view: ToolView

shape MessageRow
  id: string
  role: string
  seq: number
  msgId: string
  turn: number
  text: string
  plain: string
  // The turn's usage: the `用量 X` line and the panel's label / value rows (on the last assistant row of the turn).
  usage: string
  usageRows: UsageRow[]
  // The bridge-worded header of a note row (trigger, context, compaction, command, retry, failure): its title, one-line
  // summary, `symbol:` icon and state; the body is `text`. On an assistant row (the first of its turn) they are the turn control:
  // 已完成，用时 X / 处理失败 / 已停止 and the counts line.
  title: string
  summary: string
  icon: string
  state: string
  failed: bool
  // The assistant row of the turn that is still open (no turn/end yet).
  active: bool
  // What the turn's presentation folds by: a steering message in it, and whether its process has something to fold
  // under foldedReplies all / final.
  steered: bool
  foldAll: bool
  foldFinal: bool
  changedCount: number
  // The turn's changed files (ui-deliverables): the host's summary when it has one (`changesSeq` names it, each file its index `i`), else
  // the files its write-class tools touched (i -1); the totals over every file and at most twenty of them.
  changesSeq: number
  changedAdded: number
  changedRemoved: number
  changedFiles: ChangedFile[]
  day: string
  deliverables: FileRow[]
  refs: FileRow[]
  interrupted: bool
  blocks: BlockRow[]
  // The phone's own presentation of an assistant row (the Mac's work-details settings or the person's pick): the process is
  // folded behind the turn control, group headers stand in for their members, and which group is the live one.
  fold: bool
  grouped: bool
  liveGroup: string

shape UsageRow
  id: string
  label: string
  value: string

shape ModelRow
  id: string
  name: string
  provider: string
  current: bool
  efforts: string[]

shape ModelsReply
  currentEffort: string
  models: ModelRow[]

shape DevicesReply
  devices: DeviceRow[]

shape CommandsReply
  commands: CommandRow[]
  skills: SkillRow[]

shape CommandRow
  name: string
  description: string
  hint: string

// A user-invocable skill of the slash menu (picking one lands the plain `/name `; userOnly: the model cannot invoke it).
shape SkillRow
  name: string
  description: string
  userOnly: bool

// One row of the slash menu: a host command, a client-side one (file, model) or a skill; `section` groups it (add, commands, skills).
shape SlashRow
  name: string
  label: string
  description: string
  hint: string
  kind: string
  section: string
  rank: number

// One row of the @ menu: a file / folder (kind file, dir), one of this session's subagents or another session. `text` is what the draft
// shows (`done` the settled form of a folder), `wire` the mention a session's readable `text` becomes on send.
shape RefRow
  id: string
  kind: string
  name: string
  detail: string
  text: string
  done: string
  wire: string
  section: string
  first: bool

shape RefsReply
  items: RefRow[]

shape ApprovalRow
  id: string
  toolName: string
  reason: string
  summary: string
  args: string
  command: string
  subject: string
  detail: string
  approveLabel: string
  alwaysLabel: string

shape DeviceRow
  id: string
  name: string
  when: string
  mine: bool

shape WalletRow
  id: string
  currency: string
  text: string

shape BalanceView
  signedOut: bool
  failed: bool
  wallets: WalletRow[]
  bonus: WalletRow[]

shape ActivityRow
  // 'tool', 'thinking' or 'retry'.
  kind: string
  label: string
  detail: string

shape StatsRow
  turns: number
  steps: number
  inTok: number
  outTok: number
  cacheRead: number
  // The stats sheet's timing rows (0 while the Mac serves no sessionStats): model / tool wall time, first-token latency and decode speed.
  llmMs: number
  toolMs: number
  ttftMs: number
  ttftSteps: number
  decodeMs: number
  decodeTokens: number

// The Mac's presentation settings (ui-chat, ui-conversation), with the official defaults when it names none.
shape PrefsRow
  transcriptView: string
  collapseTiming: string
  foldedReplies: string
  performanceUsage: string
  busyEnter: string

// One row of the subagent tree: what it is (`mode`, worded), what it does (`activity` running | completed | inactive | '' for an external task,
// worded as `state`), its tokens and active time (`meta`), and how deep it sits.
shape SubagentRow
  id: string
  label: string
  sessionId: string
  sub: string
  mode: string
  activity: string
  state: string
  meta: string
  depth: number

shape JobRow
  id: string
  kind: string
  label: string
  status: string
  // The status in the job list's words (运行中 / 已完成 …); `status` is the code the controls read.
  state: string
  progress: string
  detail: string
  when: string

shape TodoRow
  id: string
  text: string
  state: string

shape FileRow
  id: string
  path: string
  text: string

// A scheduled task as the manager shows it: its state and timing in words, the next run, and the timing as plain editor fields
// (mode once | every | daily | weekly | custom; `days` is the ISO weekdays `1,3,7`).
shape TaskRow
  id: string
  tid: string
  title: string
  prompt: string
  status: string
  state: string
  kind: string
  timing: string
  next: string
  running: bool
  // An enabled task whose run time has passed without its delivery (the session it waits for has not resumed).
  overdue: bool
  nextAt: string
  updatedAt: string
  targetSessionId: string
  mode: string
  date: string
  time: string
  zone: string
  interval: number
  unit: string
  days: string

shape TeamRow
  id: string
  subject: string
  status: string
  owner: string

shape FileDoc
  ok: bool
  kind: string
  name: string
  bytes: number
  text: string
  url: string

// One file a turn changed, and the comparison its page shows (lines are the card lines: sign + - or a space, # for a hunk header).
shape ChangedFile
  id: string
  path: string
  name: string
  added: number
  removed: number
  i: number
  note: string

shape ChangesDoc
  ok: bool
  kind: string
  name: string
  added: number
  removed: number
  created: bool
  deleted: bool
  coarse: bool
  cut: bool
  lines: ToolLine[]

// The ratings of this session (ui-message-feedback), and a background job's output tail.
shape FeedbackItem
  id: string
  messageId: string
  rating: string
  note: string
  version: string

shape FeedbackReply
  items: FeedbackItem[]

shape JobOutput
  ok: bool
  text: string
  more: bool
  status: string

shape SchedulesReply
  items: TaskRow[]
  // The Mac's time zone and tomorrow's date there: what a new task starts from.
  zone: string
  tomorrow: string

// A queued message: its text, the pictures and files it carries, and whether it can be rewritten (text only).
shape QueueRow
  id: string
  text: string
  images: ImageRow[]
  files: FileRow[]
  editable: bool

// A pending question (or plan review) the Mac's own UI is showing, as the bridge mirrors it.
shape QuestionRow
  id: string
  callId: string
  kind: string
  state: string
  dismissal: string
  countdown: number
  running: bool
  held: bool
  items: QuestionItem[]
  plan: option<PlanReview>

shape QuestionItem
  id: string
  header: string
  question: string
  detail: string
  multi: bool
  options: AskOption[]

shape AskOption
  id: string
  value: string
  text: string
  description: string
  recommended: bool

shape PlanReview
  title: string
  description: string
  nodes: MdNode[]
  approve: string

// A tool row's question state (waiting, answered n/m, cancelled…) and a late reply's Q&A.
shape AskCard
  state: string
  answered: number
  total: number
  answerable: bool
  callId: string
  items: AskItem[]

shape AskItem
  id: string
  header: string
  question: string
  answers: string[]
  skipped: bool

shape PlanStep
  id: string
  text: string
  state: string

shape PlanCard
  title: string
  steps: PlanStep[]


// The /v1/live seam's result: Snapshot without messages, hasMore and turns —
// those come from the rows resource (loadRows), whose revision the live poll
// carries; the live poll never ships them. Keeping them out of this shape
// keeps the loadLive source descriptor (and the update stream's frozen
// cohort envelope) from carrying the whole MessageRow list twice.
shape LiveCore
  listRev: string
  rowsRev: string
  plan: PlanCard
  goal: string
  goalId: string
  pinned: bool
  archived: bool
  goalPhase: string
  // The goal bar's details: process-local activation, rounds started of the cap, the blocker's message.
  goalActivation: string
  goalRounds: number
  goalMax: number
  goalReason: string
  // The failed turn/end a 继续生成 would address (-1: none) and plan mode (on, off, entering, leaving; '' where the Mac composes none).
  continueSeq: number
  planMode: string
  limits: LimitsRow
  origin: string
  subagentMode: string
  // A subagent child's place in its tree (its parent and what the parent calls it), and the direct children's counts line.
  parentId: string
  parentTitle: string
  agentLabel: string
  subagentProgress: string
  // The session's working directory, and what this bridge offers (its wire revision; whether files can be opened on the Mac).
  sessionCwd: string
  bridgeApi: number
  bridgeOpen: bool
  sessions: SessionRow[]
  sessionTitle: string
  sessionModel: string
  sessionPermission: string
  permissionOptions: OptionRow[]
  running: bool
  inherited: bool
  runLabel: string
  runActivity: option<ActivityRow>
  stats: StatsRow
  approvals: ApprovalRow[]
  queue: QueueRow[]
  todos: TodoRow[]
  jobs: JobRow[]
  subagents: SubagentRow[]
  team: TeamRow[]
  question: option<QuestionRow>
  // The attempt streaming right now, as blocks that continue the open turn's groups.
  streamBlocks: BlockRow[]
  prefs: PrefsRow
  balance: option<BalanceView>
  context: option<ContextRow>
  quota: string
  quotaId: string

// The composer meter: tokens the next request would carry over the route's window, and the heuristic parts of them (0 where the Mac serves none).
shape ContextRow
  used: number
  total: number
  system: number
  tools: number
  messages: number

shape Rows
  hasMore: bool
  from: number
  turns: number[]
  rows: MessageRow[]

shape History
  session: string
  before: number
  from: number
  hasMore: bool
  rows: MessageRow[]

// The card a tool row opens: parts of kind cmd (a shell command and its exit status), lines (numbered / signed lines, folded), items
// (entities: web sources, receipts), text and note; `head` is the card's one-line summary.
shape ToolLine
  id: string
  n: number
  sign: string
  text: string
  runs: CodeRun[]

shape ToolField
  id: string
  label: string
  value: string

shape ToolItem
  id: string
  title: string
  subtitle: string
  badge: string
  tone: string
  text: string
  link: string
  group: string
  md: bool
  fields: ToolField[]
  lines: ToolLine[]

shape ToolPart
  id: string
  kind: string
  label: string
  badge: string
  tone: string
  text: string
  link: string
  md: bool
  fold: number
  lines: ToolLine[]
  items: ToolItem[]

shape ToolView
  kind: string
  head: string
  tone: string
  more: number
  parts: ToolPart[]

shape CallDetail
  callId: string
  name: string
  title: string
  args: string
  view: ToolView

shape Reply
  ok: bool
  error: string

// A picture or file waiting to be sent with the next message in session `sid`; `id` is the bridge's handle for it.
shape AttRow
  id: string
  name: string
  kind: string
  sid: string
  bytes: number

shape UploadReply
  ok: bool
  error: string
  items: AttRow[]

// What the composer may attach: pictures per message, whether the Mac takes files, the per-file size cap.
shape LimitsRow
  images: number
  files: bool
  fileBytes: number

shape PairReply
  ok: bool
  token: string
  error: string

shape Created
  id: string
  error: string

shape PairLink
  ok: bool
  server: string
  token: string
  alt: string
  error: string

use getUserMedia, stopTrack, MediaStream, MediaStreamTrack, MediaTrackConstraints from "@exact/media-capture"
use detectedBarcodes, BarcodeScan from "@exact/barcode-detection"


keyframes pulse
  50% opacity=0.35

shape Viewport
  prefersReducedMotion: bool

// An answer failure the phone words itself ("undelivered" = the Mac's UI never confirmed it); anything else is the Mac's own message.
fn answerErr(e: string): string = e == "" ? "" : (e == "undelivered" ? t("approval.undelivered") : (e == "expired" ? t("approval.expired") : (e == "unavailable" ? t("question.err.unavailable") : e)))
// The session list's status line for a session that waits on the person (the desktop sidebar's wording).
fn attnLabel(a: string): string = a == "approval" ? t("status.waitingApproval") : (a == "plan-review" ? t("status.planReview") : t("status.waitingAnswer"))
// A tool row's question state, in ui-tool's AskQuestionRow wording.
fn askSummary(a: AskCard): string = a.state == "answered" ? t("ask.answered", answered=a.answered, total=a.total) : (a.state == "pending" ? t("ask.pending") : (a.state == "closed" ? t("ask.closed") : (a.state == "cancelled" ? t("ask.cancelled") : (a.state == "interrupted" ? t("ask.interrupted") : t("ask.waiting")))))
fn askVerdict(a: AskCard): string = a.state == "pending" ? t("ask.pendingDetail") : (a.state == "closed" ? t("ask.closedDetail") : (a.state == "cancelled" ? t("ask.cancelledDetail") : (a.state == "interrupted" ? t("ask.interruptedDetail") : "")))
// Code and diff colours: GitHub Primer's light / dark palettes, readable on a card in both schemes (app.forma has no tokens for them).
fn addC(): string = "light-dark(#116329, #3fb950)"
fn delC(): string = "light-dark(#a40e26, #ff7b72)"
fn warnC(): string = "light-dark(#953800, #ffa657)"
// Syntax colours by token mark (CodeRun: k keyword, s string, n number / l literal / p key, c comment, f call, t type / v variable), a card's status tint, a card line's colour by its sign.
fn tokColor(c: string): string = c == "k" ? "light-dark(#cf222e, #ff7b72)" : (c == "s" ? "light-dark(#0a3069, #a5d6ff)" : (c == "n" or c == "l" or c == "p" ? "light-dark(#0550ae, #79c0ff)" : (c == "c" ? "light-dark(#6e7781, #8b949e)" : (c == "f" ? "light-dark(#8250df, #d2a8ff)" : (c == "t" or c == "v" ? warnC() : "-exact-label")))))
fn toneColor(t: string): string = t == "error" ? delC() : (t == "success" ? addC() : (t == "warning" ? warnC() : (t == "info" ? "light-dark(#0550ae, #79c0ff)" : "-exact-secondary-label")))
fn lineColor(sign: string): string = sign == "+" ? addC() : (sign == "-" ? delC() : (sign == "@" or sign == "…" ? "-exact-tertiary-label" : "-exact-label"))
// A picture sent with a message: a 120-wide thumbnail whose box keeps the aspect ratio up to 200 tall.
fn thumbH(w: number, h: number): number = (w > 0 and h > 0) ? min(120 * h / w, 200) : 120
// The question card's drafts: one `|id|id|` pick set, one custom text and one skip mark per question.
fn sAt(xs: string[], i: number): string = match xs.at(i) { case some(v) => v, case none => "" }
fn startPicks(it: QuestionItem): string = `|${it.options.filter((o, j) => o.recommended and (it.multi or j == 0)).map(o => o.id).join("|")}|`
fn doneAt(picks: string[], customs: string[], skips: string[], i: number): bool = sAt(picks, i).length > 2 or sAt(customs, i).trim() != "" or sAt(skips, i) != ""
fn firstMissing(picks: string[], customs: string[], skips: string[], n: number): number = match first(range(n).filter(i => not doneAt(picks, customs, skips, i))) { case some(i) => i, case none => -1 }
// `id|labels|custom` per question (a skip leaves both empty, the desktop's own encoding), percent-encoded, `;`-joined.
fn payload(q: QuestionRow, picks: string[], customs: string[], skips: string[]): string = q.items.map((it, i) => `${encodeURIComponent(it.id)}|${it.options.filter(o => sAt(picks, i).includes(`|${o.id}|`)).map(o => encodeURIComponent(o.value)).join(",")}|${encodeURIComponent(sAt(customs, i))}`).join(";")

// Per-session drafts, as `id<TAB>text` lines. The live list keeps whole drafts for this launch; the saved one (persisted, a 16 KB ceiling) a
// capped copy of the newest few, which a relaunch falls back to.
fn draftIn(ds: string[], sid: string): string = match first(ds.filter(d => d.startsWith(`${sid}\t`))) { case some(d) => d.slice(sid.length + 1), case none => "" }
fn putDraft(ds: string[], sid: string, v: string, cap: number, keep: number): string[] = ds.filter(d => not d.startsWith(`${sid}\t`)).concat(v == "" ? [] : [`${sid}\t${v.slice(0, cap)}`]).slice(max(0, ds.filter(d => not d.startsWith(`${sid}\t`)).length + (v == "" ? 0 : 1) - keep))
// The slash menu's face of a command (ui-commands: the built-ins' localized label and description, the Add / Commands sections in usage order,
// skills after them); any other command keeps the Mac's own description.
fn cmdLabel(n: string): string = n == "goal" ? t("cmd.goal") : (n == "plan" ? t("cmd.plan") : (n == "feedback" ? t("cmd.feedback") : (n == "compact" ? t("cmd.compact") : (n == "permission" ? t("cmd.permission") : (n == "model" ? t("cmd.model") : (n == "file" ? t("cmd.file") : ""))))))
fn cmdDesc(n: string, d: string): string = n == "goal" ? t("cmd.goal.desc") : (n == "plan" ? t("cmd.plan.desc") : (n == "feedback" ? t("cmd.feedback.desc") : (n == "compact" ? t("cmd.compact.desc") : (n == "permission" ? t("cmd.permission.desc") : (n == "model" ? t("cmd.model.desc") : d)))))
fn cmdRank(n: string): number = n == "file" ? 0 : (n == "goal" ? 1 : (n == "plan" ? 2 : (n == "feedback" ? 3 : (n == "compact" ? 10 : (n == "permission" ? 11 : (n == "model" ? 12 : 20))))))
fn cmdSection(n: string): string = cmdRank(n) < 10 ? "add" : "commands"
fn secTitle(s: string): string = s == "add" ? t("cmd.section.add") : (s == "commands" ? t("cmd.section.commands") : t("cmd.section.skills"))
// A compact token count (ContextMeter): 999, 1.2K, 123K, 1.5M.
fn scaled(v: number): string = v >= 100 ? `${round(v)}` : `${round(v * 10) / 10}`
fn fmtTok(n: number): string = n < 1000 ? `${n}` : (n < 1000000 ? `${scaled(n / 1000)}K` : `${scaled(n / 1000000)}M`)
// The composer's round button names what it does now (InputBar): stop, or send (steer / queue while a turn runs).
fn primaryLabel(mode: string, running: bool, steer: bool, hasDraft: bool): string = mode == "stop" ? t("input.stop") : (running and hasDraft ? (steer ? t("input.send.steer") : t("input.send.queue")) : t("input.send"))
// The directory a drilled @ query lists, and the one above it (`@"a b/c/` -> `a b/c/`, `a b/`).
fn dirOf(q: string): string = q.includes("/") ? q.slice(0, q.split("/").slice(0, -1).join("/").length + 1) : ""
fn parentOf(q: string): string = dirOf(q).split("/").length > 2 ? dirOf(q).slice(0, dirOf(q).split("/").slice(0, -2).join("/").length + 1) : ""

// A transcript row with nothing in it but what the caller names (the goal bar, the fork separator, the find note, the streaming row).
fn blankRow(id: string, role: string, seq: number, text: string, blocks: BlockRow[], active: bool): MessageRow = MessageRow(id=id, role=role, seq=seq, msgId="", turn=-1, text=text, plain=text, usage="", usageRows=[], title="", summary="", icon="", state="", failed=false, active=active, steered=false, foldAll=false, foldFinal=false, changedCount=0, changesSeq=0, changedAdded=0, changedRemoved=0, changedFiles=[], day="", deliverables=[], refs=[], interrupted=false, blocks=blocks, fold=false, grouped=false, liveGroup="")
// A closed turn's process folds behind its control (ChatNodeSeat): never while the turn runs or after it was steered, failed or
// stopped; the person's own pick (`+turn` open, `-turn` folded) wins over the default.
fn rowFold(m: MessageRow, foldOn: bool, picks: string[], latest: bool): bool = foldOn and m.turn >= 0 and not (m.active or m.steered or m.failed or m.interrupted) and not (picks.includes(`+${m.turn}`) ? true : (picks.includes(`-${m.turn}`) ? false : latest))
// Group headers stand in for their members (ChatGroupSeat): in the collapsed modes always, in detailed for turns that are history.
fn rowGrouped(m: MessageRow, mode: string, latest: bool): bool = mode == "all" or (mode == "history" and not m.active and not latest)
fn lastGrp(bs: BlockRow[]): string = match bs.at(-1) { case some(b) => b.grp, case none => "" }
// Whether a block shows: a group header only where steps are grouped; a member when its turn is not folded and (ungrouped or its
// group is open); a reply stays unless the folded turn keeps only its final answer; a steering message always.
fn shown(m: MessageRow, b: BlockRow, keep: bool, open: string[]): bool = b.kind == "group" ? (not m.fold and m.grouped) : (b.grp != "" ? (not m.fold and (not m.grouped or open.includes(b.grp))) : (b.kind == "steer" ? true : (not m.fold or keep or b.answer)))
// Whether the turn control folds anything: not for a steered, failed or stopped turn, and only when its process has something to fold
// under the reply setting (foldedReplies all keeps every reply, final only the answer).
fn canFold(m: MessageRow, foldOn: bool, keep: bool): bool = foldOn and not (m.steered or m.failed or m.interrupted) and (keep ? m.foldAll : m.foldFinal)
// The live group's title: the stream's own (正在… / 准备…, with its detail when the mode shows it), else the bridge's fallback.
fn liveTitle(b: BlockRow, act: option<ActivityRow>, detail: bool): string = match act { case some(a) => (a.kind != "retry" ? (detail and a.detail != "" ? `${a.label} · ${a.detail}` : a.label) : (detail and b.detail != "" ? `${b.summary} · ${b.detail}` : b.summary)), case none => (detail and b.detail != "" ? `${b.summary} · ${b.detail}` : b.summary) }
// The stats dialog's duration: seconds with a tenth under a minute, minutes and seconds from there.
fn fmtMs(ms: number): string = ms < 60000 ? t("duration.sec", seconds=round(ms / 100) / 10) : t("duration.minsec", minutes=floor(round(ms / 1000) / 60), seconds=round(ms / 1000) - floor(round(ms / 1000) / 60) * 60)
// Decode speed: whole tokens from ten a second up, a tenth below.
fn fmtTps(v: number): string = v >= 10 ? `${round(v)}` : `${round(v * 10) / 10}`
fn viewName(v: string): string = v == "compact" ? t("view.compact") : (v == "detailed" ? t("view.detailed") : (v == "verbose" ? t("view.verbose") : t("view.standard")))
// The turn rail: the opening row of a loaded turn (its id), else "".
fn openerOf(rows: MessageRow[], n: number): string = match first(rows.filter(r => r.turn == n)) { case some(r) => r.id, case none => "" }
fn mergeRows(older: MessageRow[], newer: MessageRow[]): MessageRow[] = older.filter(o => not newer.map(m => m.id).includes(o.id)).concat(newer)
// The last path segment (a changed file's name, a presented file's title).
fn baseName(p: string): string = match p.split("/").filter(x => x != "").at(-1) { case some(v) => v, case none => p }
// The rating this session holds for a message ('' none, positive, negative), and the official words for a refused rating (ui-message-feedback).
fn fbRatingOf(items: FeedbackItem[], id: string): string = match first(items.filter(i => i.messageId == id)) { case some(i) => i.rating, case none => "" }
fn fbErr(e: string): string = e == "version-conflict" ? t("feedback.err.conflict") : (e == "note-too-large" ? t("feedback.err.noteTooLarge") : t("feedback.err.generic"))
fn catLabel(c: string): string = c == "task-result" ? t("feedback.cat.task-result") : (c == "instruction-following" ? t("feedback.cat.instruction-following") : (c == "product-interaction" ? t("feedback.cat.product-interaction") : (c == "service-stability" ? t("feedback.cat.service-stability") : (c == "resource-cost" ? t("feedback.cat.resource-cost") : (c == "security-privacy-permission" ? t("feedback.cat.security-privacy-permission") : t("feedback.cat.other"))))))
fn dayName(d: number): string = d == 1 ? t("sched.day.1") : (d == 2 ? t("sched.day.2") : (d == 3 ? t("sched.day.3") : (d == 4 ? t("sched.day.4") : (d == 5 ? t("sched.day.5") : (d == 6 ? t("sched.day.6") : t("sched.day.7"))))))
// A scheduled task's refusal in the task manager's words: the host's stable codes (ui-schedule rule.* / host.*), anything else is a save failure.
fn schedErr(e: string): string = e == "" ? "" : (e == "invalid_rule" or e == "frequency_too_high" or e == "time_out_of_range" or e == "invalid_selector" ? t("sched.err.rule") : (e == "invalid_time_zone" ? t("sched.err.zone") : (e == "not_future" ? t("sched.err.future") : (e == "invalid_prompt" ? t("sched.err.title") : (e == "schedule_conflict" ? t("sched.err.conflict") : (e == "schedule_execution_pending" ? t("sched.err.pending") : (e == "schedule_not_found" ? t("sched.err.missing") : t("sched.err.save"))))))))
fn blankTask(): TaskRow = TaskRow(id="", tid="", title="", prompt="", status="active", state="", kind="", timing="", next="", running=false, overdue=false, nextAt="", updatedAt="", targetSessionId="", mode="daily", date="", time="09:00", zone="", interval=1, unit="minutes", days="")
fn dayOn(days: string, d: number): bool = `,${days},`.includes(`,${d},`)
fn toggleDay(days: string, d: number): string = dayOn(days, d) ? days.split(",").filter(x => x != "" and x != `${d}`).join(",") : (days == "" ? `${d}` : `${days},${d}`)

routes nav
  sessions "/"
    chat "/chat/:id"
      more "/chat/:id/more"
      models "/chat/:id/models"
      find "/chat/:id/find"
      perm "/chat/:id/perm"
      jobs "/chat/:id/jobs"
      diff "/chat/:id/diff"
    viewer "/file"
    schedules "/schedules"
      task "/schedules/:id"
    settings "/settings"
    scan "/scan"
    open "/open"
  notfound

component Mobile
  state server = "http://127.0.0.1:8787" persist
  state token = "" persist
  // The path pairing did NOT pick (tunnel when Tailscale won, Tailscale when the
  // tunnel won): offered as a one-tap switch when the live path goes dark.
  state alt = "" persist
  state code = ""
  // The composer's text is per session: whole drafts for this launch, and a capped copy of the newest few that survives a relaunch.
  state liveDrafts: string[] = []
  state drafts: string[] = [] persist
  state sentSid = ""
  state scanTrack = ""
  state scanTried = ""
  state renameDraft = ""
  state scanNote = ""
  state query = ""
  state take = 8
  state openProcess = ""
  // The note row (trigger, context, compaction, command, retry) open now; the process disclosure above is a different one.
  state openRow = ""
  state stick = true
  state idlePolls = 0
  // performanceNow() until which the poll stays hot after a send or command.
  state hotUntil = 0.0
  state failsSinceOk = 0
  // First poll after a cold start: until it lands (or fails twice) the list is
  // empty by definition — say "connecting" instead of looking broken.
  state everOk = false
  // One automatic hop to the alternate path per stale episode; after that the
  // banner leaves the choice to the person holding the phone.
  state pinned = ""
  state topKey = ""
  state topOffset = 0.0
  state railLeft = 0.0
  state railSynced = 0
  state visibleTurn = 0
  state visibleCandidate = 0
  state jumpTurning = 0
  state loadedCount = 0
  state older: MessageRow[] = []
  state olderFrom = 0
  state olderLoaded = false
  state olderMore = false
  state moreSid = ""
  state anchorKey = ""
  state anchorPending = 0
  state anchorOffset = 0.0
  state topArmed = false
  state nearTop = false
  state openCall = ""
  // The card parts the person unfolded ("… 其余 N 行"), as `callId.partId`; the code block whose copy button was just pressed; the
  // viewer's image reload counter.
  state openParts: string[] = []
  state copied = ""
  state imgTry = 0
  state findQ = ""
  // How a message sent while a turn runs is delivered: the person's pick ("steer" / "queue"), else the Mac's busy-Enter setting.
  state steerPick = ""
  // Sessions picked from the @ menu, as `@label<TAB>wire mention` lines (the bridge words the mention): Send swaps each readable `@label`
  // in the text for its wire form. Kept across launches with the drafts that hold the labels.
  state mentions: string[] = [] persist
  state receipt = ""
  state queueEdit = ""
  state queueDraft = ""
  state picking = false
  state showTodos = false
  // Optimistic send: the bubble appears instantly; the server row replaces it.
  state echoText = ""
  // The work-details mode (compact / standard / detailed / verbose), or `follow` to mirror the Mac's setting. Empty — never
  // chosen — is the phone's own default: compact (a phone screen is narrow, and the Mac's pick need not decide it).
  state viewMode = "" persist
  // Process groups the person opened, and the turns whose process they opened (`+turn`) or closed (`-turn`) against the default.
  state openGroups: string[] = []
  state turnPicks: string[] = []
  // A turn the rail asked for that is not loaded yet: the window grows until it is (or stops growing).
  state jumpWant = 0
  state jumpTries = 0
  // Mirrors the desktop view-options archived filter: hidden by default, a
  // Settings toggle mixes archived rows back in (grayed).
  state showArchived = false persist
  state quotaSeen = ""
  // The approval / question whose answer is in flight or failed last, so an old failure never shows on a new card.
  state aSentId = ""
  state qSentId = ""
  state lang = "" persist
  state lastFork = ""
  state effortModel = ""
  state effortProvider = ""
  // The small poll runs every tick; the rows fetch only when the transcript revision
  // moves, so an idle session stops re-carrying its whole history.
  state listRows: SessionRow[] = []
  state listRev = ""
  // The language the bridge words its own rows in (steering marker, triggers, context, compaction, commands, retries,
  // failures): the one chosen in Settings, else the table the system picked for the app.
  derive effLang = lang != "" ? lang : t("lang.code")
  resource live = loadLive(server, token, selected, listRev, showArchived, effLang) when token != "" as shape LiveCore else empty()
  resource rows = loadRows(server, token, selected, take, live.rowsRev, effLang) when token != "" and selected != "" as shape Rows else empty()
  // The UI's snapshot: the live poll's LiveCore, with the sessions list's
  // cache preferred. Rows-sourced state (messages/hasMore/turns) is derived
  // below — the Snapshot wrap this replaced forced the live seam to carry
  // those fields (and their descriptor) a second time.
  derive snap = LiveCore(live, sessions=(listRows.length > 0 ? listRows : live.sessions))
  derive msgs = selected == "" ? [] : mergeRows(older, rows.rows)
  derive rowsMore = selected == "" ? false : (olderLoaded ? olderMore : rows.hasMore and rows.from > 0)
  derive historyCursor = olderLoaded ? olderFrom : rows.from
  derive loadingMore = moreSid == selected and pending(more)
  derive moreErr = moreSid == selected ? (match failure(more) { case some(f) => f.message, case none => "" }) : ""
  derive historyState = loadingMore ? "loading" : moreErr != "" ? "error" : rowsMore ? "ready" : "end"
  derive olderReply = match more { case some(p) => p, case none => History(session="", before=0, from=0, hasMore=false, rows=[]) }
  derive turnList = selected == "" ? [] : rows.turns
  resource view = exactViewport() as shape Viewport
  // Composer takeover (the desktop's composer chain): a pending question / plan review wins the seat, then an
  // approval (the newest one, as the desktop shows the last published).
  derive qList = match snap.question { case some(q) => [q], case none => [] }
  derive qCall = match snap.question { case some(q) => q.callId, case none => "" }
  derive lastApproval = snap.approvals.filter((a, i) => i == snap.approvals.length - 1)
  derive takeover = qList.length > 0 or lastApproval.length > 0
  derive aErr = (match answered { case some(r) => (r.ok or aSentId != lastApprovalId) ? "" : answerErr(r.error), case none => "" })
  derive lastApprovalId = match first(lastApproval) { case some(a) => a.id, case none => "" }
  derive qErr = (match qAnswered { case some(r) => (r.ok or qSentId != qCurrentId) ? "" : answerErr(r.error), case none => "" })
  derive qCurrentId = match snap.question { case some(q) => q.id, case none => "" }
  // What a turn shows is the phone's own work-details mode — compact unless the person chose one in Settings or asked to follow
  // the Mac (ui-chat presentation-policy.ts; the Mac's setting itself is never touched from here). The bridge says which assistant
  // row belongs to the turn still open (`active`), so a new turn's first poll never opens the previous turn's row.
  derive pMode = viewMode == "follow" ? (snap.prefs.transcriptView == "" ? "standard" : snap.prefs.transcriptView) : (viewMode != "" ? viewMode : "compact")
  // verbose never folds a turn nor groups its steps; compact and standard group every turn, detailed only the ones that are history.
  derive foldOn = pMode != "verbose"
  derive groupMode = (pMode == "compact" or pMode == "standard") ? "all" : (pMode == "detailed" ? "history" : "none")
  derive liveDetail = pMode == "standard" or pMode == "detailed"
  derive thinkPreview = pMode != "compact"
  derive keepAll = snap.prefs.foldedReplies != "final"
  // With "next input" timing the latest exchange stays open until the person sends again (a send still in flight folds it at once).
  derive deferNext = snap.prefs.collapseTiming == "next-input" and not (echoText != "" and lastUserText != echoText)
  derive lastUserSeq = match msgs.filter(m => m.role == "user").at(-1) { case some(m) => m.seq, case none => -1 }
  derive steer = steerPick != "" ? steerPick == "steer" : snap.prefs.busyEnter == "steer"
  derive detailedUsage = snap.prefs.performanceUsage != "compact"
  derive liveRows = (snap.running ? msgs.filter(m => m.active).map(m => m.id) : []).concat(["streaming"])
  // A subagent child takes no prompts, unless it can continue (DSH's read-only composer).
  derive readOnly = snap.origin == "subagent" and snap.subagentMode != "continuable"
  // Files go to the host's staging under the session's own agent: a subagent child takes pictures only.
  derive canFiles = snap.limits.files and snap.origin != "subagent"
  // The Mac's bridge is older than this app needs (cursor history pages arrived in API 12): say so once the list has loaded.
  derive bridgeOld = signedIn and everOk and snap.bridgeApi < 12
  derive feedbackCategories = ["task-result", "instruction-following", "product-interaction", "service-stability", "resource-cost", "security-privacy-permission", "other"]
  derive fbError = match rated { case some(r) => (r.ok or fbMsg == "" or not fbSent ? "" : fbErr(r.error)), case none => "" }
  derive macErr = match macOpened { case some(r) => (r.ok ? "" : r.error), case none => "" }
  // The open task's row (a blank one for a new task) and how its editor fields read.
  derive task = match first(sched.items.filter(x => x.tid == sEdit)) { case some(x) => x, case none => blankTask() }
  derive schedFail = match schedSaved { case some(r) => (r.ok ? "" : schedErr(r.error)), case none => "" }
  derive taskFail = not sSent ? "" : schedFail != "" ? schedFail : (match schedDeleted { case some(r) => (r.ok ? "" : schedErr(r.error)), case none => (match schedToggled { case some(r) => (r.ok ? "" : schedErr(r.error)), case none => (match schedRan { case some(r) => (r.ok ? "" : schedErr(r.error)), case none => "" }) }) })
  derive intervalOk = match parseNumber(sInterval) { case some(n) => n >= 1 and n == round(n), case none => false }
  derive taskValid = sName.trim() != "" and sPrompt.trim() != "" and (sMode == "custom" or (sMode == "once" ? sDate != "" and sTime != "" : (sMode == "every" ? intervalOk : (sMode == "daily" ? sTime != "" : sTime != "" and sDays != ""))))
  derive still = view.prefersReducedMotion
  mutation detail as shape CallDetail
  mutation more as shape History then afterMore
  mutation sent as shape Reply refreshes live then afterSend
  mutation uploaded as shape UploadReply then afterUpload
  state filePath = ""
  state imgFull = ""
  // The task editor: which task is open ("new" for a new one) and its fields; a task is deleted in two steps.
  state sEdit = ""
  state sName = ""
  state sPrompt = ""
  state sMode = "daily"
  state sDate = ""
  state sTime = "09:00"
  state sZone = ""
  state sInterval = "1"
  state sUnit = "minutes"
  state sDays = ""
  state sConfirmDel = false
  // A task action was sent from this page (so the last reply's refusal is about this task, not an older one).
  state sSent = false
  // The feedback dialog (either thumb opens it): the message, the rating it records, its category and details.
  state fbMsg = ""
  state fbRating = ""
  state fbCategory = ""
  state fbText = ""
  // The comparison page: which turn's file (the host summary `diffSeq` and its index, or the turn and path), and a job whose output is open.
  state diffTurn = -1
  state diffSeq = 0
  state diffIdx = -1
  state diffPath = ""
  state openJob = ""
  state jobTick = 0
  state jobPolls = 0
  state fbSent = false
  state doneToast = ""
  state wasRunning = false
  // Pictures and files waiting to go with the next message (each for its own session), how many an upload in flight carries, its refusal.
  state atts: AttRow[] = []
  state upN = 0
  state attachErr = ""
  // The composer meter's panel (system prompt / tool definitions / messages), and the attach button's choice between the photo library and files.
  state showCtx = false
  state attachMenu = false
  mutation stopped as shape Reply refreshes live
  mutation answered as shape Reply refreshes live
  mutation qAnswered as shape Reply refreshes live
  mutation rated as shape Reply refreshes feedback then afterRate
  mutation cleared as shape Reply refreshes feedback
  mutation macOpened as shape Reply then afterMac
  mutation schedToggled as shape Reply refreshes sched
  mutation qDismissed as shape Reply refreshes live
  mutation qHeld as shape Reply refreshes live
  mutation qRevealed as shape Reply refreshes live
  mutation dequeued as shape Reply refreshes live
  mutation revoked as shape Reply refreshes devices
  mutation queueSaved as shape Reply refreshes live
  mutation goalSet as shape Reply refreshes live
  mutation jobKilled as shape Reply refreshes live
  mutation schedSaved as shape Reply refreshes sched then afterSched
  mutation schedRan as shape Reply refreshes sched
  mutation schedDeleted as shape Reply refreshes sched then afterSched
  mutation flagged as shape Reply refreshes live then afterFlag
  mutation forkedHere as shape Created refreshes live
  mutation paired as shape PairReply then afterPair
  mutation opened as shape MediaStream then arm
  mutation scanned as shape PairLink then afterLink
  mutation trackStopped as shape MediaStreamTrack
  mutation permissionSet as shape Reply refreshes live then afterPermission
  mutation created as shape Created then afterCreate
  mutation renamed as shape Created refreshes live then afterRename
  mutation forked as shape Created then afterFork
  // A QR holds the Mac's address and a fresh code, so one scan replaces typing both.
  resource models = loadModels(server, token, selected) when selected != "" and top(nav).name == "models" as shape ModelsReply else empty()
  resource devices = loadDevices(server, token) when top(nav).name == "settings" as shape DevicesReply else empty()
  resource commands = loadCommands(server, token, selected) when selected != "" as shape CommandsReply else empty()
  // A file link in a message body arrives as `/file?p=<path>` (the bridge rewrites it); a tap on a card's path sets `filePath`.
  derive viewParam = top(nav).name == "viewer" ? searchParam(top(nav), "p") : ""
  derive viewPath = viewParam != "" ? viewParam : filePath
  derive imgSrc = imgFull != "" and imgTry > 0 ? `${imgFull}${imgFull.includes("?") ? "&" : "?"}r=${imgTry}` : imgFull
  resource file = loadFile(server, token, selected, viewPath) when top(nav).name == "viewer" and viewPath != "" as shape FileDoc else empty()
  resource sched = loadSchedules(server, token, effLang) when token != "" and (top(nav).name == "schedules" or top(nav).name == "task") as shape SchedulesReply else empty()
  resource feedback = loadFeedback(server, token, selected) when token != "" and selected != "" as shape FeedbackReply else empty()
  resource changes = loadChanges(server, token, selected, diffSeq, diffIdx, diffTurn, diffPath, effLang) when top(nav).name == "diff" and diffPath != "" as shape ChangesDoc else empty()
  resource jobOut = loadJobOutput(server, token, selected, openJob, jobTick) when top(nav).name == "jobs" and openJob != "" as shape JobOutput else empty()
  mutation chose as shape Reply refreshes live then afterModel
  mutation continued as shape Reply refreshes live then afterContinue
  mutation planned as shape Reply refreshes live then afterPlan
  mutation commanded as shape Reply refreshes live then afterCommand
  resource scan = detectedBarcodes(track=scanTrack, formats=["qr_code"], interval=200) when scanTrack != "" as shape BarcodeScan else empty()
  derive backCamera = MediaTrackConstraints(deviceId=none, groupId=none, facingMode=some("environment"), width=none, height=none, aspectRatio=none, frameRate=none, resizeMode=none, zoom=none, torch=none, sampleRate=none, sampleSize=none, channelCount=none, echoCancellation=none, autoGainControl=none, noiseSuppression=none, latency=none)
  derive selected = match stack(nav).filter(e => e.name == "chat").at(-1) { case some(e) => e.params.id, case none => "" }
  // The composer's text: this session's draft (whole while the app has been open, else the capped copy a relaunch kept).
  derive draft = draftIn(liveDrafts, selected) != "" ? draftIn(liveDrafts, selected) : draftIn(drafts, selected)
  // The @ token at the end of the draft (file-reference grammar): `@path` or an open quote `@"a b`, after the start or whitespace.
  derive atTail = match draft.split("@").at(-1) { case some(v) => v, case none => "" }
  derive atHead = draft.slice(0, draft.length - atTail.length - 1)
  derive atQuoted = atTail.startsWith("\"") and not atTail.slice(1).includes("\"")
  derive atQuery = atQuoted ? atTail.slice(1) : atTail
  derive atActive = draft.includes("@") and (atHead == "" or atHead.endsWith(" ") or atHead.endsWith("\n")) and (atQuoted or not (atTail.includes(" ") or atTail.includes("\n"))) and not readOnly
  derive atDir = dirOf(atQuery)
  resource refs = loadRefs(server, token, selected, atQuery, atQuoted, effLang) when selected != "" and atActive and not takeover as shape RefsReply else empty()
  derive signedIn = token != ""
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive pairError = match paired { case some(r) => r.error, case none => "" }
  derive linkError = match scanned { case some(r) => r.error, case none => "" }
  // The first code the viewfinder reports; the person confirms it with one tap.
  derive firstCode = scanTrack == "" ? "" : match first(scan.barcodes) { case some(b) => b.rawValue, case none => "" }
  // A Quick Tunnel gets a new name on every start; the stored address then 530s.
  derive dCallId = match detail { case some(d) => d.callId, case none => "" }
  derive dView = match detail { case some(d) => d.view, case none => ToolView(kind="", head="", tone="", more=0, parts=[]) }
  derive linkStale = failsSinceOk >= 2
  // A 401 from the bridge: the stored pairing token was dropped on the Mac side
  // (state reset or revocation). Only a re-scan fixes it — the network is fine.
  derive authStale = match failure(live) { case some(f) => f.message == "unauthorized", case none => false }
  derive connectionState = not signedIn ? "signed-out" : authStale ? "unauthorized" : linkStale ? "offline" : everOk ? "online" : "connecting"
  derive createdId = match created { case some(r) => r.id, case none => "" }
  derive forkedId = match forked { case some(r) => r.id, case none => "" }
  derive forkedHereId = match forkedHere { case some(r) => r.id, case none => "" }
  derive cameraError = match failure(opened) { case some(f) => f.code == "NotAllowedError" ? t("scan.denied") : t("scan.failed", code=f.code), case none => "" }
  derive effortOptions = match first(models.models.filter(m => m.id == effortModel)) { case some(m) => m.efforts, case none => [] }
  // One entry per distinct workspace the Mac already has sessions in.
  derive workspaces = snap.sessions.map(row => row.cwd).filter((c, i) => c != "" and snap.sessions.map(row => row.cwd).indexOf(c) == i)
  derive stIn = (snap.stats.inTok >= 1000000 ? `${floor(snap.stats.inTok / 1000000)}M` : snap.stats.inTok >= 1000 ? `${floor(snap.stats.inTok / 1000)}k` : `${snap.stats.inTok}`)
  derive stOut = (snap.stats.outTok >= 1000000 ? `${floor(snap.stats.outTok / 1000000)}M` : snap.stats.outTok >= 1000 ? `${floor(snap.stats.outTok / 1000)}k` : `${snap.stats.outTok}`)
  derive stCache = (snap.stats.cacheRead >= 1000000 ? `${floor(snap.stats.cacheRead / 1000000)}M` : snap.stats.cacheRead >= 1000 ? `${floor(snap.stats.cacheRead / 1000)}k` : `${snap.stats.cacheRead}`)
  derive stAvg = ((snap.stats.inTok + snap.stats.cacheRead + snap.stats.outTok) / (snap.stats.turns < 1 ? 1 : snap.stats.turns) >= 1000 ? `${floor((snap.stats.inTok + snap.stats.cacheRead + snap.stats.outTok) / (snap.stats.turns < 1 ? 1 : snap.stats.turns) / 1000)}k` : `${floor((snap.stats.inTok + snap.stats.cacheRead + snap.stats.outTok) / (snap.stats.turns < 1 ? 1 : snap.stats.turns))}`)
  derive todoDone = snap.todos.filter(t => t.state == "completed").length
  derive todoTotal = snap.todos.length
  derive selAtts = atts.filter(a => a.sid == selected)
  derive imgCount = selAtts.filter(a => a.kind == "image").length
  derive hasAtt = selAtts.length > 0
  derive imgIds = selAtts.filter(a => a.kind == "image").map(a => a.id).join(",")
  derive fileIds = selAtts.filter(a => a.kind == "file").map(a => a.id).join(",")
  derive composerEmpty = draft.trim() == "" and not hasAtt
  derive canSend = not composerEmpty and not pending(sent) and not pending(uploaded) and selected != ""
  derive pollActivity = snap.running or snap.streamBlocks.length > 0 or snap.approvals.length > 0 or snap.question != none or jumpWant != 0
  // The primary button (InputBar): stop while a turn runs and nothing is typed, 继续生成 after a continuable failure, else send. A subagent
  // keeps Send primary (its Stop is the header's).
  derive primaryMode = (snap.running and composerEmpty) ? "stop" : (not snap.running and snap.continueSeq >= 0 and composerEmpty and snap.queue.length == 0 ? "continue" : "send")
  // Plan mode is on, or about to be (the Mac applies a selection made mid-turn at the next step).
  derive planOn = snap.planMode == "on" or snap.planMode == "entering"
  derive ctx = match snap.context { case some(c) => c, case none => ContextRow(used=0, total=0, system=0, tools=0, messages=0) }
  derive ctxPct = ctx.total > 0 ? min(100, round(100 * ctx.used / ctx.total)) : -1
  // The goal strip above the composer: any goal that is not complete.
  derive goalShown = snap.goalId != "" and snap.goalPhase != "complete"
  derive goalErr = match goalSet { case some(r) => r.error, case none => "" }
  // The settled transcript plus the attempt still streaming: its blocks run on in the open turn's row (its groups continue), or
  // are the turn's first assistant row while it has none yet; one `for` holds the list.
  derive body = snap.streamBlocks.length == 0 ? msgs : (msgs.filter(m => m.active).length > 0 ? msgs.map(m => m.active ? MessageRow(m, blocks=m.blocks.concat(snap.streamBlocks)) : m) : msgs.concat([blankRow("streaming", "assistant", 2147483000, "", snap.streamBlocks, true)]))
  derive goalRow = (snap.plan.steps.length == 0 ? [] : [blankRow("goal", "goal", -1, "", snap.plan.steps.map(step => BlockRow(
      child="", lazy=false, id=step.id, kind="plan",
      text=step.text, detail="", status=step.state, nodes=[], callId="", icon="", summary="", args="", badge="", todoSummary="", todos=[], files=[], question="", options=[], att="", w=0, h=0, images=[], ask=none, grp="", answer=false, title="", suffix="", added=0, removed=0, view=ToolView(kind="", head="", tone="", more=0, parts=[]))), false)])
  // A fork child: desktop's InheritedHistory separator at the transcript top.
  derive seedRow = (snap.inherited and msgs.length > 0 ? [blankRow("seed", "seed", 0, "", [], false)] : [])
  derive threadBase = seedRow.concat(goalRow.concat(body))
  // Each assistant row's presentation: whether its process is folded behind the turn control, whether group headers stand in for
  // their members, and which group is live. A row is in the latest exchange when it follows the last user message.
  derive thread = threadBase.map(m => m.role == "assistant" ? MessageRow(m, blocks=(openCall != "" and dCallId == openCall ? m.blocks.map(b => b.callId == openCall ? BlockRow(b, view=dView) : b) : m.blocks), fold=rowFold(m, foldOn, turnPicks, deferNext and m.seq > lastUserSeq), grouped=rowGrouped(m, groupMode, deferNext and m.seq > lastUserSeq), liveGroup=(m.active and snap.running ? lastGrp(m.blocks) : "")) : m)
  derive matchRows = msgs.filter(m => (m.role == "user" or m.role == "assistant") and findQ.trim() != "" and m.text.toLowerCase().includes(findQ.trim().toLowerCase()))
  derive findRows = [blankRow("find-note", "note", 0, t("find.note", n=matchRows.length, total=msgs.length), [], false)].concat(matchRows)
  // The slash menu: the host's commands, the client-side ones (file, model) and the skills, in the official sections and usage order.
  derive localSlash = [SlashRow(name="file", label=cmdLabel("file"), description="", hint="", kind="local", section="add", rank=0), SlashRow(name="model", label=cmdLabel("model"), description=cmdDesc("model", ""), hint="", kind="local", section="commands", rank=12)]
  derive slashAll = sortBy(commands.commands.map(c => SlashRow(name=c.name, label=cmdLabel(c.name), description=cmdDesc(c.name, c.description), hint=c.hint, kind="command", section=cmdSection(c.name), rank=cmdRank(c.name))).concat(localSlash).concat(commands.skills.map(k => SlashRow(name=k.name, label="", description=(k.userOnly ? `${t("cmd.userOnly")} · ${k.description}` : k.description), hint="", kind="skill", section="skills", rank=100))), r => r.rank)
  derive slashMatches = slashAll.filter(r => ("/" + r.name).startsWith(draft.trim().toLowerCase()) and draft.trim() != "/" + r.name)
  // `/name args` runs that host command; any other text, an unknown /name too, is a prompt.
  derive slashSp = draft.trim().indexOf(" ")
  derive slashName = draft.trim().startsWith("/") ? (slashSp < 0 ? draft.trim().slice(1) : draft.trim().slice(1, slashSp)).toLowerCase() : ""
  derive slashArgs = slashSp < 0 ? "" : draft.trim().slice(slashSp + 1).trim()
  derive slashHit = first(slashAll.filter(r => r.name == slashName and r.kind != "skill"))
  derive slashKnown = slashName != "" and (match slashHit { case some(r) => true, case none => false })
  derive slashKind = match slashHit { case some(r) => r.kind, case none => "" }
  // The ghost hint once a command is picked and its arguments are still to type (plan: describe the task; goal: the objective, or the goal's verbs).
  derive slashHint = (slashKnown and slashArgs == "" and draft.endsWith(" ")) ? (slashName == "goal" ? (snap.goalId != "" ? t("hint.goal.active") : t("hint.goal")) : (slashName == "plan" ? t("hint.plan") : (match slashHit { case some(r) => r.hint, case none => "" }))) : ""
  derive lastId = match msgs.at(-1) { case some(m) => m.id, case none => "" }
  // Entering a session lands on the newest content: the tail of the last message when the
  // turn has already answered, or the start of the pending prompt while it is still running.
  // The newest thing the person said: the last user row, or a steering block the turn's assistant row took in after it.
  derive tailRow = msgs.filter(m => m.role == "user" or m.role == "assistant").at(-1)
  derive lastSteer = match tailRow { case some(m) => m.role == "assistant" ? (match m.blocks.filter(b => b.kind == "steer").at(-1) { case some(b) => b.text, case none => "" }) : "", case none => "" }
  derive lastUserText = lastSteer != "" ? lastSteer : (match msgs.filter(m => m.role == "user").at(-1) { case some(u) => u.text, case none => "" })
  derive anchor = match msgs.at(-1) { case some(m) => m.id, case none => "" }
  derive anchorEnd = match msgs.at(-1) { case some(m) => m.role != "user", case none => false }
  derive shown = snap.sessions.filter(s => query.trim() == "" or (s.title == "" ? t("list.untitled") : s.title).toLowerCase().includes(query.trim().toLowerCase()) or s.cwd.toLowerCase().includes(query.trim().toLowerCase()))

  task tick mount
    every(700, poll)

  // A dshm:// link the system handed the app: the /open route fires this once per link.
  // It never writes nav (a change task may not touch its gate); the view offers the way in.
  task openPair when top(nav).name == "open" key=top(nav).id
    change(openLink)

  // The viewfinder recognized a code: pair at once. A timer task (not a
  // change task) — afterLink stops the camera, which is this trigger's input.
  task doneWatch when token != "" and selected != "" key=snap.running
    change(checkDone)

  task railSync when pinned == selected and selected != "" and railSynced != curTurn
    after(80, syncRail)

  task jumpSettle when jumpTurning > 0 key=jumpTurning
    after(700, clearJumpTurn)

  task visibleSettle when visibleCandidate > 0 and visibleCandidate != visibleTurn and jumpTurning == 0 key=visibleCandidate
    after(300, settleVisibleTurn)

  task toastClear when doneToast != ""
    after(4000, clearDoneToast)
  task copiedClear when copied != "" key=copied
    after(1600, clearCopied)
  task scanWatch mount
    every(300, tryAutoPair)

  derive openUrl = searchParam(top(nav), "u")
  derive deepError = match deepLinked { case some(r) => r.error, case none => "" }
  mutation deepLinked as shape PairLink then afterDeep
  action openLink
    if openUrl != "" and not pending(deepLinked)
      send deepLinked = pairFromLink(openUrl)
  action afterDeep
    if match deepLinked { case some(r) => r.ok, case none => false }
      token = match deepLinked { case some(r) => r.token, case none => "" }
      server = match deepLinked { case some(r) => r.server, case none => server }
      alt = match deepLinked { case some(r) => r.alt, case none => "" }
  // The direct path died (Tailscale quit, network changed): swap to the fallback
  // in one tap. Swapping keeps the way back if the tunnel is the dead one.
  action useAlt
    if alt != "" and alt != server
      server = alt
      alt = ""
      failsSinceOk = 0
  action goHome
    nav = go(nav, "/")

  // TurnNavigator parity (mobile): one chip per turn of the session (the Mac's outline; the loaded turns while it serves none).
  // A loaded turn opens with a user's message or the trigger that woke it (steering inside a turn is no turn): tapping scrolls
  // to that row. An unloaded one grows the window until it is loaded (a few polls), then scrolls to it.
  derive turnRows = msgs.filter(m => m.role == "user" or m.role == "trigger")
  derive railTurns = turnList.length > 0 ? turnList : turnRows.map(r => r.turn)
  derive lastTurn = match railTurns.at(-1) { case some(v) => v, case none => 0 }
  // The last valid row under the top edge. A transient empty key or an at-end bounce never moves it to another turn.
  derive curTurn = visibleTurn > 0 ? visibleTurn : lastTurn
  action jumpTurn(id: string, n: number)
    visibleTurn = n
    visibleCandidate = 0
    jumpTurning = n
    stick = false
    scrollIntoView("transcript", id, block="start", behavior="smooth")
  action jumpTo(n: number)
    let at = openerOf(turnRows, n)
    if at != ""
      jumpTurn(at, n)
    else
      if rowsMore
        jumpWant = n
        jumpTries = 0
        stick = false
        anchorKey = ""
        take = min(max(take, railTurns.filter(x => x >= n).length + 2), 120)
  action jumpLatest
    if lastId != ""
      visibleTurn = lastTurn
      visibleCandidate = 0
      jumpTurning = 0
      scrollIntoView("transcript", lastId, block="start", behavior="smooth")
      stick = true
      pinned = selected
  action clearJumpTurn
    jumpTurning = 0
  action settleVisibleTurn
    if visibleCandidate > 0 and jumpTurning == 0
      visibleTurn = visibleCandidate
  action syncRail
    if curTurn > 0
      railSynced = curTurn
      scrollIntoView(`turn-${curTurn}`, block="nearest", inline="nearest", behavior="instant")
  action railMoved(x: number, y: number)
    railLeft = x
  action poll
    // Hot (a turn running or streaming, something waiting on the person, or just after a
    // send or command): refresh on every 700 ms tick. Idle: on every fourth, ~2.8 s: a phone
    // on LTE does not need to re-read the same list three times a second.
    let hot = pollActivity or performanceNow() < hotUntil
    let due = (hot or idlePolls == 0) and not pending(live)
    idlePolls = (hot or idlePolls >= 3) ? 0 : idlePolls + 1
    // A failure counts once per refresh actually made: a skipped tick leaves the count alone,
    // so the wait between idle refreshes can never read as "unreachable" or swap paths.
    let nextFails = due ? (match failure(live) { case some(f) => failsSinceOk + 1, case none => 0 }) : failsSinceOk
    failsSinceOk = nextFails
    if echoText != "" and lastUserText == echoText
      echoText = ""
    // Direct path dark? Swap to the alternate (keeping the way back). Toggling
    // every two failures probes both paths while either may be restarting —
    // a one-shot latch could strand us on a tunnel that died after the swap.
    if nextFails >= 2 and alt != "" and alt != server
      let oldPath = server
      server = alt
      alt = oldPath
      failsSinceOk = 0
    if nextFails == 0
      everOk = true
    if due
      refresh live
    if live.sessions.length > 0
      listRows = live.sessions
    if live.listRev != ""
      listRev = live.listRev
    if forkedHereId != "" and forkedHereId != lastFork
      lastFork = forkedHereId
      receipt = t("chat.forkedHere")
    let grew = msgs.length != loadedCount
    loadedCount = msgs.length
    let failedMore = moreErr != ""
    let restoreKey = failedMore ? "" : anchorKey
    let restorePending = failedMore ? 0 : anchorPending
    if failedMore
      anchorKey = ""
      anchorPending = 0
    // Prepend compensation, applied on the tick the window grows and once more on the
    // next tick: the virtual list lays the new rows out a frame later.
    let armed = grew and restoreKey != ""
    if restoreKey != "" and (armed or restorePending > 0)
      scrollIntoView("transcript", restoreKey, offset=anchorOffset, behavior="instant")
      let left = (armed ? 2 : restorePending) - 1
      if left == 0
        anchorKey = ""
      anchorPending = left
    // A turn the rail asked for: land on it once its row is here (the prepend compensation above scrolls twice), give up when the
    // window stopped growing.
    if jumpWant != 0
      let at = openerOf(turnRows, jumpWant)
      if at != ""
        anchorKey = at
        anchorOffset = 0.0
        anchorPending = 2
        jumpWant = 0
      else
        let tries = jumpTries + 1
        jumpTries = tries
        if tries > 12 and not pending(rows)
          receipt = t("chat.turnTooOld", n=jumpWant)
          jumpWant = 0
    if pinned != selected and anchor != "" and top(nav).name == "chat"
      if anchorEnd
        scrollIntoView("transcript", anchor, block="end", behavior="instant")
      else
        scrollIntoView("transcript", anchor, block="start", behavior="instant")
      pinned = selected
      visibleTurn = lastTurn
      visibleCandidate = 0
    // A running job's output stays current while its page is open (the tail is asked again every fourth tick).
    let jobRuns = top(nav).name == "jobs" and openJob != "" and (match first(snap.jobs.filter(j => j.id == openJob)) { case some(j) => j.status == "running" or j.status == "stopping", case none => false })
    if jobRuns and not pending(jobOut)
      let n = jobPolls + 1
      jobPolls = n >= 4 ? 0 : n
      if n >= 4
        jobTick = jobTick + 1
    if scanTrack != "" and top(nav).name != "scan"
      send trackStopped = stopTrack(track=scanTrack)
      scanTrack = ""
  action editServer(v: string)
    server = v
  action editToken(v: string)
    token = v.trim()
  action editCode(v: string)
    code = v.trim()
  action leave
    pinned = ""
    nav = back(nav)
  // Every write to the composer's text goes through here: whole in the live list, capped in the saved one. A reply that clears a draft names the
  // session it was sent for (`sentSid`), which may no longer be the one on screen.
  action setDraftFor(sid: string, v: string)
    if sid != ""
      liveDrafts = putDraft(liveDrafts, sid, v, 100000, 24)
      drafts = putDraft(drafts, sid, v, 600, 6)
  action setDraft(v: string)
    setDraftFor(selected, v)
  action editDraft(v: string)
    setDraft(v)
  action editScanNote(v: string)
    scanNote = v
  action toggleCall(id: string, seq: number)
    let opening = openCall != id
    openCall = opening ? id : ""
    if opening and selected != ""
      send detail = loadCall(server, token, selected, id, effLang, seq)
  // A card's folded lines: "… 其余 N 行" opens the rest (key = `callId.partId`).
  action togglePart(key: string)
    openParts = openParts.includes(key) ? openParts.filter(x => x != key) : openParts.concat([key])
  // A code block's copy button: the text to the clipboard, the button says 已复制 for a moment.
  action copyCode(key: string, v: string)
    copyText(v)
    copied = key
  action clearCopied
    copied = ""
  action reloadImage
    imgTry = imgTry + 1
  action startNew
    picking = true

  action cancelNew
    picking = false

  action newSession(cwd: string)
    if not pending(created)
      send created = createSession(server, token, cwd)
  action afterCreate
    picking = false
    if createdId != ""
      nav = push(nav, path("chat", createdId))
  action openMore
    renameDraft = snap.sessionTitle
    nav = push(nav, path("more", selected))
  action forkSession
    if selected != "" and not pending(forked)
      send forked = forkSession(server, token, selected)
  action afterFork
    if forkedId != ""
      // Land on the fork as a chat pushed over the session list, so the back
      // gesture returns to the list instead of leaving the app.
      nav = push(go(nav, "/"), path("chat", forkedId))
  action renameSession
    if selected != "" and renameDraft.trim() != "" and not pending(renamed)
      send renamed = renameSession(server, token, selected, renameDraft.trim())
  action afterRename
    if match renamed { case some(r) => r.id != "", case none => false }
      nav = back(nav)
  action editRename(v: string)
    renameDraft = v
  action resetTranscript
    take = 8
    stick = true
    older = []
    olderFrom = 0
    olderLoaded = false
    olderMore = false
    moreSid = ""
    anchorKey = ""
    anchorPending = 0
    topKey = ""
    topOffset = 0.0
    loadedCount = 0
    railLeft = 0.0
    railSynced = 0
    visibleTurn = 0
    visibleCandidate = 0
    jumpTurning = 0
    topArmed = false
    nearTop = false
    openGroups = []
    turnPicks = []
    jumpWant = 0
    jumpTries = 0
  action open(id: string)
    resetTranscript()
    nav = push(nav, path("chat", id))
  action openChild(id: string)
    if id != ""
      open(id)

  action openFile(p: string)
    imgFull = ""
    imgTry = 0
    filePath = p
    nav = push(nav, path("viewer"))
  action openImage(u: string)
    filePath = ""
    imgTry = 0
    imgFull = u
    nav = push(nav, path("viewer"))
  action openSchedules
    nav = push(go(nav, "/"), path("schedules"))
  // A task's page: its fields are loaded into the editor ("new": a blank one starting tomorrow at 09:00 in the Mac's zone).
  action openTask(tid: string)
    let hit = match first(sched.items.filter(x => x.tid == tid)) { case some(x) => x, case none => blankTask() }
    sEdit = tid
    sName = hit.title
    sPrompt = hit.prompt
    sMode = tid == "new" ? "daily" : hit.mode
    sDate = hit.date != "" ? hit.date : sched.tomorrow
    sTime = hit.time != "" ? hit.time : "09:00"
    sZone = hit.zone != "" ? hit.zone : sched.zone
    sInterval = `${hit.interval}`
    sUnit = hit.unit
    sDays = hit.days
    sConfirmDel = false
    sSent = false
    nav = push(nav, path("task", tid))
  action editSName(v: string)
    sName = v
  action editSPrompt(v: string)
    sPrompt = v
  action setSMode(v: string)
    sMode = v
  action editSDate(v: string)
    sDate = v
  action editSTime(v: string)
    sTime = v
  action editSZone(v: string)
    sZone = v
  action editSInterval(v: string)
    sInterval = v
  action setSUnit(v: string)
    sUnit = v
  action flipDay(d: number)
    sDays = toggleDay(sDays, d)
  action saveTask
    if taskValid and not pending(schedSaved)
      sSent = true
      send schedSaved = saveSchedule(server, token, sEdit == "new" ? "" : sEdit, task.updatedAt, sName.trim(), sPrompt.trim(), sMode, sDate, sTime, sZone.trim(), sInterval, sUnit, sDays)
  action afterSched
    let saved = match schedSaved { case some(r) => r.ok, case none => false }
    let gone = match schedDeleted { case some(r) => r.ok, case none => false }
    if (saved and top(nav).name == "task" and sEdit == "new") or gone
      nav = back(nav)
    sConfirmDel = false
  action toggleTask
    if not pending(schedToggled)
      sSent = true
      send schedToggled = toggleSchedule(server, token, task.tid, task.updatedAt, task.status != "active")
  action runTask
    if not pending(schedRan)
      sSent = true
      send schedRan = runSchedule(server, token, task.tid)
  action askDeleteTask
    sConfirmDel = true
  action cancelDeleteTask
    sConfirmDel = false
  action deleteTask
    if not pending(schedDeleted)
      sSent = true
      send schedDeleted = deleteSchedule(server, token, task.tid, task.updatedAt)
  // Message feedback: a thumb on a rating that is already recorded retracts it; any other opens the dialog (either thumb does, as on the desktop).
  action rateMsg(id: string, rating: string)
    if fbRatingOf(feedback.items, id) == rating
      if not pending(cleared)
        send cleared = clearRating(server, token, selected, id)
    else
      fbMsg = id
      fbRating = rating
      fbCategory = ""
      fbText = ""
      fbSent = false
  action pickCategory(c: string)
    fbCategory = fbCategory == c ? "" : c
  action editFbText(v: string)
    fbText = v
  action closeFb
    fbMsg = ""
    fbSent = false
  action submitFb
    if fbMsg != "" and not pending(rated)
      fbSent = true
      send rated = rateMessage(server, token, selected, fbMsg, fbRating, fbText, fbCategory)
  action afterRate
    if match rated { case some(r) => r.ok and fbMsg != "", case none => false }
      fbMsg = ""
      doneToast = t("feedback.thanks")
  // A changed file's comparison page (the host summary's `seq` and the file's index, or the turn and the path for a file the host did not record).
  action openDiff(turn: number, seq: number, i: number, p: string)
    diffTurn = turn
    diffSeq = seq
    diffIdx = i
    diffPath = p
    nav = push(nav, path("diff", selected))
  // Open a file or folder of this session's workspace on the Mac itself ('open': its default application, 'reveal': Finder).
  action macOpen(p: string, mode: string)
    if not pending(macOpened)
      send macOpened = openOnMac(server, token, selected, p, mode, effLang)
  action afterMac
    let r = match macOpened { case some(v) => v, case none => Reply(ok=false, error="") }
    if r.ok
      doneToast = t("mac.done")
  // A job row opens its output (the tail of its retained ring); the page asks again while it runs.
  action toggleJobOutput(id: string)
    openJob = openJob == id ? "" : id
    jobTick = jobTick + 1
  // A row of the @ menu: a folder drills (its text replaces the token and the menu stays open), a file lands as `@path `, a session or subagent
  // as its readable `@label ` with the wire mention kept for Send.
  action pickRef(kind: string, text: string, wire: string)
    if kind == "dir"
      setDraft(`${atHead}${text}`)
    else
      setDraft(`${atHead}${text} `)
      if wire != ""
        let ms = mentions.filter(m => not m.startsWith(`${text}\t`)).concat([`${text}\t${wire}`])
        mentions = ms.slice(max(0, ms.length - 12))
  // The folder being listed, settled as a reference of its own.
  action pickDir(done: string)
    setDraft(`${atHead}${done} `)
  action refUp
    setDraft(`${atHead}${atQuoted ? "@\"" : "@"}${parentOf(atQuery)}`)
  action clearDoneToast
    doneToast = ""
  action checkDone
    if wasRunning and not snap.running
      doneToast = t("chat.done")
    wasRunning = snap.running

  action openJobs
    nav = push(nav, path("jobs", selected))

  action openPermissions
    nav = push(nav, path("perm", selected))
  action choosePermission(v: string)
    if not pending(permissionSet)
      send permissionSet = setPermission(server, token, selected, v)
  action afterPermission
    if match permissionSet { case some(r) => r.error, case none => "" } == ""
      nav = back(nav)
  action openFind
    nav = push(nav, path("find", selected))
  action editFind(v: string)
    findQ = v
  action openModels
    nav = push(nav, path("models", selected))
  action chooseModel(provider: string, model: string, efforts: string[])
    if efforts.length > 0
      effortModel = model
      effortProvider = provider
    else
      pickModel(provider, model, "")

  action pickModel(provider: string, model: string, effort: string)
    send chose = setModel(server, token, selected, provider, model, effort)
  action backToModels
    effortModel = ""

  action afterModel
    nav = back(nav)
  action copyBody(v: string)
    copyText(v)
  // A command line. A client-side one opens its page or picker; a bare /permission opens the permission page (the official popup); the rest run
  // on the Mac as host commands (their receipt shows above the composer).
  action runSlash(name: string, args: string, kind: string)
    if kind == "local"
      setDraft("")
      if name == "model"
        openModels()
      else
        pickFiles()
    else if name == "permission" and args == ""
      setDraft("")
      openPermissions()
    else if not pending(commanded)
      hotUntil = performanceNow() + 10000
      sentSid = selected
      send commanded = runSessionCommand(server, token, selected, name, args)
  // A row of the slash menu: a skill lands as the plain `/name ` (the host loads it when the message goes), a command that takes input waits for it,
  // the others run at once.
  action runCommand(name: string, hint: string, kind: string)
    if kind == "skill"
      setDraft(`/${name} `)
    else if kind == "local" or name == "permission" or hint == ""
      runSlash(name, "", kind)
    else
      setDraft(`/${name} `)
  action killJob(jobId: string)
    if not pending(jobKilled)
      send jobKilled = killJob(server, token, selected, jobId)

  action setFlag(flag: string, on: bool)
    if not pending(flagged)
      send flagged = setSessionFlag(server, token, selected, flag, on)

  action forkHere(seq: number)
    if not pending(forkedHere)
      send forkedHere = forkFrom(server, token, selected, seq)

  action afterFlag
    nav = back(nav)

  action goalAction(verb: string)
    if not pending(goalSet)
      send goalSet = setGoalAction(server, token, selected, verb, "")
  // GoalBar's inline editor saves the new objective.
  action goalEdit(objective: string)
    if not pending(goalSet) and objective.trim() != ""
      send goalSet = setGoalAction(server, token, selected, "edit", objective.trim())
  // The plan chip: leave plan mode (/plan off), or enter it (a bare /plan: no message, so nothing is steered into the turn).
  action togglePlan
    if not pending(planned)
      hotUntil = performanceNow() + 10000
      send planned = runSessionCommand(server, token, selected, "plan", planOn ? "off" : "")
  action afterPlan
    let r = match planned { case some(v) => v, case none => Reply(ok=false, error="") }
    if not r.ok
      receipt = `✗ ${r.error}`
  action toggleCtx
    showCtx = not showCtx

  action setLang(code: string)
    setLocale(code)
    lang = code

  action setViewMode(v: string)
    viewMode = v

  // Toggling flips the bridge's list fingerprint, so the next poll carries the
  // full list again — no cursor to reset.
  action setShowArchived(on: bool)
    showArchived = on

  action toggleTodos
    showTodos = not showTodos

  action dismissReceipt
    receipt = ""

  action editQuery(v: string)
    query = v
  action loadFrom(key: string, offset: number)
    if rowsMore and not loadingMore and historyCursor > 0
      stick = false
      moreSid = selected
      anchorKey = (key == "" or key == "goal" or key == "more" ? "" : key)
      anchorOffset = offset
      anchorPending = 0
      send more = loadOlder(server, token, selected, historyCursor, effLang)
  action afterMore
    let p = olderReply
    if p.session == selected and p.before == historyCursor
      let combined = mergeRows(p.rows, older)
      let previous = older.length
      older = combined
      olderLoaded = true
      olderMore = p.hasMore and p.from > 0 and p.from < p.before and combined.length > previous
      olderFrom = p.from
      if combined.length == previous
        anchorKey = ""
        anchorPending = 0
  action loadEarlier
    loadFrom(topKey, topOffset)
  action moved(x: number, y: number, e: ScrollEvent)
    // The values this event carries, bound before anything reads them: writes land at the end of an action.
    let raw = match e.firstVisibleKey { case some(v) => v, case none => "" }
    // The pinned bar rows ("more", "goal") are not messages: anchoring on them
    // restores to the very top, which reads as "the list jumped to the oldest".
    let synthetic = raw == "more" or raw == "goal"
    let firstReal = match first(msgs) { case some(m) => m.id, case none => "" }
    let k = synthetic ? firstReal : raw
    let off = synthetic ? 0.0 : e.firstVisibleOffset
    let armed = topArmed
    let armAgain = e.scrollTop > 200
    let reachTop = e.scrollTop < 80
    let visible = match first(msgs.filter(m => m.id == k and m.turn >= 1)) { case some(m) => m.turn, case none => 0 }
    let atEnd = (e.scrollHeight - e.scrollTop - e.clientHeight) <= 24
    if visible > 0 and jumpTurning == 0 and not atEnd
      visibleCandidate = visible
    topKey = k
    topOffset = off
    // Following the end is a consequence of being at the end, not a mode to remember.
    stick = atEnd
    nearTop = e.scrollTop < 120
    // Armed stays armed while scrolling up: it used to be re-derived from
    // "scrollTop > 200" on every event, so creeping up past 200 disarmed the
    // trigger and reaching the top did nothing. It now only clears after a load.
    let willLoad = (armed or armAgain) and reachTop and pinned == selected and rowsMore and not loadingMore
    if willLoad
      loadFrom(k, off)
      topArmed = false
    else
      topArmed = armed or armAgain
  action toggleProcess(id: string)
    openProcess = (openProcess == id ? "" : id)
  // A process group's header opens or closes its members.
  action toggleGroup(id: string)
    openGroups = openGroups.includes(id) ? openGroups.filter(g => g != id) : openGroups.concat([id])
  // The turn control: the person's pick replaces the default (`fold` is what the turn shows now, so the pick is its opposite).
  action toggleTurn(turn: number, fold: bool, can: bool)
    if can
      turnPicks = turnPicks.filter(x => x != `+${turn}` and x != `-${turn}`).concat([fold ? `+${turn}` : `-${turn}`])
  action toggleRow(id: string)
    openRow = (openRow == id ? "" : id)
  action follow(url: string)
    // A chat link from a message body: keep the list under it so the back
    // gesture pops to the list instead of exiting the app.
    if url == "/"
      nav = go(nav, "/")
    else if url.startsWith("/file?")
      // A file link in a message (the bridge words it `/file?p=<path>`): the viewer opens over the chat.
      imgFull = ""
      nav = push(nav, url)
    else
      nav = push(go(nav, "/"), url)
  action toSettings
    nav = push(nav, "/settings")
  action revokeDevice(id: string)
    if not pending(revoked)
      send revoked = revokeDevice(server, token, id)

  action back
    nav = back(nav)
  action pair
    if code.length == 6 and not pending(paired)
      send paired = pairDevice(server, code)
  action afterPair
    if match paired { case some(r) => r.ok, case none => false }
      token = match paired { case some(r) => r.token, case none => "" }
      code = ""
      nav = back(nav)
  action openScan
    scanNote = ""
    scanTried = ""
    send opened = getUserMedia(video=true, videoConstraints=backCamera)
    nav = push(nav, "/scan")
  // The camera answered; a scan screen that was left while it asked stops the track.
  action arm
    match opened
      case some(s)
        let track = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        if top(nav).name == "scan"
          scanTrack = track
        else if track != ""
          send trackStopped = stopTrack(track=track)
      case none
        scanTrack = ""
  action connect(raw: string)
    if not pending(scanned)
      send scanned = pairFromLink(raw)
  // Fired by scanWatch: one shot per recognized code, so a failed pair
  // waits for the person's retry instead of looping.
  action tryAutoPair
    if top(nav).name == "scan" and firstCode != "" and scanTried != firstCode and not pending(scanned)
      scanTried = firstCode
      send scanned = pairFromLink(firstCode)
  action afterLink
    if match scanned { case some(r) => r.ok, case none => false }
      server = match scanned { case some(r) => r.server, case none => server }
      token = match scanned { case some(r) => r.token, case none => "" }
      alt = match scanned { case some(r) => r.alt, case none => "" }
      if scanTrack != ""
        send trackStopped = stopTrack(track=scanTrack)
      scanTrack = ""
      nav = go(nav, "/")
  action pickMode(v: bool)
    steerPick = v ? "steer" : "queue"
  // The message goes: a typed `/name args` that names a command runs it; anything else is a prompt (steered or queued while a turn runs), with
  // the pictures and files uploaded for this session.
  action sendDraft
    if canSend
      hotUntil = performanceNow() + 10000
      if slashKnown and not hasAtt
        runSlash(slashName, slashArgs, slashKind)
      else
        sentSid = selected
        echoText = draft.trim()
        send sent = sendPrompt(server, token, selected, draft.trim(), steer and snap.running, imgIds, fileIds, mentions.join("\n"), effLang)
  // The round button does what its label says: stop while a turn runs and nothing is typed, else send.
  action primary
    if primaryMode == "stop"
      stop()
    else
      sendDraft()
  // 继续生成: the prompt with no content a continuable failure takes, queued (the Mac re-checks the failed turn this button was showing).
  action continueRun
    if snap.continueSeq >= 0 and not pending(continued)
      hotUntil = performanceNow() + 10000
      send continued = continueGeneration(server, token, selected, snap.continueSeq, effLang)
  action afterContinue
    let r = match continued { case some(v) => v, case none => Reply(ok=false, error="") }
    if not r.ok
      receipt = `✗ ${r.error}`

  // The picker's answer (pictures and files of any type, several at once). A batch that would break a limit is refused whole; otherwise it uploads
  // in turn while the composer stays usable, and each file that made it becomes a chip.
  action pickedFiles(files: Picked[])
    attachErr = ""
    let pics = files.filter(f => f.type.startsWith("image/")).length
    let big = files.filter(f => not f.type.startsWith("image/") and f.size > snap.limits.fileBytes).length
    if files.length > 0 and selected != "" and not pending(uploaded)
      if imgCount + pics > snap.limits.images
        attachErr = t("attach.tooMany", count=snap.limits.images)
      else if files.length > pics and not canFiles
        attachErr = t("attach.noFiles")
      else if big > 0
        attachErr = t("attach.tooBig", size=`${floor(snap.limits.fileBytes / 1048576)}MB`)
      else
        upN = files.length
        send uploaded = uploadFiles(server, token, selected, files.map(f => `${f.path}\t${f.name}\t${f.type}`).join("\n"), effLang)

  action afterUpload
    let r = match uploaded { case some(v) => v, case none => UploadReply(ok=false, error=t("attach.noReply"), items=[]) }
    attachErr = r.error
    atts = atts.concat(r.items)
    upN = 0

  action removeAtt(id: string)
    atts = atts.filter(a => a.id != id)
    attachErr = ""

  // The attach button: where the Mac takes files, a choice between the photo library and the file picker (a file input with no `accept` is the
  // platform's document picker, which does not reach the photo library on iOS); otherwise the photo library at once.
  action attachTap
    if canFiles
      attachMenu = not attachMenu
    else
      pickPhotos()
  action pickPhotos
    attachMenu = false
    showPicker("photopick")
  action pickFiles
    attachMenu = false
    showPicker("filepick")

  action afterSend
    if sendError == ""
      setDraftFor(sentSid, "")
      atts = atts.filter(a => a.sid != sentSid)
      attachErr = ""
    else
      echoText = ""
  // A typed `/name args` ran as a host command: show its receipt, and keep the draft when it failed.
  action afterCommand
    let r = match commanded { case some(v) => v, case none => Reply(ok=false, error="") }
    receipt = (r.ok ? "✓ " : "✗ ") + r.error
    if r.ok
      setDraftFor(sentSid, "")
  action stop
    if selected != "" and not pending(stopped)
      send stopped = cancelRun(server, token, selected)
  // A tool approval, or a question-intent approval with the asker's own labels: allow / deny / always.
  action decide(id: string, which: string)
    if not pending(answered)
      aSentId = id
      hotUntil = performanceNow() + 10000
      send answered = respondApproval(server, token, id, which)

  // The question card's one submit: every question answered (or skipped) at once, `id|labels|custom` records
  // percent-encoded, `;`-joined. The card owns its drafts, the reply says whether the Mac took it.
  action answerQ(id: string, payload: string)
    if not pending(qAnswered)
      qSentId = id
      hotUntil = performanceNow() + 10000
      send qAnswered = answerQuestions(server, token, id, payload)
  // Close the card: cancel the whole set (a blocking question, a plan review: 要求修改), or just collapse it.
  action dismissQ(id: string)
    if not pending(qDismissed)
      qSentId = id
      hotUntil = performanceNow() + 10000
      send qDismissed = dismissQuestion(server, token, id)
  // 慢慢回答 / the first edit: stop the Mac's countdown.
  action holdQ(id: string, mode: string)
    if not pending(qHeld)
      send qHeld = holdQuestion(server, token, id, mode)
  // A tool row's 回答: put a collapsed question back.
  action revealQ(callId: string)
    if not pending(qRevealed)
      hotUntil = performanceNow() + 10000
      send qRevealed = revealQuestion(server, token, selected, callId)
  // Quote the first line of a turn into the composer, desktop's selection reply.
  action quoteBody(v: string)
    let line = match v.split("\n").at(0) { case some(l) => l, case none => "" }
    setDraft(`> ${line}\n${draft}`)
  action dismissQuota
    quotaSeen = snap.quotaId

  action dropQueued(itemId: string)
    if not pending(dequeued)
      send dequeued = dropQueued(server, token, selected, itemId)

  // QueueDock parity: rewrite a queued message in place, or steer it into the
  // running turn right now.
  action editQueue(itemId: string, text: string, editable: bool)
    if editable
      queueEdit = itemId
      queueDraft = text
  action queueInput(v: string)
    queueDraft = v
  action saveQueue(itemId: string)
    if queueDraft != "" and not pending(queueSaved)
      send queueSaved = queueItem(server, token, selected, itemId, "edit", queueDraft)
  action steerQueue(itemId: string, text: string)
    if snap.running and not pending(queueSaved)
      send queueSaved = queueItem(server, token, selected, itemId, "steer", text)
  action cancelQueueEdit
    queueEdit = ""
    queueDraft = ""

  view
    main navigationKey=`${top(nav).id}` navigate=follow interactive-widget="resizes-content" testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "sessions"
          column navigationKey=`${e.id}` navigationScroll="sessions-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column"
            row display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px" gap=8 background-color="surface.page"
              text "deepseek" role="heading" aria-level=1 font-size="min(-exact-headline, 32px)" flex="1 1 12rem" min-width=0 testId="app-title"
              if signedIn
                button press=openScan aria-label="Scan a pairing code" testId="scan-now"
                  image "symbol:photo"
                button press=startNew aria-label="New session" testId="new-session" disabled=pending(created)
                  image "symbol:add"
              button press=toSettings aria-label=t("settings.title") testId="settings"
                image "symbol:settings"
            row gap=6 align-items="baseline" padding="2px 16px 4px 16px" testId="version-line"
              text t("app.version") font-size="0.62rem" color="-exact-tertiary-label" testId="app-version"
              text t("ota.channel") font-size="0.62rem" color="-exact-tertiary-label"
            match snap.balance
              case some(bal)
                if not bal.signedOut and not bal.failed and bal.wallets.length > 0
                  row gap=6 align-items="baseline" padding="2px 16px 6px 16px" testId="balance-line"
                    text t("balance.label") font-size="0.69rem" color="-exact-tertiary-label"
                    for w in bal.wallets key=w.id
                      text `${w.currency == "CNY" ? "¥" : "$"}${w.text}` font-size="0.81rem" font-weight=600 color="text.ink"
                    for w in bal.bonus key=w.id
                      if w.text != "0.00"
                        text t("balance.bonus", cur=(w.currency == "CNY" ? "¥" : "$"), n=w.text) font-size="0.69rem" color="-exact-secondary-label"
              case none
                text ""
            if not signedIn
              column padding=24 gap=12 align-items="center"
                text t("list.signedOut") font="-exact-subheadline" color="-exact-secondary-label"
                button press=toSettings buttonStyle="filled" testId="pair-now"
                  text t("pair.pair")
                row press=openScan align-items="center" min-height=44 padding="0 8px" testId="scan-now"
                  text t("list.scanMac") color="-exact-secondary-label" font="-exact-subheadline"
            // The Mac's plugin is older than this app needs (it sends no wire revision, or an older one): say so once, with what to do.
            if bridgeOld
              row gap=8 align-items="flex-start" padding="8px 16px" background-color="surface.card" testId="bridge-old"
                image "symbol:alert" font-size="0.7rem" color="-exact-system-orange"
                text t("bridge.old") font-size="0.72rem" color="-exact-secondary-label" flex=1 min-width=0
            if connectionState == "connecting"
              column padding=24 gap=10 align-items="center" testId="connecting"
                image "assets/whale.svg" width=44 height=44 color="brand.fill"
                text t("pair.connecting") font="-exact-subheadline" color="-exact-secondary-label"
            if picking
              column gap=2 padding="6px 12px" background-color="surface.card" border-radius=12
                text t("ws.picker") font-size="0.69rem" color="-exact-tertiary-label"
                for w in workspaces key=w
                  row press=newSession(w) gap=8 align-items="center" padding="9px 6px" testId=`ws-${w}`
                    text w flex=1 min-width=0 font-size="0.75rem" line-clamp=1
                    image "symbol:forward-chevron" font-size="0.55rem" color="-exact-tertiary-label"
                row press=newSession("") gap=8 align-items="center" padding="9px 6px" testId="ws-default"
                  text t("ws.default") flex=1 min-width=0 font-size="0.75rem"
                row press=cancelNew justify-content="center" padding="6px 0" testId="ws-cancel"
                  text t("common.cancel") font-size="0.75rem" color="-exact-secondary-label"
            if connectionState == "unauthorized"
              // The Mac no longer knows this phone's token (bridge state reset or
              // revoked): the list would sit frozen on stale rows — say so and re-pair.
              column padding=16 gap=10 align-items="center" background-color="surface.card"
                image "symbol:alert" font-size="1.75rem" color="brand.fill"
                text t("pair.expired") font="-exact-subheadline" color="-exact-secondary-label" text-align="center" testId="auth-stale"
                button press=openScan buttonStyle="filled" testId="repair-scan"
                  text t("pair.repair")
            if connectionState == "offline"
              column padding=16 gap=10 align-items="center" background-color="surface.card"
                text t("pair.unreachable") font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="stale-note"
                row gap=10
                  button press=openScan buttonStyle="filled" testId="relink"
                    text t("pair.repair")
                  if alt != "" and alt != server
                    button press=useAlt buttonStyle="bordered" testId="use-alt"
                      text t("pair.useAlt")
                  button press=toSettings buttonStyle="bordered" testId="relink-settings"
                    text t("settings.title")
            else
              row padding="8px 16px 0 16px"
                input value=query input=editQuery placeholder=t("list.searchPlaceholder") aria-label="Search sessions" testId="search" flex=1 min-width=0 min-height=44 background-color="surface.card" border-radius=10 padding="10px 12px"
              list id="sessions-list" appearance="none" flex=1 min-height=0 testId="session-list"
                for s in shown key=s.id
                  column gap=0
                    if s.first and query.trim() == ""
                      text (s.group == "" ? t("list.ungrouped") : s.group) font="-exact-footnote" font-weight=600 color="-exact-secondary-label" padding="14px 16px 4px 16px" testId=`group-${s.id}`
                    row press=open(s.id) gap=12 align-items="center" padding="12px 16px"
                      // Leading status dot, like the desktop sidebar: filled while a turn runs, dim otherwise.
                      image "symbol:circle" font-size="0.45rem" color=(s.attention != "" ? "-exact-system-orange" : (s.running ? "brand.fill" : (s.unread == "failed" ? "-exact-system-red" : (s.unread == "done" ? "brand.fill" : "-exact-tertiary-label")))) animation=(s.running and s.attention == "" and not still ? "pulse 1.2s ease-in-out infinite" : "none") testId=`run-${s.id}`
                      column flex=1 min-width=0 gap=2
                        row gap=5 align-items="center"
                          if s.pinned
                            image "symbol:pin" font-size="0.55rem" color="brand.fill"
                          text (s.title == "" ? t("list.untitled") : s.title) font="-exact-body" color=(s.archived ? "-exact-tertiary-label" : "text.ink") testId=`session-${s.id}`
                        // The status line: what waits on the person, else running / running subagents / the folder; an unread completion leads it.
                        row gap=6 align-items="baseline" flex-wrap="wrap"
                          if s.unread != ""
                            text (s.unread == "failed" ? t("status.failed") : t("status.unread")) font="-exact-footnote" font-weight=600 color=(s.unread == "failed" ? "-exact-system-red" : "brand.fill") testId=`unread-${s.id}`
                          text (s.attention != "" ? attnLabel(s.attention) : (s.running ? t("list.running") : (s.subs > 0 ? (s.subs == 1 ? t("list.subRunning.one", n=s.subs) : t("list.subRunning", n=s.subs)) : s.cwd))) font="-exact-footnote" font-weight=(s.attention != "" ? 600 : 400) color=(s.attention != "" ? "-exact-system-orange" : (s.running or s.subs > 0 ? "brand.fill" : "-exact-secondary-label")) testId=`attention-${s.id}`
                      if s.when != ""
                        text s.when font="-exact-footnote" color="-exact-tertiary-label"
                      image "symbol:forward-chevron" color="-exact-tertiary-label"
                if shown.length == 0
                  text (query.trim() == "" ? t("list.empty") : t("list.noMatch")) font="-exact-footnote" color="-exact-secondary-label" padding=24 text-align="center" testId="no-matches"
        if e.name == "chat"
          column navigationKey=`${e.id}` navigationScroll="transcript" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" padding="8px 16px" gap=4 background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text (snap.sessionTitle == "" ? t("chat.title") : snap.sessionTitle) font-size="1.06rem" font-weight=600 line-clamp=1 overflow-wrap="break-word" flex=1 min-width=0 testId="chat-title"
              button press=openMore aria-label="Session menu" testId="chat-menu"
                image "symbol:ellipsis"
              if snap.running
                button press=stop aria-label="Stop" testId="stop"
                  image "symbol:stop-fill"
            // A subagent child's place in its tree (SubagentHeaderLineage): its parent (tap to go there) and what the parent calls it.
            if snap.origin == "subagent"
              row press=openChild(snap.parentId) gap=6 align-items="center" padding="0 16px 6px 16px" background-color="surface.page" testId="breadcrumb"
                image "symbol:people" font-size="0.6rem" color="brand.fill"
                text (snap.parentTitle != "" ? snap.parentTitle : t("subagent.parent")) font-size="0.69rem" color="brand.fill" line-clamp=1 testId="breadcrumb-parent"
                image "symbol:forward-chevron" font-size="0.5rem" color="-exact-tertiary-label"
                text (snap.agentLabel != "" ? snap.agentLabel : snap.sessionTitle) font-size="0.69rem" color="-exact-secondary-label" line-clamp=1 flex=1 min-width=0 testId="breadcrumb-agent"
            if (nearTop and (historyState == "ready" or olderLoaded)) or historyState == "loading" or historyState == "error"
              row justify-content="center" align-items="center" height=36 background-color="surface.page"
                if historyState == "loading"
                  text t("list.loading") font-size="0.8rem" color="-exact-secondary-label" testId="more-loading"
                else
                  if historyState == "error"
                    button press=loadEarlier buttonStyle="bordered" testId="more-retry"
                      text t("list.loadFailed")
                  else
                    if historyState == "ready"
                      button press=loadEarlier buttonStyle="bordered" testId="load-earlier"
                        text t("list.loadEarlier")
                    else
                      text t("list.beginning") font-size="0.8rem" color="-exact-secondary-label" testId="more-beginning"
            list id="transcript" testId="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=(stick) scroll=moved scrollend=settleVisibleTurn flex=1 min-height=0
              for m in thread key=m.id
                column padding="4px 0" testId=`row-${m.id}`
                  // use-calendar-day parity: a labeled rule wherever the local
                  // calendar day changes between chronological rows.
                  if m.day != ""
                    row gap=8 align-items="center" padding="8px 12px 2px 12px" testId=`day-${m.seq}`
                      hr flex=1
                      text m.day font-size="0.69rem" color="-exact-tertiary-label"
                      hr flex=1
                  if m.role == "seed"
                    row gap=8 align-items="center" padding="6px 12px" testId="seed-row"
                      hr flex=1
                      text t("seed.inherited") font-size="0.69rem" color="-exact-tertiary-label"
                      hr flex=1
                  // Note rows: the bridge words the header (title, summary, icon, state); the body is m.text.
                  if m.role == "compact" or m.role == "command"
                    NoteRow(icon=m.icon, title=m.title, summary=m.summary, body=m.text, open=(openRow == m.id or pMode == "verbose"), toggle=toggleRow(m.id), tint=(m.state == "error" ? "error" : ""), tid=`${m.role}-${m.seq}`)
                  if m.role == "trigger"
                    NoteRow(icon=m.icon, title=m.title, summary="", body=m.text, open=(openRow == m.id or pMode == "verbose"), toggle=toggleRow(m.id), tint="", tid=`trigger-${m.seq}`)
                  if m.role == "context"
                    NoteRow(icon=m.icon, title=m.title, summary=m.summary, body=m.text, open=(openRow == m.id or pMode == "verbose"), toggle=toggleRow(m.id), tint="", tid=`context-${m.seq}`)
                  if m.role == "retry"
                    NoteRow(icon=m.icon, title=m.title, summary="", body=m.text, open=(openRow == m.id), toggle=toggleRow(m.id), tint=(m.state == "active" ? "warn" : ""), tid=`retry-${m.seq}`)
                  if m.role == "error"
                    row gap=8 align-items="flex-start" padding="4px 12px" testId=`err-${m.seq}`
                      image "symbol:alert" font-size="0.7rem" color=(m.state == "error" ? "-exact-system-red" : (m.state == "warning" ? "-exact-system-orange" : "-exact-secondary-label"))
                      column flex=1 min-width=0 gap=1
                        text m.title font-size="0.75rem" font-weight=600 color=(m.state == "error" ? "-exact-system-red" : "-exact-label") white-space="pre-wrap" overflow-wrap="break-word" testId=`err-title-${m.seq}`
                        text m.text font-size="0.72rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word" testId=`err-text-${m.seq}`
                      if m.summary != ""
                        text m.summary font-size="0.62rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label"
                  if m.role == "sysprompt"
                    column gap=3 padding="2px 12px" press=toggleProcess(m.id) testId=`sysprompt-${m.seq}`
                      row gap=6 align-items="center"
                        image "symbol:document" font-size="0.6rem" color="-exact-tertiary-label"
                        text t("chat.sysPrompt") font-size="0.69rem" color="-exact-tertiary-label"
                        text ((openProcess == m.id or pMode == "verbose") ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"
                      if openProcess == m.id or pMode == "verbose"
                        text m.text font-size="0.72rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
                      else
                        text (m.plain != "" ? m.plain : m.text) font-size="0.69rem" color="-exact-tertiary-label" line-clamp=1
                  if m.role == "qreply"
                    column gap=4 padding="2px 12px" testId=`qreply-${m.seq}`
                      for b in m.blocks key=b.id
                        match b.ask
                          case some(ak)
                            AskBody(ask=ak, reply=true, canReveal=false, reveal=revealQ(b.callId))
                          case none
                            text ""
                  if m.role == "goal"
                    column gap=2
                      if m.text != ""
                        text t("goal.label") font-size="0.69rem" color="-exact-tertiary-label"
                        text m.text font-size="0.75rem" color="-exact-secondary-label" line-clamp=3 testId="goal-line"
                      for b in m.blocks key=b.id
                        row gap=6 align-items="flex-start"
                          text (b.status == "completed" ? "●" : b.status == "in_progress" ? "◐" : "○") font-size="0.69rem" color=(b.status == "completed" ? "-exact-system-green" : b.status == "in_progress" ? "-exact-system-orange" : "-exact-tertiary-label")
                          text b.text font-size="0.75rem" color=(b.status == "completed" ? "-exact-tertiary-label" : "-exact-label") flex=1 min-width=0
                  if m.role == "user"
                    column gap=4 align-items="flex-end"
                      // Pictures sent with the message (attachment refs the Mac serves like the assistant's): thumbnails over the bubble.
                      if m.blocks.filter(x => x.kind == "image").length > 0
                        row gap=6 flex-wrap="wrap" justify-content="flex-end" testId=`images-${m.seq}`
                          for b in m.blocks key=b.id
                            if b.kind == "image" and b.att != ""
                              image `${server}/v1/attachments/${b.att}?t=${token}` width=120 height=thumbH(b.w, b.h) object-fit="cover" border-radius=10 press=openImage(`${server}/v1/attachments/${b.att}?t=${token}`) aria-label=t("file.image") testId=`uimg-${m.seq}-${b.id}`
                      if m.text != ""
                        text m.text padding="8px 12px" border-radius=18 max-width="78%" white-space="pre-wrap" overflow-wrap="break-word" background-color="brand.fill" color="ink.on-brand"
                      if m.refs.length > 0
                        row gap=6 flex-wrap="wrap" justify-content="flex-end" testId=`refs-${m.seq}`
                          for r in m.refs key=r.id
                            row gap=4 align-items="center" padding="3px 8px" border-radius=8 background-color="surface.card"
                              image (r.text == "skill" ? "symbol:sparkles" : (r.text == "session" ? "symbol:messages" : "symbol:document")) font-size="0.5rem" color="-exact-tertiary-label"
                              text r.path font-size="0.62rem" color="-exact-secondary-label" line-clamp=1
                  else
                    if m.role == "assistant"
                      column gap=6 padding="2px 12px"
                        // The turn control (TurnProcessNodeView): how the closed turn went and what it did; it folds the process.
                        if m.title != ""
                          TurnControl(title=m.title, summary=m.summary, tone=m.state, open=not m.fold, can=canFold(m, foldOn, keepAll), toggle=toggleTurn(m.turn, m.fold, canFold(m, foldOn, keepAll)), tid=`turn-ctl-${m.seq}`)
                        // Older turns arrive as text only (the window keeps their nodes out for size),
                        // so show that text rather than leaving the turn looking unanswered.
                        if m.plain != "" and m.blocks.filter(b => b.kind == "text" or (b.kind == "md" and b.nodes.length > 0)).length == 0
                          text m.plain white-space="pre-wrap" overflow-wrap="break-word" testId=`msg-${m.seq}`
                        for b in m.blocks key=b.id
                          // A process group's header (ChatGroupSeat) where steps are grouped; the live group says what it is doing now.
                          if b.kind == "group" and shown(m, b, keepAll, openGroups)
                            GroupHeader(icon=(b.id == m.liveGroup ? "symbol:sparkles" : b.icon), title=(b.id == m.liveGroup ? liveTitle(b, snap.runActivity, liveDetail) : b.text), open=openGroups.includes(b.id), live=(b.id == m.liveGroup), toggle=toggleGroup(b.id), tid=`group-${m.seq}-${b.id}`)
                          if b.kind == "md" and shown(m, b, keepAll, openGroups)
                            MdBody(nodes=b.nodes, mid=`${m.id}.${b.id}`, tid=`msg-${m.seq}`, server=server, token=token, sid=selected, copied=copied, copy=copyCode, pic=openImage)
                          // ReasoningRow parity: a 思考 disclosure with a one-line preview (the latest paragraph while it streams).
                          if b.kind == "reasoning" and shown(m, b, keepAll, openGroups)
                            ThinkRow(body=b.text, summary=b.summary, running=b.status == "running", preview=thinkPreview, open=openRow == `${m.id}.${b.id}`, toggle=toggleRow(`${m.id}.${b.id}`), tid=`think-${m.seq}-${b.id}`)
                          if b.kind == "tool" and b.child != "" and shown(m, b, keepAll, openGroups)
                            row press=openChild(b.child) gap=6 align-items="center" padding="4px 0" testId=`child-${b.id}`
                              image "symbol:people" font-size="0.6rem" color="brand.fill"
                              text t("chat.openSubagent") font-size="0.69rem" color="brand.fill"
                          if b.kind == "tool" and shown(m, b, keepAll, openGroups)
                            column gap=4 background-color="surface.card" border-radius=10 padding="8px 10px"
                              row gap=6 align-items="center" press=toggleCall(b.callId, m.seq) testId=`call-${b.callId}`
                                image b.icon color="-exact-secondary-label"
                                // The localized title (ui-tool's row title), the wire name beside it as small mono text, then the one-line summary.
                                text (b.title != "" ? b.title : b.text) font-size="0.81rem" font-weight=600 testId=`call-title-${b.callId}`
                                if b.title != "" and b.title != b.text
                                  text b.text font-size="0.62rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label"
                                text b.summary font-size="0.69rem" color=(b.status == "error" and b.badge == "" ? delC() : "-exact-tertiary-label") line-clamp=1 flex=1 min-width=0 testId=`call-summary-${b.callId}`
                                if b.suffix != ""
                                  text b.suffix font-size="0.62rem" color="-exact-tertiary-label"
                                if b.added + b.removed > 0
                                  text `+${b.added}` font-size="0.62rem" color=addC()
                                  text `−${b.removed}` font-size="0.62rem" color=delC()
                                if b.status == "ok"
                                  image "symbol:checkmark" color="-exact-system-green"
                                if b.status == "error"
                                  text b.badge font-size="0.62rem" color=delC() testId=`call-badge-${b.callId}`
                                  image "symbol:alert" color="-exact-system-red"
                                if b.status == "unknown"
                                  image "symbol:alert" color="-exact-system-orange"
                                if b.status == "stopped"
                                  image "symbol:stop-fill" color="-exact-secondary-label"
                                if b.status == "running" or b.status == "preparing"
                                  if b.status == "preparing"
                                    text t("tool.preparing") font-size="0.62rem" color="-exact-system-orange"
                                  image "symbol:circle" color="-exact-system-orange"
                                text (b.callId == openCall ? "−" : "+") font-size="0.75rem" color="-exact-tertiary-label"
                              // A to-do write: its comparison with the previous list (首次记录 / 与上次清单相比 / 旧清单不可用), what changed, and the items;
                              // the ones this write left alone sit behind "N 项未变化".
                              if b.todos.length > 0
                                column gap=3
                                  if b.detail != ""
                                    text b.detail font-size="0.62rem" color="-exact-tertiary-label" testId=`todocap-${b.callId}`
                                  if b.todoSummary != ""
                                    text b.todoSummary font-size="0.69rem" color="-exact-tertiary-label" testId=`todosum-${b.callId}`
                                  for t in b.todos.filter(x => x.change != "same" or openRow == `${m.id}.${b.id}.same`) key=t.id
                                    row gap=6 align-items="flex-start"
                                      // todo-diff-model parity: ＋ added, － removed, orange marker for status / position updates.
                                      text (t.change == "added" ? "＋" : t.change == "removed" ? "－" : t.state == "completed" ? "●" : t.state == "in_progress" ? "◐" : "○") font-size="0.75rem" color=(t.change == "added" ? addC() : t.change == "removed" ? delC() : t.change == "updated" ? warnC() : t.state == "completed" ? addC() : t.state == "in_progress" ? warnC() : "-exact-tertiary-label")
                                      column flex=1 min-width=0 gap=1
                                        text t.text font-size="0.81rem" opacity=(t.change == "removed" ? 0.55 : 1) color=(t.state == "completed" ? "-exact-tertiary-label" : "-exact-label") white-space="pre-wrap"
                                        if t.label != ""
                                          text (t.prev != "" ? `${t.label} · ${t.prev}` : t.label) font-size="0.62rem" color="-exact-tertiary-label"
                                  if b.todos.filter(x => x.change == "same").length > 0
                                    row press=toggleRow(`${m.id}.${b.id}.same`) gap=4 align-items="center" testId=`todosame-${b.callId}`
                                      text t("todo.unchanged", n=b.todos.filter(x => x.change == "same").length) font-size="0.69rem" color="-exact-secondary-label"
                                      text (openRow == `${m.id}.${b.id}.same` ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"
                              if b.files.length > 0
                                column gap=4 background-color="surface.card" border-radius=10 padding="8px 10px"
                                  text t("chat.deliverables") font-size="0.69rem" color="-exact-tertiary-label"
                                  for f in b.files key=f.id
                                    column gap=2
                                      text f.path font-size="0.75rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="text.ink" line-clamp=2 testId=`file-${f.id}`
                                      if f.text != ""
                                        text f.text font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
                              match b.ask
                                case some(ak)
                                  AskBody(ask=ak, reply=false, canReveal=(ak.answerable and qCall != b.callId), reveal=revealQ(b.callId))
                                case none
                                  text ""
                              if b.question != "" and b.ask == none
                                column gap=4
                                  text b.question font-size="0.81rem" font-weight=600 white-space="pre-wrap"
                                  for o in b.options key=o.id
                                    text o.text font-size="0.75rem" color="-exact-secondary-label"
                              if b.callId == openCall and b.images.length > 0
                                for im in b.images key=im.id
                                  image `${server}/v1/attachments/${im.att}?t=${token}` width=220 height=(im.w > 0 and im.h > 0 ? 220 * im.h / im.w : 160) border-radius=8 press=openImage(`${server}/v1/attachments/${im.att}?t=${token}`) testId=`timg-${im.id}`
                              // The card (terminal / read / search / web / diff / details / input-output) comes with the call detail.
                              if b.callId == openCall and b.todos.length == 0 and b.question == ""
                                if dCallId == b.callId
                                  ToolCard(v=b.view, ck=b.callId, open=openParts, toggle=togglePart, openPath=openFile)
                                if b.lazy and dCallId != b.callId
                                  text t("common.loadingMore") font-size="0.69rem" color="-exact-tertiary-label"
                          if b.kind == "image" and b.att != "" and shown(m, b, keepAll, openGroups)
                            column gap=4
                              image `${server}/v1/attachments/${b.att}?t=${token}` width=240 height=(b.w > 0 and b.h > 0 ? 240 * b.h / b.w : 180) border-radius=10 press=openImage(`${server}/v1/attachments/${b.att}?t=${token}`) testId=`img-${b.id}`
                              if b.text != ""
                                text b.text font-size="0.69rem" color="-exact-tertiary-label" line-clamp=1
                          if b.kind == "unsupported" and shown(m, b, keepAll, openGroups)
                            row gap=6 align-items="center" padding="6px 0"
                              text b.text font-size="0.81rem" color="-exact-secondary-label"
                              text t("chat.unsupported") font-size="0.69rem" color="-exact-tertiary-label"
                          // A message the person sent into this running turn (steering): inside the turn, a compact bubble marked 插话.
                          if b.kind == "steer"
                            column gap=3 align-items="flex-end" testId=`steer-${m.seq}-${b.id}`
                              text b.summary font-size="0.62rem" color="-exact-tertiary-label"
                              if b.images.length > 0
                                row gap=6 flex-wrap="wrap" justify-content="flex-end"
                                  for im in b.images key=im.id
                                    image `${server}/v1/attachments/${im.att}?t=${token}` width=120 height=thumbH(im.w, im.h) object-fit="cover" border-radius=8 press=openImage(`${server}/v1/attachments/${im.att}?t=${token}`) aria-label=t("file.image") testId=`simg-${m.seq}-${im.id}`
                              if b.text != ""
                                text b.text padding="5px 10px" border-radius=14 max-width="78%" font-size="0.88rem" white-space="pre-wrap" overflow-wrap="break-word" background-color="surface.card-strong" testId=`steer-text-${m.seq}`
                          // A context the host injected between this turn's steps: the same note row as outside a turn.
                          if b.kind == "ctx" and shown(m, b, keepAll, openGroups)
                            NoteRow(icon=b.icon, title=b.text, summary=b.summary, body=(b.status == "static" ? "" : b.detail), open=(openRow == `${m.id}.${b.id}` or pMode == "verbose"), toggle=toggleRow(`${m.id}.${b.id}`), tint="", tid=`ctx-${m.seq}-${b.id}`)
                        // Turn-tail deliverables (ui-deliverables): the files the turn changed (a card that opens each file's comparison, folded past four)
                        // and the files it presented (cards that open the viewer, with the Mac's own open / show-in-Finder).
                        if m.deliverables.length > 0 or m.changedCount > 0
                          column gap=6 margin-top=4 testId=`deliverables-${m.seq}`
                            if m.changedCount > 0
                              ChangedFilesCard(files=m.changedFiles, total=m.changedCount, added=m.changedAdded, removed=m.changedRemoved, turn=m.turn, seq=m.changesSeq, open=openRow == `${m.id}.files`, toggle=toggleRow(`${m.id}.files`), show=openDiff, tid=`changed-${m.seq}`)
                            for f in m.deliverables key=f.id
                              PresentedFileCard(f=f, canOpen=snap.bridgeOpen, show=openFile(f.path), open=macOpen(f.path, "open"), reveal=macOpen(f.path, "reveal"), tid=`dl-open-${f.id}`)
                        // Only a settled turn has tail actions: not the streaming row, nor the
                        // assistant row of the turn still running.
                        if m.text != "" and not liveRows.includes(m.id)
                          row justify-content="flex-end" gap=8 flex-wrap="wrap"
                            row press=copyBody(m.text) padding="6px 8px" border-radius=8 testId=`copy-${m.seq}`
                              text t("common.copy") font-size="0.69rem" color="-exact-tertiary-label"
                            if not readOnly
                              row press=quoteBody(m.text) padding="6px 8px" border-radius=8 testId=`quote-${m.seq}`
                                text t("chat.quote") font-size="0.69rem" color="-exact-tertiary-label"
                            // Message feedback (ui-message-feedback): either thumb opens the feedback dialog; a recorded one is filled and retracts on a tap.
                            if m.msgId != ""
                              row press=rateMsg(m.msgId, "positive") padding="6px 8px" border-radius=8 aria-label=(fbRatingOf(feedback.items, m.msgId) == "positive" ? t("feedback.unmark") : t("feedback.like")) testId=`up-${m.seq}`
                                text "👍" font-size="0.81rem" opacity=(fbRatingOf(feedback.items, m.msgId) == "positive" ? 1 : 0.45)
                              row press=rateMsg(m.msgId, "negative") padding="6px 8px" border-radius=8 aria-label=(fbRatingOf(feedback.items, m.msgId) == "negative" ? t("feedback.unmark") : t("feedback.dislike")) testId=`down-${m.seq}`
                                text "👎" font-size="0.81rem" opacity=(fbRatingOf(feedback.items, m.msgId) == "negative" ? 1 : 0.45)
                            if m.seq > 0
                              row press=forkHere(m.seq) padding="6px 8px" border-radius=8 testId=`forkhere-${m.seq}`
                                text t("chat.fork") font-size="0.69rem" color="-exact-tertiary-label"
                        // TurnUsagePanel parity: the `用量 X` line; with the Mac set to detailed usage it opens the panel (provider / model, the
                        // cache buckets, output and its reasoning, speed).
                        if m.usage != ""
                          column gap=3 testId=`usage-${m.seq}`
                            row press=toggleRow(`${m.id}.usage`) gap=4 align-items="center" padding="2px 0" testId=`usage-line-${m.seq}`
                              text m.usage font-size="0.69rem" color="-exact-tertiary-label" testId=`usage-text-${m.seq}`
                              if detailedUsage
                                text (openRow == `${m.id}.usage` ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"
                            if detailedUsage and openRow == `${m.id}.usage`
                              column gap=3 padding="8px 10px" background-color="surface.card" border-radius=8 testId=`usage-panel-${m.seq}`
                                for u in m.usageRows key=u.id
                                  row gap=8 align-items="flex-start"
                                    text u.label font-size="0.69rem" color="-exact-tertiary-label" flex=1 min-width=0
                                    text u.value font-size="0.69rem" color="-exact-secondary-label" text-align="right"
                        if m.interrupted
                          text t("chat.interrupted") font-size="0.69rem" color="-exact-secondary-label" testId=`stopped-${m.seq}`
                    else
                      if m.role == "result"
                        text m.text font="-exact-caption1" color="-exact-secondary-label" padding="2px 16px" white-space="pre-wrap" line-clamp=6
            if echoText != "" and lastUserText != echoText
              row justify-content="flex-end" padding="4px 0" testId="echo-row"
                column gap=2 align-items="flex-end" max-width="78%"
                  text echoText padding="8px 12px" border-radius=18 white-space="pre-wrap" overflow-wrap="break-word" background-color="brand.fill" color="ink.on-brand" opacity=0.55
                  text t("chat.sending") font-size="0.62rem" color="-exact-tertiary-label"
            // DSH's RunningStatus slot: after the turn's content, the whale tail
            // and `深度求索中，用时 …` — always present while the session runs,
            // whether text is streaming, tools run, or the turn predates a reload.
            if snap.running
              row gap=6 align-items="center" padding="6px 12px" testId="running-status"
                image "assets/whale.svg" width=14 height=14 color="brand.fill"
                text (snap.runLabel != "" ? snap.runLabel : t("chat.deepDiving")) font-size="0.75rem" color="brand.fill"
              // The live title of the open group sits in its header; only a retry waiting out its delay has no group to say it.
              match snap.runActivity
                case some(act)
                  if act.kind == "retry"
                    text act.label font-size="0.72rem" color="-exact-secondary-label" padding="0 12px 6px 32px" line-clamp=2 testId="running-activity"
                case none
                  text ""
            if msgs.length == 0 and snap.streamBlocks.length == 0
              text t("chat.hint") font="-exact-footnote" color="-exact-secondary-label" padding="4px 16px"
            if snap.quota != "" and quotaSeen != snap.quotaId
              column padding="0 12px 6px 12px"
                row press=dismissQuota gap=8 align-items="center" padding="8px 10px" background-color="surface.card-strong" border-radius=12 testId="quota-toast"
                  image "symbol:alert" font-size="0.7rem" color="-exact-system-red"
                  text snap.quota flex=1 min-width=0 font-size="0.72rem" color="-exact-system-red" line-clamp=3
            // The goal strip (ui-goal GoalBar): phase, objective, rounds and blocker; edit, clear, pause / resume.
            if goalShown
              GoalBar(objective=snap.goal, phase=snap.goalPhase, activation=snap.goalActivation, rounds=snap.goalRounds, cap=snap.goalMax, reason=snap.goalReason, busy=pending(goalSet), error=goalErr, edit=goalEdit, act=goalAction)
            if snap.queue.length > 0
              column gap=4 padding="8px 12px" background-color="surface.card" border-radius=12
                text t("queue.queued", n=snap.queue.length) font-size="0.69rem" color="-exact-tertiary-label"
                for qd in snap.queue key=qd.id
                  if queueEdit == qd.id
                    column gap=6
                      input value=queueDraft input=queueInput placeholder=t("queue.editPlaceholder") aria-label="Edit queued message" testId=`queue-input-${qd.id}` flex=1 min-width=0 min-height=44 background-color="surface.card-strong" border-radius=10 padding="10px 12px"
                      row gap=10
                        row press=saveQueue(qd.id) padding="8px 12px" border-radius=10 background-color="brand.fill" testId=`queue-save-${qd.id}`
                          text t("common.save") font-size="0.75rem" color="ink.on-brand"
                        row press=steerQueue(qd.id, queueDraft) padding="8px 12px" border-radius=10 background-color="surface.card-strong" testId=`queue-steer-${qd.id}`
                          text t("queue.steer") font-size="0.75rem" color="text.ink"
                        row press=cancelQueueEdit padding="8px 12px" testId=`queue-cancel-${qd.id}`
                          text t("common.cancel") font-size="0.75rem" color="-exact-secondary-label"
                  else
                    column gap=3
                      row gap=8 align-items="center"
                        column press=editQueue(qd.id, qd.text, qd.editable) flex=1 min-width=0 padding="2px 0" gap=4 testId=`queue-edit-${qd.id}`
                          if qd.images.length > 0 or qd.files.length > 0
                            row gap=4 flex-wrap="wrap" align-items="center"
                              for im in qd.images key=im.id
                                image `${server}/v1/attachments/${im.att}?t=${token}` width=28 height=28 object-fit="cover" border-radius=6 aria-label=t("file.image") testId=`queue-img-${qd.id}-${im.id}`
                              for f in qd.files key=f.id
                                row gap=3 align-items="center" padding="2px 6px" background-color="surface.card-strong" border-radius=6 testId=`queue-file-${qd.id}-${f.id}`
                                  image "symbol:document" font-size="0.55rem" color="-exact-tertiary-label"
                                  text f.path font-size="0.62rem" color="-exact-secondary-label" line-clamp=1 max-width="7rem"
                          if qd.text != ""
                            text qd.text font-size="0.75rem" line-clamp=2
                        row press=steerQueue(qd.id, qd.text) padding="6px" opacity=(snap.running ? 1 : 0.35) aria-label=(snap.running ? t("queue.steer") : t("queue.steerUnavailable")) testId=`queue-now-${qd.id}`
                          image "symbol:refresh" font-size="0.8rem" color="brand.fill"
                        row press=dropQueued(qd.id) padding="6px" testId=`queue-drop-${qd.id}`
                          image "symbol:close" font-size="0.6rem" color="-exact-tertiary-label"
                      if not qd.editable
                        text t("queue.editUnsupported") font-size="0.62rem" color="-exact-tertiary-label" testId=`queue-uneditable-${qd.id}`
            if todoTotal > 0
              column gap=3 padding="8px 12px" background-color="surface.card" border-radius=12
                row press=toggleTodos gap=8 align-items="center" testId="todo-toggle"
                  text t("todo.progress", done=todoDone, total=todoTotal) font-size="0.69rem" color="-exact-tertiary-label" flex=1
                  image "symbol:list" font-size="0.6rem" color="-exact-tertiary-label"
                if showTodos
                  for td in snap.todos key=td.id
                    row gap=6 align-items="flex-start"
                      text (td.state == "completed" ? "●" : td.state == "in_progress" ? "◐" : "○") font-size="0.69rem" color=(td.state == "completed" ? "brand.fill" : "-exact-tertiary-label")
                      text td.text flex=1 min-width=0 font-size="0.75rem" line-clamp=2
            if draft.startsWith("/") and not readOnly
              column gap=2 padding="0 12px 6px 12px" testId="slash-menu"
                for c, i in slashMatches key=`${c.kind}:${c.name}`
                  if i == 0 or c.section != (match slashMatches.at(i - 1) { case some(p) => p.section, case none => "" })
                    text secTitle(c.section) font-size="0.62rem" font-weight=600 color="-exact-tertiary-label" padding="6px 4px 0 4px" testId=`cmd-section-${c.section}`
                  row press=runCommand(c.name, c.hint, c.kind) gap=8 align-items="center" padding="8px 10px" background-color="surface.card" border-radius=10 testId=`cmd-${c.name}`
                    column flex=1 min-width=0 gap=1
                      row gap=6 align-items="baseline" flex-wrap="wrap"
                        if c.label != ""
                          text c.label font-size="0.81rem" font-weight=600
                        text ("/" + c.name) font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.69rem" color="-exact-secondary-label"
                      if c.description != ""
                        text c.description font-size="0.69rem" color="-exact-tertiary-label" line-clamp=2
                if slashMatches.length == 0 and not slashKnown
                  text t("cmd.none") font-size="0.69rem" color="-exact-tertiary-label"
                if slashHint != ""
                  text slashHint font-size="0.72rem" color="-exact-tertiary-label" padding="4px 4px" testId="slash-hint"
            // The @ menu: files and folders (a folder drills, a header goes up a level or takes the folder itself), this session's subagents, other sessions.
            if atActive and not takeover
              column gap=2 padding="0 12px 6px 12px" testId="ref-menu"
                if atDir != ""
                  row gap=8 align-items="center" padding="6px 10px" background-color="surface.card" border-radius=10 testId="ref-crumb"
                    row press=refUp gap=4 align-items="center" testId="ref-up"
                      image "symbol:back" font-size="0.7rem" color="-exact-secondary-label"
                      text t("ref.up") font-size="0.75rem" color="-exact-secondary-label"
                    text atDir font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label" flex=1 min-width=0 line-clamp=1
                    row press=pickDir(atQuoted ? `@"${atDir}"` : `@${atDir}`) padding="3px 8px" border-radius=8 background-color="surface.card-strong" testId="ref-take-dir"
                      text t("ref.takeDir") font-size="0.69rem"
                for r in refs.items key=r.id
                  if r.first
                    text r.section font-size="0.62rem" font-weight=600 color="-exact-tertiary-label" padding="6px 4px 0 4px" testId=`ref-section-${r.id}`
                  row press=pickRef(r.kind, r.text, r.wire) gap=8 align-items="center" padding="8px 10px" background-color="surface.card" border-radius=10 testId=`ref-${r.id}`
                    image (r.kind == "dir" ? "symbol:package" : (r.kind == "file" ? "symbol:document" : (r.kind == "subagent" ? "symbol:people" : "symbol:messages"))) font-size="0.7rem" color="-exact-tertiary-label"
                    column flex=1 min-width=0 gap=1
                      text r.name font-size="0.81rem" line-clamp=1
                      if r.detail != ""
                        text r.detail font-size="0.62rem" color="-exact-tertiary-label" line-clamp=1
                    if r.kind == "dir"
                      image "symbol:forward-chevron" font-size="0.55rem" color="-exact-tertiary-label"
                if refs.items.length == 0 and not pending(refs)
                  text t("ref.none") font-size="0.69rem" color="-exact-tertiary-label" padding="4px 4px" testId="ref-none"
            if receipt != ""
              row press=dismissReceipt gap=8 align-items="center" padding="6px 12px" testId="receipt"
                text receipt flex=1 min-width=0 font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
            if sendError != "" and not pending(sent)
              text sendError font="-exact-footnote" color="-exact-system-red" padding="0 16px"
            if railTurns.length > 0 or not stick
              // One row: the turn rail follows the transcript, and the always-present jump-to-end chip stays pinned at the right.
              row gap=6 padding="0 12px 6px 12px" align-items="center" justify-content=(railTurns.length > 1 ? "flex-start" : "flex-end") testId="jump-strip"
                if railTurns.length > 1
                  scroll id="turn-rail" height=44 flex=1 min-width=0 overflow-y="hidden" scrollbar-width="none" scroll=railMoved testId="turn-rail"
                    row gap=6 height=44 box-sizing="border-box" padding="6px 0" align-items="center"
                      for tn in railTurns key=`${tn}`
                        row id=`turn-${tn}` press=jumpTo(tn) justify-content="center" align-items="center" min-width=32 min-height=26 padding="3px 8px" background-color=(tn == curTurn ? "brand.fill" : "surface.card") border-radius=13 opacity=(openerOf(turnRows, tn) == "" ? 0.55 : 1) aria-label=(openerOf(turnRows, tn) == "" ? t("chat.jumpTurnLoad", n=tn) : t("chat.jumpTurn", n=tn)) testId=`turn-${tn}`
                          text `${tn}` font-size="0.72rem" color=(tn == curTurn ? "ink.on-brand" : "-exact-secondary-label") font-weight=(tn == curTurn ? 600 : 400)
                if railTurns.length > 0
                  row press=jumpLatest justify-content="center" align-items="center" min-width=36 min-height=26 background-color="surface.card" border-radius=13 testId="jump-latest" aria-label=t("chat.latest")
                    image "symbol:icon||0 0 24 24|M6 8.6L12 14.6 18 8.6 16.4 7 12 11.4 7.6 7Z M6 12.8L12 18.8 18 12.8 16.4 11.2 12 15.6 7.6 11.2Z|" width=16 height=16 object-fit="contain" color="-exact-secondary-label"
            column gap=6 padding="0 10px 8px 10px"
              if doneToast != ""
                row gap=8 align-items="center" padding="8px 12px" background-color="surface.card-strong" border-radius=12 margin="0 8px 4px" testId="done-toast"
                  image "symbol:checkmark" color="-exact-system-green" font-size="0.8rem"
                  text doneToast font-size="0.81rem" color="text.ink" flex=1
              // The feedback dialog (ui-message-feedback): seven categories and the details; the hint says the conversation log goes with it.
              if fbMsg != ""
                column gap=8 padding="10px 12px" background-color="surface.card-strong" border-radius=12 margin="0 8px 4px" testId="feedback-dialog"
                  row gap=8 align-items="center"
                    text t("feedback.title") font-size="0.88rem" font-weight=600 flex=1 min-width=0 role="heading" aria-level=2 testId="feedback-title"
                    row press=closeFb padding="4px 8px" aria-label=t("common.close") testId="feedback-close"
                      image "symbol:close" font-size="0.62rem" color="-exact-tertiary-label"
                  text t("feedback.categories") font-size="0.62rem" color="-exact-tertiary-label"
                  row gap=6 flex-wrap="wrap" role="group" aria-label=t("feedback.categories") testId="feedback-categories"
                    for c in feedbackCategories key=c
                      row press=pickCategory(c) padding="5px 10px" border-radius=12 background-color=(fbCategory == c ? "brand.fill" : "surface.card") aria-pressed=(fbCategory == c) testId=`fb-cat-${c}`
                        text catLabel(c) font-size="0.72rem" color=(fbCategory == c ? "ink.on-brand" : "text.ink")
                  textarea value=fbText input=editFbText field-sizing="content" max-height=120 border="none" background-color="surface.card" padding="8px 10px" border-radius=8 font-size="0.81rem" placeholder=t("feedback.hint") aria-label=t("feedback.detail") testId="feedback-text"
                  if fbError != ""
                    text fbError font-size="0.72rem" color="-exact-system-red" testId="feedback-error"
                  row gap=8 justify-content="flex-end"
                    row press=submitFb padding="8px 16px" background-color="brand.fill" border-radius=10 opacity=(pending(rated) ? 0.6 : 1) testId="feedback-submit"
                      text (pending(rated) ? t("feedback.submitting") : t("feedback.submit")) font-size="0.81rem" font-weight=600 color="ink.on-brand"
              // Composer takeover: a pending question / plan review or approval sits where the input row is,
              // as the desktop's composer chain does, until it is answered (by either side).
              for q in qList key=q.id
                if q.kind == "plan-review"
                  PlanCard(q=q, busy=(pending(qAnswered) or pending(qDismissed)), error=qErr, submit=answerQ(q.id), dismiss=dismissQ(q.id))
                else
                  QuestionCard(q=q, busy=(pending(qAnswered) or pending(qDismissed)), error=qErr, submit=answerQ(q.id), dismiss=dismissQ(q.id), hold=holdQ(q.id))
              if qList.length == 0
                for a in lastApproval key=a.id
                  ApprovalCard(a=a, busy=pending(answered), error=aErr, decide=decide(a.id))
              if readOnly and not takeover
                text t("chat.readOnly") font="-exact-footnote" color="-exact-secondary-label" text-align="center" padding="12px 16px" testId="readonly-note"
              if not readOnly and not takeover
                // The composer meter's panel: how full the context window is and what it is made of (system prompt, tool definitions, messages).
                if showCtx and ctxPct >= 0
                  column gap=6 padding="10px 12px" background-color="surface.card" border-radius=12 testId="ctx-panel"
                    row gap=6 align-items="baseline" flex-wrap="wrap"
                      text t("ctx.used", n=ctxPct) font-size="0.81rem" font-weight=600 testId="ctx-used"
                      text `~${fmtTok(ctx.used)} / ${fmtTok(ctx.total)}` font-size="0.69rem" color="-exact-tertiary-label" testId="ctx-figures"
                    row height=6 width="100%" border-radius=3 background-color="surface.card-strong" overflow="hidden"
                      if ctx.system + ctx.tools + ctx.messages > 0
                        column height=6 width=`${ctxPct * ctx.system / (ctx.system + ctx.tools + ctx.messages)}%` background-color="-exact-system-indigo"
                        column height=6 width=`${ctxPct * ctx.tools / (ctx.system + ctx.tools + ctx.messages)}%` background-color="-exact-system-orange"
                        column height=6 width=`${ctxPct * ctx.messages / (ctx.system + ctx.tools + ctx.messages)}%` background-color="-exact-system-teal"
                      else
                        column height=6 width=`${ctxPct}%` background-color="brand.fill"
                    if ctx.system + ctx.tools + ctx.messages > 0
                      row gap=8 align-items="center" testId="ctx-system"
                        column width=8 height=8 border-radius=4 background-color="-exact-system-indigo"
                        text t("ctx.system") font-size="0.72rem" color="-exact-secondary-label" flex=1 min-width=0
                        text `~${fmtTok(ctx.system)}` font-size="0.72rem" color="-exact-secondary-label"
                      row gap=8 align-items="center" testId="ctx-tools"
                        column width=8 height=8 border-radius=4 background-color="-exact-system-orange"
                        text t("ctx.tools") font-size="0.72rem" color="-exact-secondary-label" flex=1 min-width=0
                        text `~${fmtTok(ctx.tools)}` font-size="0.72rem" color="-exact-secondary-label"
                      row gap=8 align-items="center" testId="ctx-messages"
                        column width=8 height=8 border-radius=4 background-color="-exact-system-teal"
                        text t("ctx.messages") font-size="0.72rem" color="-exact-secondary-label" flex=1 min-width=0
                        text `~${fmtTok(ctx.messages)}` font-size="0.72rem" color="-exact-secondary-label"
                // Pictures and files waiting to go with the message, an upload in flight, and what a refusal said.
                if hasAtt or pending(uploaded) or attachErr != ""
                  column gap=4 padding="6px 8px" background-color="surface.card-strong" border-radius=12 testId="attach-chip"
                    for a in selAtts key=a.id
                      row gap=8 align-items="center" testId=`attach-${a.id}`
                        image (a.kind == "image" ? "symbol:photo" : "symbol:document") font-size="0.75rem" color="brand.fill"
                        text a.name font-size="0.75rem" color="-exact-secondary-label" flex=1 min-width=0 line-clamp=1
                        column padding="6px" align-items="center" justify-content="center" press=removeAtt(a.id) aria-label=(a.kind == "image" ? t("attach.removeImage", name=a.name) : t("attach.removeFile", name=a.name)) testId=`attach-clear-${a.id}`
                          image "symbol:close" font-size="0.62rem" color="-exact-tertiary-label"
                    if pending(uploaded)
                      text t("attach.uploadingN", n=upN) font-size="0.75rem" color="-exact-secondary-label" testId="attach-uploading"
                    if attachErr != ""
                      text attachErr font-size="0.75rem" color="-exact-system-red" white-space="pre-wrap" overflow-wrap="break-word" testId="attach-error"
                input type="file" accept="image/*" multiple id="photopick" change=pickedFiles width=1 height=1 opacity=0 aria-label=t("attach.photos") testId="photopick"
                input type="file" multiple id="filepick" change=pickedFiles width=1 height=1 opacity=0 aria-label=t("attach.files") testId="filepick"
                if attachMenu
                  row gap=8 padding="0 4px" testId="attach-menu"
                    row press=pickPhotos gap=6 align-items="center" padding="8px 14px" background-color="surface.card" border-radius=14 testId="attach-photo"
                      image "symbol:photo" font-size="0.8rem" color="brand.fill"
                      text t("attach.photos") font-size="0.81rem"
                    row press=pickFiles gap=6 align-items="center" padding="8px 14px" background-color="surface.card" border-radius=14 testId="attach-file"
                      image "symbol:document" font-size="0.8rem" color="brand.fill"
                      text t("attach.files") font-size="0.81rem"
                // 继续生成 (InputBar's primary button after a continuable failure): a prompt with no content, queued.
                if primaryMode == "continue"
                  row press=continueRun gap=6 align-items="center" justify-content="center" padding="10px 14px" background-color="brand.fill" border-radius=18 aria-label=t("input.continue") testId="continue"
                    image "symbol:refresh" font-size="0.8rem" color="ink.on-brand"
                    text t("input.continue") font-size="0.88rem" font-weight=600 color="ink.on-brand"
                row gap=8 align-items="flex-end" padding="8px 8px 8px 14px" background-color="surface.card" border-radius=24 border-color="surface.card" border-width=1 border-style="solid"
                  column min-width="2rem" min-height="2rem" align-items="center" justify-content="center" press=attachTap aria-label=t("attach.add") testId="attach"
                    image "symbol:photo" font-size="1rem" color=(pending(uploaded) ? "-exact-tertiary-label" : "-exact-secondary-label")
                  textarea value=draft input=editDraft field-sizing="content" max-height=140 border="none" background-color="surface.card" flex=1 min-width=0 placeholder=(planOn ? t("placeholder.plan") : t("composer.placeholder")) aria-label="Message" testId="draft"
                  // The primary button (InputBar): stop while a turn runs and nothing is typed, else send (steer / queue while a turn runs).
                  column min-width="2.25rem" min-height="2.25rem" align-items="center" justify-content="center" background-color=((primaryMode == "stop" or canSend) ? "brand.fill" : "surface.card-strong") border-radius="1.125rem" press=primary aria-label=primaryLabel(primaryMode, snap.running, steer, not composerEmpty) testId=(primaryMode == "stop" ? "composer-stop" : "send")
                    image (primaryMode == "stop" ? "symbol:stop-fill" : "symbol:send") color=((primaryMode == "stop" or canSend) ? "ink.on-brand" : "-exact-tertiary-label")
                if snap.sessionModel != "" or snap.planMode != "" or ctxPct >= 0 or snap.running
                  row gap=8 padding="0 8px" align-items="center" flex-wrap="wrap"
                    if snap.sessionModel != ""
                      row press=openModels gap=3 align-items="center" aria-label="Model" testId="composer-model"
                        text snap.sessionModel font-size="0.69rem" color="-exact-tertiary-label"
                        image "symbol:forward-chevron" font-size="0.5rem" color="-exact-tertiary-label"
                    // The plan chip (ui-plan): lit while plan mode is on, tap to leave it; dim where it is off, tap to enter it.
                    if snap.planMode != ""
                      row press=togglePlan gap=3 align-items="center" padding="2px 8px" border-radius=10 background-color=(planOn ? "brand.fill" : "surface.card") aria-label=(planOn ? t("plan.chip.on") : t("plan.chip.off")) testId="plan-chip"
                        image "symbol:list" font-size="0.55rem" color=(planOn ? "ink.on-brand" : "-exact-tertiary-label")
                        text t("plan.chip") font-size="0.69rem" color=(planOn ? "ink.on-brand" : "-exact-tertiary-label")
                    if ctxPct >= 0
                      row press=toggleCtx gap=3 align-items="center" padding="2px 6px" aria-label=t("ctx.used", n=ctxPct) testId="ctx-meter"
                        text `${ctxPct}%` font-size="0.69rem" color=(ctxPct > 85 ? "-exact-system-orange" : "-exact-tertiary-label")
                    if snap.running
                      text t("list.running") font-size="0.69rem" color="-exact-tertiary-label"
                      button press=pickMode(true) aria-label="Send into this turn" testId="mode-steer"
                        text t("chat.thisTurn") font-size="0.69rem" color=(steer ? "brand.fill" : "-exact-tertiary-label")
                      button press=pickMode(false) aria-label="Send as the next turn" testId="mode-queue"
                        text t("chat.nextTurn") font-size="0.69rem" color=(steer ? "-exact-tertiary-label" : "brand.fill")
        if e.name == "models"
          column navigationKey=`${e.id}` navigationScroll="model-list" navigationBar="none" navigationPresentation="modal" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              text t("models.title") role="heading" aria-level=1 flex=1
              button press=leave id="models-cancel" aria-label="Close" testId="models-cancel"
                image "symbol:close"
              text t("chat.nextTurn") font="-exact-footnote" color="-exact-secondary-label"
            row height="1px" width="100%"
            if effortModel == ""
              list id="model-list" appearance="none" flex=1 min-height=0
                for m in models.models key=m.id
                  row press=chooseModel(m.provider, m.id, m.efforts) gap=10 align-items="center" padding="12px 16px" testId=`model-${m.id}`
                    column flex=1 min-width=0 gap=2
                      text m.name
                      text m.provider font="-exact-footnote" color="-exact-secondary-label"
                    if m.current
                      image "symbol:checkmark" color="brand.fill"
            if effortModel != ""
              column gap=2 padding="4px 16px"
                row press=backToModels gap=6 align-items="center" testId="effort-back"
                  image "symbol:back" font-size="0.75rem" color="-exact-secondary-label"
                  text t("models.title") font-size="0.75rem" color="-exact-secondary-label"
                text effortModel font="-exact-footnote" color="-exact-secondary-label"
              list id="effort-list" appearance="none" flex=1 min-height=0
                for ef in effortOptions key=ef
                  row press=pickModel(effortProvider, effortModel, ef) gap=10 align-items="center" padding="12px 16px" testId=`effort-${ef}`
                    text ef flex=1 min-width=0
                    if ef == models.currentEffort
                      image "symbol:checkmark" color="brand.fill"

        if e.name == "find"
          column navigationKey=`${e.id}` navigationScroll="find-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("find.title") role="heading" aria-level=1 flex=1
            row padding="8px 16px"
              input value=findQ input=editFind placeholder=t("find.placeholder") aria-label=t("find.placeholder") testId="find-field" flex=1 min-width=0 min-height=44 background-color="surface.card" border-radius=10 padding="10px 12px"
            list id="find-list" appearance="none" flex=1 min-height=0
              for h in findRows key=h.id
                column gap=2
                  if h.role == "note"
                    text h.text font="-exact-footnote" color="-exact-tertiary-label" padding="0 16px 8px 16px" testId="find-note"
                  else
                    column gap=2 padding="10px 16px" background-color="surface.card"
                      text (h.role == "user" ? t("find.you") : "DeepSeek") font-size="0.69rem" color="-exact-tertiary-label"
                      text h.text font-size="0.81rem" line-clamp=4 white-space="pre-wrap"
        if e.name == "perm"
          column navigationKey=`${e.id}` navigationScroll="perm-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("perm.title") role="heading" aria-level=1 flex=1
            row height="1px" width="100%"
            list id="perm-list" appearance="none" virtualized=true flex=1 min-height=0
              for o in snap.permissionOptions key=o.value
                row press=choosePermission(o.value) testId=`perm-${o.value}` gap=10 align-items="center" padding="12px 16px"
                  column gap=2 flex=1
                    text o.name font-size="0.94rem"
                    if o.description != ""
                      text o.description font="-exact-footnote" color="-exact-secondary-label"
                  if o.value == snap.sessionPermission
                    image "symbol:checkmark" color="brand.fill"
        if e.name == "more"
          column navigationKey=`${e.id}` navigationScroll="more-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("chat.title") role="heading" aria-level=1 flex=1
            list id="more-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                column gap=4 padding="4px 0" testId="stats-block"
                  text t("stats.title") font-size="0.69rem" color="-exact-tertiary-label"
                  text t("stats.summary", turns=snap.stats.turns, steps=snap.stats.steps) font-size="0.81rem"
                  text t("stats.tokens", i=stIn, o=stOut, c=stCache) font-size="0.75rem" color="-exact-secondary-label"
                  if snap.stats.inTok + snap.stats.cacheRead > 0
                    text t("stats.hitRate", n=floor(100 * snap.stats.cacheRead / (snap.stats.inTok + snap.stats.cacheRead))) font-size="0.75rem" color="-exact-secondary-label"
                  // Deep stats (parity with stat-dialog): per-turn average load
                  // derived from the same counters.
                  if snap.stats.turns > 0
                    text t("stats.avgTurn", n=stAvg) font-size="0.75rem" color="-exact-secondary-label"
                  // The timing rows of the official stats dialog (whole-log figures from the Mac's sessionStats).
                  if snap.stats.llmMs > 0
                    row gap=8 testId="stat-llm"
                      text t("stats.llmTime") font-size="0.75rem" color="-exact-secondary-label" flex=1 min-width=0
                      text fmtMs(snap.stats.llmMs) font-size="0.75rem" color="-exact-secondary-label"
                  if snap.stats.toolMs > 0
                    row gap=8 testId="stat-tool"
                      text t("stats.toolTime") font-size="0.75rem" color="-exact-secondary-label" flex=1 min-width=0
                      text fmtMs(snap.stats.toolMs) font-size="0.75rem" color="-exact-secondary-label"
                  if snap.stats.ttftSteps > 0
                    row gap=8 testId="stat-ttft"
                      text t("stats.ttft") font-size="0.75rem" color="-exact-secondary-label" flex=1 min-width=0
                      text fmtMs(snap.stats.ttftMs / snap.stats.ttftSteps) font-size="0.75rem" color="-exact-secondary-label"
                  if snap.stats.decodeMs > 0
                    row gap=8 testId="stat-tps"
                      text t("stats.speed") font-size="0.75rem" color="-exact-secondary-label" flex=1 min-width=0
                      text t("stats.tps", tps=fmtTps(snap.stats.decodeTokens / (snap.stats.decodeMs / 1000))) font-size="0.75rem" color="-exact-secondary-label"
                  match snap.context
                    case some(ct)
                      if ct.total > 0
                        text t("stats.context", n=floor(100 * ct.used / ct.total)) font-size="0.75rem" color=(100 * ct.used / ct.total > 85 ? "-exact-system-orange" : "-exact-secondary-label") testId="context-meter"
                    case none
                      text ""
              // The session's environment: where it works, and (where the Mac has a desktop) open that folder there or show it in Finder.
              section
                text t("env.title") font="-exact-footnote" color="-exact-secondary-label"
                row gap=8 align-items="flex-start"
                  text t("env.cwd") font-size="0.75rem" color="-exact-secondary-label"
                  text (snap.sessionCwd == "" ? "—" : snap.sessionCwd) font-size="0.72rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" flex=1 min-width=0 text-align="end" overflow-wrap="break-word" testId="env-cwd"
                if snap.bridgeOpen and snap.sessionCwd != ""
                  button press=macOpen(".", "open") testId="env-open"
                    text t("mac.open")
                  button press=macOpen(".", "reveal") testId="env-reveal"
                    text t("mac.reveal")
                  if macErr != ""
                    text macErr font="-exact-footnote" color="-exact-system-red" testId="env-error"
              section
                row gap=8 align-items="center"
                  text t("rename.nameLabel") flex=1
                  input value=renameDraft input=editRename placeholder=t("rename.placeholder") aria-label=t("rename.placeholder") testId="rename-field"
              section
                button press=renameSession disabled=(renameDraft.trim() == "" or pending(renamed)) testId="rename-save"
                  text (pending(renamed) ? t("common.saving") : t("session.rename"))
              section
                button press=openPermissions testId="perm-open"
                  text t("perm.title")
              section
                button press=openFind testId="find-open"
                  text t("find.placeholder")
              section
                button press=setFlag("pin", not snap.pinned) disabled=pending(flagged) testId="pin-toggle"
                  text (snap.pinned ? t("session.unpin") : t("session.pin"))
              section
                button press=setFlag("archive", not snap.archived) disabled=pending(flagged) testId="archive-toggle"
                  text (snap.archived ? t("session.unarchive") : t("session.archive"))
              if snap.goalId != ""
                section
                  button press=goalAction(snap.goalPhase == "paused" ? "resume" : "pause") disabled=pending(goalSet) testId="goal-toggle"
                    text (snap.goalPhase == "paused" ? t("goal.resume") : t("goal.pause"))
                section
                  button press=goalAction("clear") disabled=pending(goalSet) testId="goal-clear"
                    text t("goal.clear")
              // The subagent tree (ui-subagent): each child's name, mode and what it is doing, with its tokens and active time; deeper ones sit indented.
              if snap.subagents.length > 0
                section
                  text t("subagent.title") font="-exact-footnote" color="-exact-secondary-label"
                  if snap.subagentProgress != ""
                    text snap.subagentProgress font-size="0.69rem" color="-exact-tertiary-label" testId="subagent-progress"
                  for a in snap.subagents key=a.id
                    row press=openChild(a.sessionId) gap=8 align-items="center" padding="6px 0" padding-left=(a.depth * 16) testId=`sub-${a.id}`
                      image "symbol:circle" font-size="0.45rem" color=(a.activity == "running" ? "brand.fill" : (a.activity == "completed" ? "-exact-system-green" : "-exact-tertiary-label")) animation=(a.activity == "running" and not still ? "pulse 1.2s ease-in-out infinite" : "none")
                      column flex=1 min-width=0 gap=1
                        text a.label font-size="0.81rem" color="text.ink" line-clamp=1 testId=`sub-label-${a.id}`
                        text `${a.sub != "" ? `${a.sub} · ` : ""}${a.mode}${a.state != "" ? ` · ${a.state}` : ""}` font-size="0.62rem" color="-exact-tertiary-label" line-clamp=1 testId=`sub-state-${a.id}`
                      if a.meta != ""
                        text a.meta font-size="0.62rem" color="-exact-tertiary-label" testId=`sub-meta-${a.id}`
                      if a.sessionId != ""
                        image "symbol:forward-chevron" font-size="0.5rem" color="-exact-tertiary-label"
              if snap.team.length > 0
                section
                  text t("team.title") font="-exact-footnote" color="-exact-secondary-label"
                  for tt in snap.team key=tt.id
                    row gap=8 padding="6px 0" align-items="center" testId=`team-${tt.id}`
                      image (tt.status == "completed" ? "symbol:checkmark" : tt.status == "in_progress" ? "symbol:refresh" : "symbol:circle") font-size="0.7rem" color=(tt.status == "completed" ? "-exact-system-green" : tt.status == "in_progress" ? "brand.fill" : "-exact-tertiary-label")
                      text (tt.owner != "" ? `${tt.subject} · ${tt.owner}` : tt.subject) flex=1 min-width=0 font-size="0.81rem" color="text.ink" line-clamp=1
                      text tt.status font-size="0.69rem" color="-exact-tertiary-label"
              section
                button press=openSchedules testId="schedules-open"
                  text t("sched.entry")
              section
                button press=openJobs testId="jobs-open"
                  text (snap.jobs.length > 0 ? t("jobs.titleN", n=snap.jobs.length) : t("jobs.title"))
              section
                button press=forkSession disabled=pending(forked) testId="fork"
                  text (pending(forked) ? t("chat.forking") : t("chat.forkHere"))
              section
                text t("chat.forkHint") font="-exact-footnote" color="-exact-secondary-label"
        if e.name == "jobs"
          column navigationKey=`${e.id}` navigationScroll="jobs-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("jobs.title") role="heading" aria-level=1 flex=1
            list id="jobs-list" appearance="none" flex=1 min-height=0
              if snap.jobs.length == 0
                text t("jobs.none") font="-exact-footnote" color="-exact-secondary-label" padding="16px"
              for j in snap.jobs key=j.id
                column gap=4 padding="12px 16px"
                  row gap=8 align-items="center"
                    row press=toggleJobOutput(j.id) gap=8 align-items="center" flex=1 min-width=0 testId=`job-open-${j.id}`
                      image "symbol:circle" font-size="0.45rem" color=(j.status == "running" or j.status == "stopping" ? "brand.fill" : "-exact-tertiary-label")
                      text j.label flex=1 min-width=0 font="-exact-body" line-clamp=2 testId=`job-${j.id}`
                      text (openJob == j.id ? t("common.collapse") : t("jobs.output")) font-size="0.69rem" color="-exact-tertiary-label"
                    if j.status == "running" or j.status == "stopping"
                      button press=killJob(j.id) aria-label="Stop job" testId=`kill-${j.id}`
                        image "symbol:stop-fill" color="-exact-system-red"
                  row gap=8
                    text t("jobs.line", id=j.id, status=j.state) font-size="0.69rem" color="-exact-tertiary-label"
                    if j.when != ""
                      text j.when font-size="0.69rem" color="-exact-tertiary-label"
                  if j.progress != ""
                    text j.progress font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
                  if j.detail != ""
                    text j.detail font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
                  // The job's output (ui-jobs' output panel): the tail of its retained ring, while it runs refreshed every few seconds.
                  if openJob == j.id
                    column gap=4 background-color="surface.card" border-radius=8 padding="8px 10px" testId=`job-output-${j.id}`
                      if jobOut.more
                        text t("jobs.gap") font-size="0.62rem" color="-exact-tertiary-label"
                      if jobOut.ok and jobOut.text != ""
                        scroll max-height=320
                          text jobOut.text font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" white-space="pre-wrap" overflow-wrap="break-word" testId=`job-text-${j.id}`
                      if jobOut.ok and jobOut.text == ""
                        text t("jobs.noOutput") font-size="0.69rem" color="-exact-tertiary-label"
                      if not jobOut.ok and not pending(jobOut)
                        text t("file.missing") font-size="0.69rem" color="-exact-tertiary-label"
                      if pending(jobOut) and jobOut.text == ""
                        text t("common.loadingMore") font-size="0.69rem" color="-exact-tertiary-label"
        if e.name == "viewer"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text (imgFull != "" ? t("file.image") : file.name) role="heading" aria-level=1 flex=1 min-width=0 line-clamp=1 testId="file-name"
            // A picture pinches to zoom (a scroll with -exact-max-zoom around the one image); Exact's image has no failure event, so a
            // blank one is retried by hand: 重新加载 asks for it again.
            if imgFull != ""
              scroll -exact-max-zoom=4 flex=1 min-height=0 width="100%" testId="full-zoom"
                image imgSrc width="100%" height="100%" object-fit="contain" testId="full-image"
              row justify-content="center" padding="8px 0"
                row press=reloadImage padding="6px 12px" border-radius=10 background-color="surface.card" testId="image-reload"
                  text t("file.reload") font-size="0.75rem" color="-exact-secondary-label"
            // The Mac's own open / show-in-Finder for the file being read (where the Mac has a desktop).
            if imgFull == "" and snap.bridgeOpen and viewPath != ""
              row gap=8 padding="0 16px 8px 16px" align-items="center" flex-wrap="wrap" testId="viewer-mac"
                row press=macOpen(viewPath, "open") padding="6px 12px" border-radius=10 background-color="surface.card" testId="viewer-open-mac"
                  text t("mac.open") font-size="0.75rem"
                row press=macOpen(viewPath, "reveal") padding="6px 12px" border-radius=10 background-color="surface.card" testId="viewer-reveal"
                  text t("mac.reveal") font-size="0.75rem"
                if macErr != ""
                  text macErr font-size="0.69rem" color="-exact-system-red" testId="viewer-mac-error"
            if imgFull == ""
              column flex=1 min-height=0 overflow="auto" padding="12px 16px"
                if file.ok and file.kind == "text"
                  text file.text font-size="0.75rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" white-space="pre-wrap" overflow-wrap="break-word" testId="file-text"
                if file.ok and file.kind == "image"
                  scroll -exact-max-zoom=4 flex=1 min-height=0 width="100%" testId="file-zoom"
                    image file.url width="100%" height="100%" object-fit="contain" testId="file-image"
                if file.ok and file.kind == "binary"
                  text t("file.binary", n=file.bytes) font-size="0.81rem" color="-exact-secondary-label" testId="file-binary"
                if not file.ok
                  text t("file.missing") font-size="0.81rem" color="-exact-secondary-label" testId="file-missing"
                if pending(file)
                  text t("common.loadingMore") font-size="0.81rem" color="-exact-secondary-label"
        if e.name == "schedules"
          column navigationKey=`${e.id}` navigationScroll="sched-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("sched.title") role="heading" aria-level=1 flex=1
              button press=openTask("new") aria-label=t("sched.new") testId="sched-new"
                image "symbol:add"
            // The task manager: a task's state, timing and next run; a tap opens its page (edit, pause / resume, run now, delete).
            list id="sched-list" appearance="none" flex=1 min-height=0
              if sched.items.length == 0
                text t("sched.none") font="-exact-footnote" color="-exact-secondary-label" padding="16px" testId="sched-none"
              for st in sched.items key=st.id
                row press=openTask(st.tid) gap=10 align-items="center" padding="12px 16px" testId=`sched-${st.tid}`
                  image "symbol:refresh" font-size="0.8rem" color=(st.status == "active" ? "brand.fill" : "-exact-tertiary-label")
                  column flex=1 min-width=0 gap=2
                    text st.title font="-exact-body" line-clamp=1 testId=`sched-title-${st.tid}`
                    text st.timing font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
                    if st.next != ""
                      text `${t("sched.next")} · ${st.next}` font-size="0.62rem" color="-exact-tertiary-label" testId=`sched-next-${st.tid}`
                  column gap=2 align-items="flex-end"
                    text st.state font-size="0.69rem" font-weight=600 color=(st.overdue ? "-exact-system-orange" : (st.status == "active" ? "-exact-system-green" : "-exact-tertiary-label")) testId=`sched-state-${st.tid}`
                    if st.running
                      text t("sched.running") font-size="0.62rem" color="-exact-system-orange"
                  image "symbol:forward-chevron" font-size="0.55rem" color="-exact-tertiary-label"
        if e.name == "task"
          column navigationKey=`${e.id}` navigationScroll="task-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text (sEdit == "new" ? t("sched.new") : t("sched.edit")) role="heading" aria-level=1 flex=1 testId="task-title"
            // The task editor: name, instruction and the run time as plain fields (once: a date and a time; interval: N minutes or hours;
            // daily: a time; weekly: weekdays and a time), always with the time zone.
            list id="task-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                input value=sName input=editSName placeholder=t("sched.titleField") aria-label=t("sched.titleField") testId="task-name"
                textarea value=sPrompt input=editSPrompt field-sizing="content" max-height=160 border="none" placeholder=t("sched.promptField") aria-label=t("sched.promptField") testId="task-prompt"
              section
                text t("sched.when") font="-exact-footnote" color="-exact-secondary-label"
                row role="radiogroup" aria-label=t("sched.when") gap=0 testId="task-mode"
                  button role="radio" aria-checked=(sMode == "once") press=setSMode("once") flex=1 testId="task-mode-once"
                    text t("sched.mode.once")
                  button role="radio" aria-checked=(sMode == "every") press=setSMode("every") flex=1 testId="task-mode-every"
                    text t("sched.mode.every")
                  button role="radio" aria-checked=(sMode == "daily") press=setSMode("daily") flex=1 testId="task-mode-daily"
                    text t("sched.mode.daily")
                  button role="radio" aria-checked=(sMode == "weekly") press=setSMode("weekly") flex=1 testId="task-mode-weekly"
                    text t("sched.mode.weekly")
                if sMode == "custom"
                  text `${task.timing}` font-size="0.81rem" testId="task-custom-timing"
                  text t("sched.custom") font="-exact-footnote" color="-exact-secondary-label"
                if sMode == "once"
                  row gap=8 align-items="center"
                    text t("sched.date") flex=1
                    input type="date" value=sDate change=editSDate aria-label=t("sched.date") testId="task-date"
                if sMode == "every"
                  row gap=8 align-items="center"
                    text t("sched.interval") flex=1
                    input value=sInterval input=editSInterval inputmode="numeric" text-align="end" aria-label=t("sched.interval") aria-invalid=(not intervalOk) testId="task-interval" min-width=0
                  row role="radiogroup" aria-label=t("sched.interval") gap=0 testId="task-unit"
                    button role="radio" aria-checked=(sUnit == "minutes") press=setSUnit("minutes") flex=1 testId="task-unit-minutes"
                      text t("sched.unit.minutes")
                    button role="radio" aria-checked=(sUnit == "hours") press=setSUnit("hours") flex=1 testId="task-unit-hours"
                      text t("sched.unit.hours")
                if sMode == "weekly"
                  text t("sched.weekday") font="-exact-footnote" color="-exact-secondary-label"
                  row gap=6 flex-wrap="wrap" testId="task-days"
                    for d in [1, 2, 3, 4, 5, 6, 7] key=d
                      row press=flipDay(d) padding="6px 10px" border-radius=12 background-color=(dayOn(sDays, d) ? "brand.fill" : "surface.card") aria-pressed=dayOn(sDays, d) testId=`task-day-${d}`
                        text dayName(d) font-size="0.75rem" color=(dayOn(sDays, d) ? "ink.on-brand" : "text.ink")
                if sMode != "every" and sMode != "custom"
                  row gap=8 align-items="center"
                    text t("sched.time") flex=1
                    input type="time" value=sTime change=editSTime aria-label=t("sched.time") testId="task-time"
                if sMode != "custom"
                  row gap=8 align-items="center"
                    text t("sched.zone") flex=1
                    input value=sZone input=editSZone placeholder=sched.zone autocapitalize="none" autocorrect="off" text-align="end" aria-label=t("sched.zone") testId="task-zone" min-width=0 flex=2
              if taskFail != ""
                section
                  text taskFail font="-exact-footnote" color="-exact-system-red" testId="task-error"
              section
                button press=saveTask disabled=(not taskValid or pending(schedSaved)) testId="task-save"
                  text (pending(schedSaved) ? t("sched.saving") : (sEdit == "new" ? t("sched.create") : t("common.save")))
              if sEdit != "new"
                section
                  text `${task.state}${task.next != "" ? ` · ${t("sched.next")} ${task.next}` : ""}` font-size="0.81rem" color="-exact-secondary-label" testId="task-state"
                  if task.running
                    text t("sched.running") font="-exact-footnote" color="-exact-system-orange"
                section
                  button press=toggleTask disabled=(pending(schedToggled) or task.status == "ended") testId="task-toggle"
                    text (task.status == "active" ? t("sched.pause") : t("sched.resume"))
                section
                  button press=runTask disabled=pending(schedRan) testId="task-run"
                    text t("sched.run")
                section
                  if not sConfirmDel
                    button press=askDeleteTask testId="task-delete"
                      text t("sched.delete") color="-exact-system-red"
                  else
                    text t("sched.deleteWarn") font="-exact-footnote" color="-exact-secondary-label"
                    row gap=12
                      button press=deleteTask disabled=pending(schedDeleted) testId="task-delete-confirm"
                        text t("sched.deleteConfirm") color="-exact-system-red"
                      button press=cancelDeleteTask testId="task-delete-cancel"
                        text t("common.cancel")
        // One file's changes in one turn (ui-deliverables' review): the host's own comparison, or the turn's tool diffs; hunks with the file's
        // line numbers, what was created or deleted, and where the Mac can open the file.
        if e.name == "diff"
          column navigationKey=`${e.id}` navigationScroll="diff-scroll" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" padding-top="var(--exact-safe-area-inset-top)"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              column flex=1 min-width=0 gap=1
                text (changes.name != "" ? changes.name : baseName(diffPath)) font-size="0.94rem" font-weight=600 line-clamp=1 testId="diff-name"
                text t("diff.title", turn=diffTurn) font-size="0.62rem" color="-exact-tertiary-label"
              if changes.ok and changes.kind == "text"
                text `+${changes.added}` font-size="0.72rem" color=addC() testId="diff-added"
                text `−${changes.removed}` font-size="0.72rem" color=delC() testId="diff-removed"
            if snap.bridgeOpen and diffPath != ""
              row gap=8 padding="0 16px 8px 16px" align-items="center" flex-wrap="wrap" testId="diff-mac"
                row press=macOpen(diffPath, "open") padding="6px 12px" border-radius=10 background-color="surface.card" testId="diff-open-mac"
                  text t("mac.open") font-size="0.75rem"
                row press=macOpen(diffPath, "reveal") padding="6px 12px" border-radius=10 background-color="surface.card" testId="diff-reveal"
                  text t("mac.reveal") font-size="0.75rem"
                if macErr != ""
                  text macErr font-size="0.69rem" color="-exact-system-red"
            scroll id="diff-scroll" flex=1 min-height=0 testId="diff-scroll"
              column gap=4 padding="4px 12px 24px 12px"
                if pending(changes)
                  text t("diff.loading") font="-exact-footnote" color="-exact-secondary-label" testId="diff-loading"
                if not pending(changes) and not changes.ok
                  text t("diff.missing") font="-exact-footnote" color="-exact-secondary-label" testId="diff-missing"
                if changes.ok and changes.kind == "binary"
                  text t("diff.binary") font="-exact-footnote" color="-exact-secondary-label" testId="diff-binary"
                if changes.ok and changes.kind == "oversized"
                  text t("diff.oversized") font="-exact-footnote" color="-exact-secondary-label" testId="diff-oversized"
                if changes.ok and changes.kind == "text"
                  if changes.created
                    text t("diff.created") font-size="0.69rem" color="-exact-secondary-label" testId="diff-created"
                  if changes.deleted
                    text t("diff.deleted") font-size="0.69rem" color="-exact-secondary-label" testId="diff-deleted"
                  if changes.coarse
                    text t("diff.coarse") font-size="0.69rem" color="-exact-secondary-label"
                  if changes.lines.length == 0
                    text t("diff.unchanged") font-size="0.69rem" color="-exact-secondary-label"
                  column gap=1 background-color="surface.card" border-radius=8 padding="6px 8px" testId="diff-lines"
                    for ln in changes.lines key=ln.id
                      ToolLineRow(ln=ln, gut=true)
                  if changes.cut
                    text t("diff.truncated", count=1500) font-size="0.69rem" color="-exact-tertiary-label"
        if e.name == "scan"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page"
            row align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("scan.title") role="heading" aria-level=1 flex=1
            if scanTrack != "" and not pending(scanned)
              exact-camera srcObject=scanTrack object-fit="cover" aria-label="Camera" testId="scan-viewfinder" flex=1 min-height=0 width="100%"
            else if pending(scanned)
              column flex=1 align-items="center" justify-content="center" padding=24 gap=12
                image "assets/whale.svg" width=44 height=44 color="brand.fill" testId="scan-pairing-icon"
                text t("pair.working") font="-exact-headline" testId="scan-pairing"
            else
              column flex=1 align-items="center" justify-content="center" padding=24 gap=10
                text (cameraError == "" ? t("scan.opening") : cameraError) text-align="center" color="-exact-secondary-label"
            column gap=10 padding=16 align-items="center" background-color="surface.page"
              if firstCode == "" and not pending(scanned)
                text t("scan.hint") font="-exact-footnote" color="-exact-secondary-label" text-align="center"
              else if not pending(scanned)
                text t("scan.found") font="-exact-subheadline" testId="scan-found"
                row press=connect(firstCode) padding="10px 16px" border-radius=12 background-color="brand.fill" testId="scan-connect"
                  text (linkError == "" ? t("scan.pairThis") : t("retry")) font-size="0.94rem" font-weight=600 color="ink.on-brand"
              // No camera (a simulator, or a refusal): the same link typed by hand.
              column gap=8 align-items="stretch" width="100%"
                input value=scanNote input=editScanNote placeholder="dshm://pair?…" aria-label="Pairing link" testId="scan-link" min-height=44 background-color="surface.card" border-radius=10 padding="10px 12px"
                button press=connect(scanNote) disabled=(scanNote == "" or pending(scanned)) testId="scan-manual"
                  text t("pair.pair")
              if linkError != ""
                text linkError font="-exact-footnote" color="-exact-system-red" text-align="center" testId="scan-error"
        if e.name == "open"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" align-items="center" justify-content="center" padding=24 gap=12
            image "assets/whale.svg" width=44 height=44 color="brand.fill"
            if match deepLinked { case some(r) => r.ok, case none => false }
              text t("open.connected") font="-exact-headline" text-align="center" testId="open-done"
              row press=goHome padding="12px 24px" border-radius=12 background-color="brand.fill" testId="open-enter"
                text t("open.enter") font-size="0.94rem" font-weight=600 color="ink.on-brand"
            else
              text (pending(deepLinked) or openUrl == "" ? t("open.pairing") : t("open.received")) font="-exact-headline" text-align="center" testId="open-title"
              if deepError != ""
                text deepError font="-exact-footnote" color="-exact-system-red" text-align="center" testId="open-error"
              row press=connect(openUrl) padding="13px 20px" border-radius=12 background-color=(pending(deepLinked) ? "surface.card-strong" : "brand.fill") opacity=(pending(deepLinked) ? 0.6 : 1) testId="open-retry"
                text t("open.retry") font-size="0.94rem" font-weight=600 color="ink.on-brand"
              row press=toSettings padding="12px 20px" min-height=44 testId="open-manual"
                text t("open.manual") font-size="0.87rem" color="-exact-secondary-label"
        if e.name == "notfound"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" testId="not-found"
            row align-items="center" flex-wrap="wrap" padding="8px 16px" gap=8
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("notfound.title") role="heading" aria-level=1 font-size="min(-exact-headline, 32px)" flex="1 1 12rem" min-width=0
            column flex=1 min-height=0 align-items="center" justify-content="center" gap=12 padding="48px 24px"
              image "symbol:alert" font-size="2rem" color="-exact-secondary-label" aria-hidden=true
              text t("notfound.heading") font="-exact-title3" text-align="center" testId="not-found-title"
              text t("notfound.message", url=e.url) width="100%" color="-exact-secondary-label" text-align="center" white-space="pre-wrap" overflow-wrap="break-word" testId="not-found-message"
              row press=goHome padding="12px 24px" border-radius=12 background-color="brand.fill" margin-top=8 testId="not-found-home"
                text t("notfound.home") font-size="0.94rem" font-weight=600 color="ink.on-brand"
        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings-list" navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column"
            row align-items="center" flex-wrap="wrap" padding="8px 16px" gap=8 background-color="surface.page"
              button press=leave aria-label="Back" testId="back"
                image "symbol:back"
              text t("pair.connect") role="heading" aria-level=1 flex="1 1 12rem" min-width=0 line-clamp=1
            list id="settings-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              if devices.devices.length > 0
                section
                  text t("devices.title") font-size="0.69rem" color="-exact-tertiary-label" padding="6px 16px 2px 16px"
                  for dv in devices.devices key=dv.id
                    row gap=8 align-items="center" padding="8px 4px" testId=`device-${dv.id}`
                      column flex=1 min-width=0 gap=2
                        text (dv.mine ? t("devices.thisMac", name=dv.name) : dv.name) font-size="0.81rem" line-clamp=1
                            text dv.when font-size="0.69rem" color="-exact-tertiary-label"
                      if not dv.mine
                        button press=revokeDevice(dv.id) disabled=pending(revoked) testId=`revoke-${dv.id}`
                          text t("devices.remove") color="-exact-system-red" font-size="0.75rem"
              section
                column gap=2
                  text t("view.title") font-size="0.69rem" color="-exact-tertiary-label" padding="6px 0 2px 0"
                  row press=setViewMode("follow") gap=8 align-items="center" min-height=44 testId="view-follow"
                    text (viewMode == "follow" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    column flex=1 min-width=0 gap=1
                      text t("view.follow")
                      text t("view.followNow", mode=viewName(snap.prefs.transcriptView == "" ? "standard" : snap.prefs.transcriptView)) font="-exact-footnote" color="-exact-secondary-label" testId="view-follow-now"
                  row press=setViewMode("compact") gap=8 align-items="center" min-height=44 testId="view-compact"
                    text (viewMode == "compact" or viewMode == "" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text t("view.compact") flex=1
                  row press=setViewMode("standard") gap=8 align-items="center" min-height=44 testId="view-standard"
                    text (viewMode == "standard" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text t("view.standard") flex=1
                  row press=setViewMode("detailed") gap=8 align-items="center" min-height=44 testId="view-detailed"
                    text (viewMode == "detailed" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text t("view.detailed") flex=1
                  row press=setViewMode("verbose") gap=8 align-items="center" min-height=44 testId="view-verbose"
                    text (viewMode == "verbose" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text t("view.verbose") flex=1
              section
                row gap=8 align-items="center"
                  text t("settings.showArchived") flex=1
                  input type="checkbox" switch checked=showArchived change=setShowArchived aria-label=t("settings.showArchived") testId="archived-toggle"
              section
                column gap=2
                  row press=setLang("") gap=8 align-items="center" min-height=44 testId="lang-system"
                    text (lang == "" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text t("lang.system") flex=1
                  row press=setLang("zh-Hans") gap=8 align-items="center" min-height=44 testId="lang-zh"
                    text (lang == "zh-Hans" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text "中文" flex=1
                  row press=setLang("en") gap=8 align-items="center" min-height=44 testId="lang-en"
                    text (lang == "en" ? "✓" : "") min-width="1rem" color="-exact-label" font-weight=600
                    text "English" flex=1
              section
                row gap=8 align-items="center"
                  text t("pair.server") flex=1
                  input value=server input=editServer placeholder="https://…" aria-label=t("pair.server") testId="server"
              section
                row gap=8 align-items="center"
                  text t("pair.token") flex=1
                  input value=token input=editToken placeholder=t("pair.tokenHint") aria-label=t("pair.token") testId="token"
              section
                row gap=8 align-items="center"
                  text t("pair.code") flex=1
                  input value=code input=editCode placeholder=t("pair.codeHint") aria-label=t("pair.code") testId="code"
              section
                button press=pair disabled=(code.length != 6 or pending(paired)) testId="pair"
                  text (pending(paired) ? t("pair.pairing") : t("pair.pair"))
              if pairError != ""
                section
                  text pairError font="-exact-footnote" color="-exact-system-red" testId="pair-error"
              section
                text t("pair.help") font="-exact-footnote" color="-exact-secondary-label"

// A tool approval, or a question-intent approval with the asker's labels (官方 ApprovalCard: 拒绝 / 允许一次, plus 始终允许 only when offered).
component ApprovalCard
  props
    a: ApprovalRow
    busy: bool
    error: string
    decide: action
  view
    column gap=8 padding="12px 14px" background-color="surface.card" border-radius=14 testId="approval-card"
      row gap=6 align-items="center"
        image "symbol:alert" font-size="0.7rem" color="-exact-system-orange"
        text t("approval.waiting") font="-exact-footnote" font-weight=600 color="-exact-secondary-label" testId="approval-waiting"
      if a.subject != ""
        text a.subject font="-exact-body" font-weight=600 testId=`approval-subject-${a.id}`
      text (a.reason != "" ? a.reason : t("approval.escalation", toolName=a.toolName)) font="-exact-body" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word" testId=`approval-${a.id}`
      if a.detail != ""
        text a.detail markup="markdown" font="-exact-caption1" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word" line-clamp=8 testId=`approval-detail-${a.id}`
      // The correlated call: the shell command it wants to run, else its arguments.
      if a.command != ""
        text a.command font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.75rem" color="text.ink" background-color="surface.card-strong" padding="6px 8px" border-radius=8 line-clamp=6 white-space="pre-wrap" overflow-wrap="break-word" testId=`approval-cmd-${a.id}`
      if a.command == "" and a.args != ""
        text a.args font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.69rem" background-color="surface.card-strong" padding="6px 8px" border-radius=8 line-clamp=5 white-space="pre-wrap" overflow-wrap="break-word"
      if a.command == "" and a.summary != ""
        text a.summary font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.75rem" color="-exact-secondary-label" line-clamp=2
      if error != ""
        text error font="-exact-footnote" color="-exact-system-red" white-space="pre-wrap" testId="approval-error"
      row gap=8 align-items="center"
        row press=decide("deny") flex=1 justify-content="center" padding="9px 12px" border-radius=10 background-color="surface.card-strong" opacity=(busy ? 0.6 : 1) testId=`deny-${a.id}`
          text t("approval.deny") font-size="0.81rem" font-weight=600
        row press=decide("allow") flex=1 justify-content="center" padding="9px 12px" border-radius=10 background-color=(a.alwaysLabel == "" ? "brand.fill" : "surface.card-strong") opacity=(busy ? 0.6 : 1) testId=`allow-${a.id}`
          text (a.approveLabel != "" ? a.approveLabel : t("approval.allowOnce")) font-size="0.81rem" font-weight=600 color=(a.alwaysLabel == "" ? "ink.on-brand" : "text.ink")
        if a.alwaysLabel != ""
          row press=decide("always") flex=1 justify-content="center" padding="9px 12px" border-radius=10 background-color="brand.fill" opacity=(busy ? 0.6 : 1) testId=`always-${a.id}`
            text t("approval.allowAlways") font-size="0.81rem" font-weight=600 color="ink.on-brand"

// The desktop's QuestionComposer, one question at a time: pager, skip, 推荐, custom answer, the Mac's countdown.
// The drafts live here; the one submit sends every question (a skipped one empty) in a single answer.
component QuestionCard
  props
    q: QuestionRow
    busy: bool
    error: string
    submit: action
    dismiss: action
    hold: action
  state idx = 0
  state picks: string[] = q.items.map(it => startPicks(it))
  state customs: string[] = q.items.map(it => "")
  state skips: string[] = q.items.map(it => "")
  state err = ""
  state min = false
  state engaged = false
  state sentOpen = false
  derive last = q.items.length - 1
  derive item = match q.items.at(idx) { case some(it) => it, case none => QuestionItem(id="", header="", question="", detail="", multi=false, options=[]) }
  derive pick = sAt(picks, idx)
  derive custom = sAt(customs, idx)
  derive answeredHere = pick.length > 2 or custom.trim() != ""
  // A countdown only runs while the question is open and the Mac's card carries one.
  derive timed = q.countdown >= 0 and q.state == "open"
  // A waterfall answer is only "sent": the card stays locked until the Mac closes it (or flips to continued, which re-arms it).
  derive sending = busy or (sentOpen and q.state == "open" and error == "")
  derive resubmit = sentOpen and q.state == "continued" and not busy
  // The first edit keeps the Mac from timing the question out under the person typing (its own composer does the same).
  action engage
    if not engaged and timed
      engaged = true
      hold("engage")
  action choose(oid: string)
    if not sending
      let multi = item.multi
      let key = `|${oid}|`
      picks = picks.map((v, j) => j == idx ? (multi ? (v.includes(key) ? v.replaceAll(key, "|") : v + oid + "|") : key) : v)
      customs = customs.map((v, j) => (j == idx and not multi) ? "" : v)
      skips = skips.map((v, j) => j == idx ? "" : v)
      err = ""
      sentOpen = false
      if not multi and idx < last
        idx = idx + 1
      engage()
  action editCustom(v: string)
    if not sending
      let multi = item.multi
      customs = customs.map((x, j) => j == idx ? v : x)
      picks = picks.map((x, j) => (j == idx and not multi) ? "|" : x)
      skips = skips.map((x, j) => j == idx ? "" : x)
      err = ""
      sentOpen = false
      engage()
  action goPrev
    if idx > 0
      idx = idx - 1
      err = ""
  action goNext
    if idx < last
      idx = idx + 1
      err = ""
  action toggleMin
    min = not min
  action takeTime
    engaged = true
    hold("take")
  // One answer for the whole set, once every question is answered or skipped.
  action sendAll
    if not sending
      let missing = firstMissing(picks, customs, skips, q.items.length)
      if missing >= 0
        idx = missing
        err = "incomplete"
      else
        err = ""
        sentOpen = q.state == "open"
        submit(payload(q, picks, customs, skips))
  action next
    if not sending
      if not answeredHere
        err = "unanswered"
      else
        if idx < last
          idx = idx + 1
          err = ""
        else
          sendAll()
  // A skip is an item with nothing selected and no custom text; on the last question it sends.
  action skipOne
    if not sending
      let np = picks.map((v, j) => j == idx ? "|" : v)
      let nc = customs.map((v, j) => j == idx ? "" : v)
      let ns = skips.map((v, j) => j == idx ? "1" : v)
      picks = np
      customs = nc
      skips = ns
      err = ""
      sentOpen = false
      if idx < last
        idx = idx + 1
      else
        let missing = firstMissing(np, nc, ns, q.items.length)
        if missing >= 0
          idx = missing
          err = "incomplete"
        else
          sentOpen = q.state == "open"
          submit(payload(q, np, nc, ns))
  view
    column gap=8 padding="12px 14px" background-color="surface.card" border-radius=14 testId="question-card"
      row gap=6 align-items="flex-start"
        column flex=1 min-width=0 gap=2
          if item.header != ""
            text item.header font-size="0.69rem" color="-exact-tertiary-label" testId="question-hint"
          if min
            text item.question font="-exact-body" font-weight=600 line-clamp=2
        column gap=4 align-items="flex-end"
          if q.state == "continued"
            text t("question.continued") font-size="0.69rem" color="-exact-secondary-label" testId="question-continued"
          if timed and q.held
            text t("question.held") font-size="0.69rem" color="-exact-secondary-label" testId="question-held"
          if timed and not q.held
            row gap=6 align-items="center"
              text (q.running ? t("question.countdown", seconds=q.countdown) : t("question.paused", seconds=q.countdown)) font-size="0.69rem" color="-exact-tertiary-label" testId="question-countdown"
              row press=takeTime padding="3px 8px" border-radius=8 background-color="surface.card-strong" testId="question-take-time"
                text t("question.takeTime") font-size="0.69rem"
        row gap=0 align-items="center"
          row press=toggleMin width="1.9rem" height="1.9rem" align-items="center" justify-content="center" aria-label=(min ? t("question.maximize") : t("question.minimize")) testId="question-min"
            text (min ? "+" : "−") font-size="0.94rem" color="-exact-tertiary-label"
          row press=dismiss width=30 height=30 align-items="center" justify-content="center" aria-label=(q.dismissal == "hide" ? t("question.close") : t("question.cancel")) testId="question-dismiss"
            image "symbol:close" font-size="0.62rem" color="-exact-tertiary-label"
      if not min
        scroll max-height=300 testId="question-scroll"
          column gap=8
            text item.question font="-exact-body" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word" testId=`question-ask-${idx}`
            if item.detail != ""
              text item.detail markup="markdown" font="-exact-caption1" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
            for o, oi in item.options key=o.id
              row press=choose(o.id) gap=10 align-items="flex-start" padding="9px 12px" background-color=(pick.includes(`|${o.id}|`) ? "brand.fill" : "surface.card-strong") border-radius=10 testId=`option-${o.id}`
                text (item.multi ? (pick.includes(`|${o.id}|`) ? "☑" : "☐") : `${oi + 1}`) font-size="0.81rem" color=(pick.includes(`|${o.id}|`) ? "ink.on-brand" : "-exact-tertiary-label") min-width="1.1rem"
                column flex=1 min-width=0 gap=2
                  row gap=6 align-items="center" flex-wrap="wrap"
                    text o.text font-size="0.81rem" color=(pick.includes(`|${o.id}|`) ? "ink.on-brand" : "text.ink") white-space="pre-wrap" overflow-wrap="break-word"
                    if o.recommended
                      text t("question.recommended") font-size="0.62rem" padding="1px 6px" border-radius=6 background-color=(pick.includes(`|${o.id}|`) ? "surface.card" : "surface.card") color="-exact-secondary-label" testId=`recommended-${o.id}`
                  if o.description != ""
                    text o.description font-size="0.69rem" color=(pick.includes(`|${o.id}|`) ? "ink.on-brand" : "-exact-tertiary-label") white-space="pre-wrap" overflow-wrap="break-word"
            textarea value=custom input=editCustom field-sizing="content" max-height=100 border="none" background-color="surface.card-strong" padding="10px 12px" border-radius=10 font-size="0.81rem" placeholder=t("question.custom") aria-label=t("question.custom") testId=`question-custom-${idx}`
        if err != ""
          text (err == "unanswered" ? t("question.err.unanswered") : t("question.err.incomplete")) font="-exact-footnote" color="-exact-system-red" testId="question-error"
        else
          if error != ""
            text error font="-exact-footnote" color="-exact-system-red" white-space="pre-wrap" testId="question-error"
          else
            if resubmit
              text t("question.err.resubmit") font="-exact-footnote" color="-exact-system-red" testId="question-error"
        row gap=8 align-items="center"
          row gap=2 align-items="center"
            row press=goPrev width="1.9rem" height="1.9rem" align-items="center" justify-content="center" opacity=(idx == 0 ? 0.3 : 1) aria-label=t("question.prev") testId="question-prev"
              text "‹" font-size="1.1rem" color="-exact-secondary-label"
            text `${idx + 1} / ${q.items.length}` font-size="0.75rem" color="-exact-secondary-label" testId="question-progress"
            row press=goNext width="1.9rem" height="1.9rem" align-items="center" justify-content="center" opacity=(idx >= last ? 0.3 : 1) aria-label=t("question.next") testId="question-next"
              text "›" font-size="1.1rem" color="-exact-secondary-label"
          row flex=1
          row press=skipOne padding="8px 14px" border-radius=10 background-color="surface.card-strong" opacity=(sending ? 0.6 : 1) testId="question-skip"
            text t("question.skip") font-size="0.81rem"
          row press=next padding="8px 14px" border-radius=10 background-color="brand.fill" opacity=(sending or not answeredHere ? 0.6 : 1) testId="question-answer"
            text (sending ? t("question.submitting") : (idx >= last ? t("question.submit") : t("question.next"))) font-size="0.81rem" font-weight=600 color="ink.on-brand"

// 计划待审: the plan's title and first paragraph, the full plan on demand, 同意执行 / 要求修改.
component PlanCard
  props
    q: QuestionRow
    busy: bool
    error: string
    submit: action
    dismiss: action
  state open = false
  derive plan = match q.plan { case some(p) => p, case none => PlanReview(title="", description="", nodes=[], approve="") }
  derive qid = match first(q.items) { case some(it) => it.id, case none => "" }
  action toggle
    open = not open
  action approve
    submit(`${encodeURIComponent(qid)}|${encodeURIComponent(plan.approve)}|`)
  view
    column gap=8 padding="12px 14px" background-color="surface.card" border-radius=14 testId="plan-card"
      row gap=6 align-items="center"
        image "symbol:circle" font-size="0.45rem" color="-exact-system-orange"
        text t("plan.header") font="-exact-footnote" font-weight=600 color="-exact-secondary-label" testId="plan-header"
      text plan.title font="-exact-body" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word" testId="plan-title"
      if plan.description != "" and not open
        text plan.description font="-exact-caption1" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word" line-clamp=4 testId="plan-description"
      row press=toggle gap=4 align-items="center" testId="plan-toggle"
        text (open ? t("plan.hideFull") : t("plan.showFull")) font-size="0.75rem" color="brand.fill"
      if open
        scroll max-height=320 testId="plan-full"
          column gap=6
            for n in plan.nodes key=n.id
              column gap=2
                if n.t == "h"
                  text n.v markup="markdown" font-size=(n.lvl <= 2 ? "0.94rem" : "0.85rem") font-weight=600 white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "p"
                  text n.v markup="markdown" font-size="0.81rem" white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "ul" or n.t == "ol"
                  for it in n.items key=it.id
                    row gap=6 align-items="flex-start" padding-left=(it.d * 14)
                      text it.mark font-size="0.81rem" color="-exact-secondary-label"
                      text it.v markup="markdown" font-size="0.81rem" flex=1 min-width=0 white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "code" or n.t == "math"
                  text n.v font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.72rem" background-color="surface.card-strong" padding="6px 8px" border-radius=8 white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "diff"
                  column gap=0 background-color="surface.card-strong" border-radius=8 padding="6px 8px"
                    for dl in n.items key=dl.id
                      text dl.v font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.72rem" white-space="pre-wrap" overflow-wrap="break-word" color=(dl.sign == "+" ? addC() : dl.sign == "-" ? delC() : "-exact-secondary-label")
                if n.t == "quote"
                  text n.v markup="markdown" font-size="0.81rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "table"
                  view overflow-x="auto"
                    table
                      thead
                        tr
                          for c in n.heads key=c.id
                            th scope="col" padding="3px 8px" text-align=c.a
                              text c.v markup="markdown" font-size="0.75rem" font-weight=600
                      tbody
                        for r in n.grid key=r.id
                          tr
                            for c in r.cells key=c.id
                              td padding="3px 8px" text-align=c.a max-width="14rem"
                                text c.v markup="markdown" font-size="0.75rem" white-space="pre-wrap" overflow-wrap="break-word"
                if n.t == "hr"
                  hr
      if error != ""
        text error font="-exact-footnote" color="-exact-system-red" white-space="pre-wrap" testId="plan-error"
      row gap=8 align-items="center"
        row press=dismiss flex=1 justify-content="center" padding="9px 12px" border-radius=10 background-color="surface.card-strong" opacity=(busy ? 0.6 : 1) testId="plan-discuss"
          text t("plan.discuss") font-size="0.81rem" font-weight=600
        row press=approve flex=1 justify-content="center" padding="9px 12px" border-radius=10 background-color="brand.fill" opacity=(busy ? 0.6 : 1) testId="plan-approve"
          text t("plan.approve") font-size="0.81rem" font-weight=600 color="ink.on-brand"

// A question tool row's state (等待回答 / 已继续工作，仍可回答 / n/m 已回答 / 已取消 / 已中断) with its Q&A, and the 问题与回答 bubble of a late reply.
component AskBody
  props
    ask: AskCard
    reply: bool
    canReveal: bool
    reveal: action
  view
    column gap=6
      if reply
        column gap=3 align-items="flex-end"
          text t("reply.label") font-size="0.62rem" color="-exact-tertiary-label"
          column gap=8 padding="10px 12px" border-radius=18 max-width="86%" background-color="brand.fill"
            for it in ask.items key=it.id
              column gap=2
                if it.header != "" and it.header != it.question
                  text it.header font-size="0.62rem" color="ink.on-brand" opacity=0.75
                text it.question font-size="0.81rem" font-weight=600 color="ink.on-brand" white-space="pre-wrap" overflow-wrap="break-word"
                text (it.skipped or it.answers.length == 0 ? t("reply.skipped") : `${t("reply.answerLabel")}${it.answers.join(", ")}`) font-size="0.81rem" color="ink.on-brand" white-space="pre-wrap" overflow-wrap="break-word" testId=`reply-answer-${it.id}`
      else
        row gap=8 align-items="center"
          text askSummary(ask) font-size="0.75rem" font-weight=600 color=(ask.state == "cancelled" or ask.state == "interrupted" ? "-exact-system-orange" : "-exact-secondary-label") flex=1 min-width=0 testId=`ask-summary-${ask.callId}`
          if canReveal
            row press=reveal padding="4px 10px" border-radius=8 background-color="brand.fill" testId=`ask-reopen-${ask.callId}`
              text t("ask.reopen") font-size="0.69rem" color="ink.on-brand"
        if askVerdict(ask) != ""
          text askVerdict(ask) font-size="0.69rem" color="-exact-tertiary-label"
        for it in ask.items key=it.id
          column gap=1
            text it.question font-size="0.75rem" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word"
            if ask.state == "answered"
              text (it.answers.length == 0 ? t("ask.skipped") : it.answers.join(", ")) font-size="0.75rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"

// One disclosure row of the transcript the bridge words itself: a trigger, a context injection, a compaction, a command,
// a retry. The header is its icon, title and one-line summary; the body (when it has one) opens under it.
component NoteRow
  props
    icon: string
    title: string
    summary: string
    body: string
    open: bool
    toggle: action
    tint: string
    tid: string
  view
    column gap=3 padding="2px 12px"
      row press=toggle gap=6 align-items="center" testId=tid
        image icon font-size="0.6rem" color=(tint == "error" ? "-exact-system-red" : (tint == "warn" ? "-exact-system-orange" : "-exact-tertiary-label"))
        text title font-size="0.69rem" min-width=0 line-clamp=2 color=(tint == "error" ? "-exact-system-red" : "-exact-secondary-label")
        text summary font-size="0.69rem" color="-exact-tertiary-label" line-clamp=1 flex=1 min-width=0
        if body != ""
          text (open ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"
      if open and body != ""
        text body font-size="0.72rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word" padding="0 0 2px 16px" testId=`${tid}-body`

// The control above a closed turn's process (TurnProcessNodeView): how it went (已完成，用时 X / 处理失败 / 已停止), what it did, and — when
// the process has something to fold — the toggle. `tone` is the turn's state: done, failed or stopped.
component TurnControl
  props
    title: string
    summary: string
    tone: string
    open: bool
    can: bool
    toggle: action
    tid: string
  view
    row press=toggle gap=6 align-items="flex-start" padding="2px 0" testId=tid
      image (tone == "failed" ? "symbol:alert" : (tone == "stopped" ? "symbol:stop-fill" : "symbol:checkmark")) font-size="0.7rem" color=(tone == "failed" ? "-exact-system-red" : (tone == "stopped" ? "-exact-secondary-label" : "-exact-system-green"))
      column flex=1 min-width=0 gap=1
        text title font-size="0.75rem" color=(tone == "failed" ? "-exact-system-red" : "-exact-secondary-label") testId=`${tid}-title`
        if summary != ""
          text summary font-size="0.69rem" color="-exact-tertiary-label" line-clamp=2 testId=`${tid}-summary`
      if can
        text (open ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"

// A process group's header (ChatGroupSeat): the activity icon and the closed title; the live group reads 正在… with what it is doing.
component GroupHeader
  props
    icon: string
    title: string
    open: bool
    live: bool
    toggle: action
    tid: string
  view
    row press=toggle gap=6 align-items="center" padding="4px 0" testId=tid
      image icon font-size="0.62rem" color=(live ? "brand.fill" : "-exact-tertiary-label")
      text title font-size="0.75rem" color=(live ? "brand.fill" : "-exact-secondary-label") flex=1 min-width=0 line-clamp=2 testId=`${tid}-title`
      text (open ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"

// A 思考 disclosure (ReasoningRow): the first line (the latest paragraph while it streams) beside the title, the whole text on demand.
component ThinkRow
  props
    body: string
    summary: string
    running: bool
    preview: bool
    open: bool
    toggle: action
    tid: string
  view
    column gap=3 padding="0 0 0 4px"
      row press=toggle gap=6 align-items="center" testId=tid
        image "symbol:sparkles" font-size="0.6rem" color=(running ? "brand.fill" : "-exact-tertiary-label")
        text t("chat.think") font-size="0.72rem" color="-exact-secondary-label"
        if not open and summary != "" and (running or preview)
          text summary font-size="0.69rem" color="-exact-tertiary-label" line-clamp=1 flex=1 min-width=0 testId=`${tid}-preview`
        else
          row flex=1
        text (open ? t("common.collapse") : t("common.expand")) font-size="0.69rem" color="-exact-tertiary-label"
      if open
        column background-color="surface.card" border-radius=8 padding="8px 10px"
          text body font="-exact-caption1" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word" testId=`${tid}-body`

// A reply's Markdown nodes: paragraphs and headings (inline marks are the reader's), lists (depth, task boxes), quotes, code (language, copy,
// colours), tables (a grid that scrolls sideways), display math (the TeX source), diffs and pictures.
component MdBody
  props
    nodes: MdNode[]
    mid: string
    tid: string
    server: string
    token: string
    sid: string
    copied: string
    copy: action
    pic: action
  view
    column gap=8
      for n in nodes key=n.id
        column gap=2
          if n.t == "p"
            text n.v markup="markdown" white-space="pre-wrap" overflow-wrap="break-word" testId=tid
          if n.t == "h"
            text n.v markup="markdown" font-size=(n.lvl <= 2 ? "1.06rem" : "0.94rem") font-weight=600 white-space="pre-wrap" overflow-wrap="break-word"
          if n.t == "ul" or n.t == "ol"
            column gap=3
              for it in n.items key=it.id
                row gap=6 align-items="flex-start" padding-left=(it.d * 16)
                  text it.mark font-size="0.875rem" color=(it.sign == "x" ? addC() : "-exact-secondary-label") min-width="1.2rem"
                  text it.v markup="markdown" font-size="0.94rem" color=(it.sign == "x" ? "-exact-secondary-label" : "-exact-label") white-space="pre-wrap" overflow-wrap="break-word" flex=1 min-width=0
          if n.t == "table"
            view overflow-x="auto" testId=`md-table-${n.id}`
              table
                thead
                  tr
                    for c in n.heads key=c.id
                      th scope="col" padding="5px 10px" text-align=c.a background-color="surface.card-strong"
                        text c.v markup="markdown" font-size="0.75rem" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word"
                tbody
                  for r in n.grid key=r.id
                    tr
                      for c in r.cells key=c.id
                        td padding="5px 10px" text-align=c.a max-width="16rem" background-color="surface.card"
                          text c.v markup="markdown" font-size="0.75rem" white-space="pre-wrap" overflow-wrap="break-word"
          if n.t == "diff"
            column gap=0 background-color="surface.card" border-radius=10 padding="8px 10px" testId=`md-diff-${n.id}`
              for dl in n.items key=dl.id
                text dl.v font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.72rem" white-space="pre-wrap" overflow-wrap="break-word" color=(dl.sign == "+" ? addC() : dl.sign == "-" ? delC() : "-exact-secondary-label")
          if n.t == "code"
            column gap=0 background-color="surface.card" border-radius=10 testId=`md-code-${n.id}`
              row gap=8 align-items="center" padding="6px 6px 0 12px"
                text (n.lang != "" ? n.lang : t("md.code")) font-size="0.69rem" color="-exact-tertiary-label" flex=1 min-width=0 testId=`md-lang-${n.id}`
                row press=copy(`${mid}.${n.id}`, n.v) padding="4px 8px" border-radius=8 testId=`md-copy-${n.id}`
                  text (copied == `${mid}.${n.id}` ? t("common.copied") : t("common.copy")) font-size="0.69rem" color="-exact-tertiary-label"
              if n.runs.length > 0
                text white-space="pre-wrap" overflow-wrap="break-word" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.81rem" padding="4px 12px 10px 12px" testId=`md-src-${n.id}`
                  for r in n.runs key=r.id
                    text r.v color=tokColor(r.mark)
              else
                text n.v font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.81rem" white-space="pre-wrap" overflow-wrap="break-word" padding="4px 12px 10px 12px" testId=`md-src-${n.id}`
          if n.t == "math"
            column background-color="surface.card" border-radius=10 padding="8px 10px" align-items="center"
              text n.v font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.85rem" white-space="pre-wrap" overflow-wrap="break-word" testId=`math-${n.id}`
          if n.t == "quote"
            row background-color="surface.card" border-radius=8 padding="8px 10px"
              text n.v markup="markdown" font-size="0.875rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
          if n.t == "hr"
            hr
          if n.t == "img"
            column gap=2
              if n.v.startsWith("http")
                image n.v width=260 height=(n.w > 0 and n.h > 0 ? 260 * n.h / n.w : 170) border-radius=10 press=pic(n.v) testId=`mimg-${n.id}`
              else
                image `${server}/v1/file?p=${n.v}&s=${sid}&t=${token}` width=260 height=(n.w > 0 and n.h > 0 ? 260 * n.h / n.w : 170) border-radius=10 press=pic(`${server}/v1/file?p=${n.v}&s=${sid}&t=${token}`) testId=`mimg-${n.id}`
              if n.alt != ""
                text n.alt font-size="0.69rem" color="-exact-tertiary-label"
          // A run of images pages sideways: one card plus a peek of the next, snapping card by card (a "peek carousel").
          if n.t == "gallery"
            scroll scroll-snap-type="x mandatory" height=268 width="100%" testId=`gallery-${n.id}`
              row gap=8 padding="0 12px" align-items="flex-start"
                for it in n.items key=it.id
                  column gap=2 width=(it.dw > 0 ? it.dw : 320) scroll-snap-align="start" scroll-snap-stop="always"
                    if it.v.startsWith("http")
                      image it.v width=(it.dw > 0 ? it.dw : 320) height=(it.dh > 0 ? it.dh : 240) border-radius=10
                    else
                      image `${server}/v1/file?p=${it.v}&s=${sid}&t=${token}` width=(it.dw > 0 ? it.dw : 320) height=(it.dh > 0 ? it.dh : 240) border-radius=10
                    if it.alt != ""
                      text it.alt font-size="0.69rem" color="-exact-tertiary-label" line-clamp=1

// The card a tool row opens (ui-tool's terminal / read / search / web / diff / details / input-output views): its parts in order.
component ToolCard
  props
    v: ToolView
    ck: string
    open: string[]
    toggle: action
    openPath: action
  view
    column gap=6 testId=`toolcard-${ck}`
      if v.head != ""
        text v.head font-size="0.69rem" color="-exact-secondary-label" testId=`toolhead-${ck}`
      for p in v.parts key=p.id
        // A shell command: its working directory, the command and its status (运行中 / 退出码 N / 信号 X / 未正常退出).
        if p.kind == "cmd"
          column gap=2 testId=`toolcmd-${ck}`
            row gap=6 align-items="flex-start"
              text (p.label != "" ? `${p.label} $` : "$") font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label"
              text p.text font-size="0.75rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" white-space="pre-wrap" overflow-wrap="break-word" flex=1 min-width=0
            if p.badge != ""
              text p.badge font-size="0.69rem" font-weight=600 color=toneColor(p.tone) testId=`toolexit-${ck}`
        if p.kind == "lines"
          ToolLines(p=p, open=open.includes(`${ck}.${p.id}`), toggle=toggle(`${ck}.${p.id}`), openPath=openPath, tid=`${ck}.${p.id}`)
        // A URL (a fetch) or a block of text (a web answer, a read_image's path and size).
        if p.kind == "text"
          column gap=2
            if p.label != ""
              text p.label font-size="0.69rem" font-weight=600 color="-exact-secondary-label"
            if p.link != ""
              link href=p.link
                text p.text font-size="0.75rem" overflow-wrap="break-word"
            else
              if p.md
                text p.text markup="markdown" font-size="0.81rem" white-space="pre-wrap" overflow-wrap="break-word"
              else
                text p.text font-size="0.75rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
        if p.kind == "note"
          text p.text font-size="0.69rem" color="-exact-tertiary-label" white-space="pre-wrap" testId=`toolnote-${ck}`
        if p.kind == "items"
          column gap=6
            for it in p.items key=it.id
              column gap=2 padding="2px 0" testId=`toolitem-${ck}-${it.id}`
                if it.group != ""
                  text it.group font-size="0.62rem" color="-exact-tertiary-label"
                row gap=6 align-items="baseline"
                  if it.link != ""
                    link href=it.link flex=1 min-width=0
                      text it.title font-size="0.81rem" font-weight=600 overflow-wrap="break-word"
                  else
                    text it.title font-size="0.81rem" font-weight=600 overflow-wrap="break-word" flex=1 min-width=0
                  if it.badge != ""
                    text it.badge font-size="0.69rem" color=toneColor(it.tone)
                if it.subtitle != ""
                  text it.subtitle font-size="0.69rem" color="-exact-tertiary-label" overflow-wrap="break-word"
                if it.text != ""
                  if it.md
                    text it.text markup="markdown" font-size="0.75rem" white-space="pre-wrap" overflow-wrap="break-word"
                  else
                    text it.text font-size="0.75rem" color="-exact-secondary-label" white-space="pre-wrap" overflow-wrap="break-word"
                for f in it.fields key=f.id
                  row gap=8 align-items="flex-start"
                    text f.label font-size="0.69rem" color="-exact-tertiary-label" flex=1 min-width=0
                    text f.value font-size="0.69rem" color="-exact-secondary-label" text-align="right" overflow-wrap="break-word"
                for ln in it.lines key=ln.id
                  ToolLineRow(ln=ln, gut=false)
      if v.more > 0
        text t("diff.moreFiles", n=v.more) font-size="0.69rem" color="-exact-tertiary-label" testId=`diffhidden-${ck}`

// One block of a card's lines (terminal output, a file's lines, search matches, a diff's hunks): the first `fold` of them, then
// "… 其余 N 行" opens the rest in a scroller. `link` (a file's path) opens the viewer.
component ToolLines
  props
    p: ToolPart
    open: bool
    toggle: action
    openPath: action
    tid: string
  derive gut = p.lines.filter(l => l.n > 0 or l.sign == "+" or l.sign == "-").length > 0
  derive hidden = p.lines.length - p.fold
  derive shown = open ? p.lines : p.lines.slice(0, p.fold)
  view
    column gap=3 background-color="surface.card-strong" border-radius=8 padding="6px 8px" testId=`toollines-${tid}`
      if p.label != "" or p.badge != ""
        row gap=6 align-items="center"
          if p.link != ""
            row press=openPath(p.link) flex=1 min-width=0 testId=`toolpath-${tid}`
              text p.label font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="text.ink" text-decoration-line="underline" line-clamp=1
          else
            text p.label font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-secondary-label" line-clamp=1 flex=1 min-width=0
          if p.badge != ""
            text p.badge font-size="0.62rem" color=toneColor(p.tone)
      if open and hidden > 0
        scroll max-height=420 testId=`toolscroll-${tid}`
          column gap=1
            for ln in shown key=ln.id
              ToolLineRow(ln=ln, gut=gut)
      else
        column gap=1
          for ln in shown key=ln.id
            ToolLineRow(ln=ln, gut=gut)
      if hidden > 0
        row press=toggle gap=4 padding="2px 0" testId=`toolmore-${tid}`
          text (open ? t("common.collapse") : t("tool.moreLines", n=hidden)) font-size="0.69rem" color="-exact-secondary-label"

component ToolLineRow
  props
    ln: ToolLine
    gut: bool
  view
    if ln.sign == "#"
      text ln.text font-size="0.72rem" font-weight=600 font-family="ui-monospace, SFMono-Regular, Menlo, monospace" white-space="pre-wrap" overflow-wrap="break-word" padding="3px 0 0 0"
    else
      row gap=6 align-items="flex-start"
        if gut
          text (ln.n > 0 ? `${ln.n}` : (ln.sign == "+" or ln.sign == "-" ? ln.sign : "")) font-size="0.69rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label" text-align="right" min-width="1.8rem"
        if ln.runs.length > 0
          text white-space="pre-wrap" overflow-wrap="break-word" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="0.72rem" flex=1 min-width=0
            for r in ln.runs key=r.id
              text r.v color=tokColor(r.mark)
        else
          text ln.text font-size="0.72rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color=lineColor(ln.sign) white-space="pre-wrap" overflow-wrap="break-word" flex=1 min-width=0

// The goal strip above the composer (ui-goal GoalBar): the phase (进行中 / 待继续 when the Mac may not continue it yet / 已暂停 / 受阻), the objective, the rounds
// and a blocker's message; edit (an inline editor), clear, pause or resume. `act` takes pause / resume / clear, `edit` the new objective.
component GoalBar
  props
    objective: string
    phase: string
    activation: string
    rounds: number
    cap: number
    reason: string
    busy: bool
    error: string
    edit: action
    act: action
  state editing = false
  state objDraft = ""
  state sentEdit = false
  derive label = phase == "paused" ? t("goal.phase.paused") : (phase == "blocked" ? t("goal.phase.blocked") : (activation == "disarmed" ? t("goal.phase.disarmed") : t("goal.phase.active")))
  // An armed active goal pauses; every other one resumes (a disarmed active goal waits for a person's go-ahead).
  derive resumes = phase != "active" or activation == "disarmed"
  // The editor closes once its save was sent and answered without an error; a refusal keeps it open with the Mac's words.
  derive editorOpen = editing and not (sentEdit and not busy and error == "")
  action startEdit
    objDraft = objective
    sentEdit = false
    editing = true
  action editObj(v: string)
    objDraft = v
  action cancelEdit
    editing = false
  action save
    if objDraft.trim() != "" and not busy
      sentEdit = true
      edit(objDraft)
  view
    column gap=6 padding="8px 12px" margin-bottom=6 background-color="surface.card" border-radius=12 testId="goal-bar"
      if editorOpen
        column gap=6
          textarea value=objDraft input=editObj field-sizing="content" max-height=120 border="none" background-color="surface.card-strong" padding="8px 10px" border-radius=8 font-size="0.81rem" aria-label=t("goal.objective") testId="goal-input"
          if error != ""
            text error font-size="0.69rem" color="-exact-system-red" white-space="pre-wrap" overflow-wrap="break-word" testId="goal-error"
          row gap=8
            row press=save padding="6px 12px" border-radius=8 background-color="brand.fill" opacity=(busy or objDraft.trim() == "" ? 0.6 : 1) testId="goal-save"
              text t("goal.save") font-size="0.75rem" color="ink.on-brand"
            row press=cancelEdit padding="6px 12px" border-radius=8 background-color="surface.card-strong" testId="goal-cancel-edit"
              text t("goal.cancelEdit") font-size="0.75rem"
      else
        row gap=8 align-items="flex-start"
          image "symbol:star" font-size="0.75rem" color=(phase == "blocked" ? "-exact-system-orange" : "brand.fill")
          column flex=1 min-width=0 gap=2
            text label font-size="0.62rem" font-weight=600 color=(phase == "blocked" ? warnC() : "-exact-secondary-label") overflow-wrap="break-word" testId="goal-phase"
            text objective font-size="0.78rem" line-clamp=3 overflow-wrap="break-word" testId="goal-line"
            if cap > 0
              text `${t("goal.rounds")} ${rounds} / ${cap}` font-size="0.62rem" color="-exact-tertiary-label" testId="goal-rounds"
            if reason != ""
              text `${t("goal.reason")}: ${reason}` font-size="0.69rem" color=warnC() white-space="pre-wrap" overflow-wrap="break-word" testId="goal-reason"
            if error != ""
              text error font-size="0.69rem" color="-exact-system-red" white-space="pre-wrap" overflow-wrap="break-word" testId="goal-error"
          row gap=0 align-items="center" opacity=(busy ? 0.5 : 1)
            row press=startEdit padding="8px" align-items="center" justify-content="center" aria-label=t("goal.edit") testId="goal-edit"
              image "symbol:pencil" font-size="0.75rem" color="-exact-secondary-label"
            row press=act("clear") padding="8px" align-items="center" justify-content="center" aria-label=t("goal.clear") testId="goal-bar-clear"
              image "symbol:delete" font-size="0.75rem" color="-exact-secondary-label"
            row press=act(resumes ? "resume" : "pause") padding="8px" align-items="center" justify-content="center" aria-label=(resumes ? t("goal.resume") : t("goal.pause")) testId="goal-bar-toggle"
              image (resumes ? "symbol:play" : "symbol:pause") font-size="0.75rem" color="-exact-secondary-label"

// The files a turn changed (ui-deliverables ChangedFiles): one file is a single header, several a header over their rows folded past four.
// A file opens its comparison page (`show` takes the turn, the host summary's seq, the file's index and its path).
component ChangedFilesCard
  props
    files: ChangedFile[]
    total: number
    added: number
    removed: number
    turn: number
    seq: number
    open: bool
    toggle: action
    show: action
    tid: string
  derive head = match files.at(0) { case some(f) => f, case none => ChangedFile(id="", path="", name="", added=0, removed=0, i=-1, note="") }
  derive single = total == 1 and files.length == 1
  derive foldable = files.length > 4
  derive rows = (foldable and not open) ? files.slice(0, 4) : files
  action openHead
    if files.length > 0
      show(turn, seq, head.i, head.path)
  view
    column gap=2 background-color="surface.card" border-radius=10 padding="8px 10px" testId=tid
      row press=openHead gap=8 align-items="center" padding="2px 0" aria-label=(single ? t("changes.viewDiff", name=baseName(head.name)) : t("changes.title", count=total)) testId=`${tid}-head`
        image "symbol:document" font-size="0.75rem" color="brand.fill"
        text (single ? t("changes.singleTitle", name=baseName(head.name)) : t("changes.title", count=total)) font-size="0.81rem" font-weight=600 flex=1 min-width=0 line-clamp=1 testId=`${tid}-title`
        if single and head.note != ""
          text (head.note == "binary" ? t("changes.binary") : t("changes.oversized")) font-size="0.69rem" color="-exact-tertiary-label"
        else
          text `+${added}` font-size="0.69rem" color=addC() testId=`${tid}-added`
          text `−${removed}` font-size="0.69rem" color=delC() testId=`${tid}-removed`
      if not single
        for f in rows key=f.id
          row press=show(turn, seq, f.i, f.path) gap=8 align-items="center" padding="6px 0 6px 22px" aria-label=t("changes.viewDiff", name=baseName(f.name)) testId=`${tid}-${f.id}`
            text f.name font-size="0.72rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="text.ink" line-clamp=1 flex=1 min-width=0
            if f.note != ""
              text (f.note == "binary" ? t("changes.binary") : t("changes.oversized")) font-size="0.62rem" color="-exact-tertiary-label"
            else
              text `+${f.added}` font-size="0.62rem" color=addC()
              text `−${f.removed}` font-size="0.62rem" color=delC()
        if foldable
          row press=toggle gap=4 align-items="center" padding="4px 0 2px 22px" testId=`${tid}-fold`
            text (open ? t("common.collapse") : t("changes.all", count=total)) font-size="0.69rem" color="-exact-secondary-label"

// A file the turn presented (ui-deliverables PresentedFileCard): its name and description, a tap opens the viewer; where the Mac has a desktop,
// it can also be opened there or shown in Finder.
component PresentedFileCard
  props
    f: FileRow
    canOpen: bool
    show: action
    open: action
    reveal: action
    tid: string
  view
    column gap=6 background-color="surface.card" border-radius=10 padding="8px 10px" testId=tid
      row press=show gap=8 align-items="center" testId=`${tid}-show`
        image "symbol:document" font-size="0.8rem" color="brand.fill"
        column flex=1 min-width=0 gap=1
          text baseName(f.path) font-size="0.81rem" font-weight=600 line-clamp=1
          text f.path font-size="0.62rem" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" color="-exact-tertiary-label" line-clamp=1
        image "symbol:forward-chevron" font-size="0.55rem" color="-exact-tertiary-label"
      if f.text != ""
        text f.text font-size="0.69rem" color="-exact-secondary-label" line-clamp=2
      if canOpen
        row gap=8
          row press=open padding="4px 10px" border-radius=8 background-color="surface.card-strong" testId=`${tid}-mac`
            text t("mac.open") font-size="0.69rem"
          row press=reveal padding="4px 10px" border-radius=8 background-color="surface.card-strong" testId=`${tid}-finder`
            text t("mac.reveal") font-size="0.69rem"
